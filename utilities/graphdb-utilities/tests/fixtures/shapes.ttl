@prefix ex: <https://example.org/graphdb-utilities/test/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# Application-independent SHACL shapes for GraphDB utility tests.
# This file defines constraints; repository setup loads them into
# the configured SHACL shapes graph.

ex:TestShapeSet
    a owl:Ontology ;
    owl:versionInfo "1.0.0" .

ex:TestRecordShape
    a sh:NodeShape ;
    sh:targetClass ex:TestRecord ;

    sh:property [
        sh:path ex:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A test record must have exactly one string identifier."
    ] ;

    sh:property [
        sh:path ex:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A test record must have exactly one string label."
    ] .