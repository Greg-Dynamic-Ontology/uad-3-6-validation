@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix prov:     <http://www.w3.org/ns/prov#> .

@prefix uad:      <https://dynamicontology.com/uad36/ontology#> .
@prefix uadpred:  <https://dynamicontology.com/uad36/predicate#> .
@prefix uadvalue: <https://dynamicontology.com/uad36/value#> .

#################################################################
#
# UAD 3.6 Core Ontology
#
# This file declares the UAD ontology and establishes the
# namespace policy for all ontology terms.
#
# Additional Turtle source files contribute classes and
# properties to this ontology by using the same namespace.
#
# Current contributing files include:
#
#   • urar-meaning.ttl
#
#################################################################

<https://dynamicontology.com/uad36/ontology>
    a owl:Ontology ;
    dcterms:title "UAD 3.6 Ontology" ;
    dcterms:creator "Dynamic Ontology" ;
    dcterms:description
        "Core ontology for the Uniform Appraisal Dataset (UAD) 3.6." ;
    owl:versionInfo "0.1.0" .

#################################################################
#
# Core Classes
#
#################################################################

uad:SchemaComponent
    a owl:Class ;
    rdfs:label "Schema Component" ;
    skos:definition
        "A component of a source schema or specification represented in the UAD ontology." .

uad:PropertyConditionRating
    a owl:Class ;
    rdfs:label "Property Condition Rating" ;
    skos:definition
        "A rating expressing the condition of a property." .

uad:PropertyQualityRating
    a owl:Class ;
    rdfs:label "Property Quality Rating" ;
    skos:definition
        "A rating expressing the quality of a property." .

uad:hasPropertyConditionRating
    a owl:ObjectProperty ;
    rdfs:domain uad:SubjectProperty ;
    rdfs:range uad:PropertyConditionRating ;
    rdfs:label "has property condition rating" .

uad:hasPropertyQualityRating
    a owl:ObjectProperty ;
    rdfs:domain uad:SubjectProperty ;
    rdfs:range uad:PropertyQualityRating ;
    rdfs:label "has property quality rating" .

#################################################################
#
# Pipeline Execution Vocabulary
#
#################################################################

uad:PipelineRun
    a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Pipeline Run" ;
    skos:definition
        "An execution of a configured processing pipeline for one loaded appraisal." .

uad:StageExecution
    a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Stage Execution" ;
    skos:definition
        "An execution of one stage within a pipeline run." .

uad:RdfProjectionExecution
    a owl:Class ;
    rdfs:subClassOf uad:StageExecution ;
    rdfs:label "RDF Projection Execution" ;
    skos:definition
        "An execution of the stage that projects a loaded UAD XML appraisal into RDF." .

uad:PipelineError
    a owl:Class ;
    rdfs:label "Pipeline Error" ;
    skos:definition
        "An error reported by a pipeline stage execution." .

uad:ExecutionStatus
    a owl:Class ;
    rdfs:label "Execution Status" ;
    skos:definition
        "A status assigned to a pipeline run or stage execution." .

uad:hasStageExecution
    a owl:ObjectProperty ;
    rdfs:domain uad:PipelineRun ;
    rdfs:range uad:StageExecution ;
    rdfs:label "has stage execution" .

uad:hasError
    a owl:ObjectProperty ;
    rdfs:domain uad:StageExecution ;
    rdfs:range uad:PipelineError ;
    rdfs:label "has error" .

uad:executionStatus
    a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range uad:ExecutionStatus ;
    rdfs:label "execution status" .

uad:errorCode
    a owl:DatatypeProperty ;
    rdfs:domain uad:PipelineError ;
    rdfs:range xsd:string ;
    rdfs:label "error code" .

uad:businessMessage
    a owl:DatatypeProperty ;
    rdfs:domain uad:PipelineError ;
    rdfs:range xsd:string ;
    rdfs:label "business message" ;
    skos:definition
        "An error message suitable for a business user." .

uad:technicalMessage
    a owl:DatatypeProperty ;
    rdfs:domain uad:PipelineError ;
    rdfs:range xsd:string ;
    rdfs:label "technical message" ;
    skos:definition
        "An error message containing technical diagnostic detail." .

uad:Completed
    a owl:NamedIndividual, uad:ExecutionStatus ;
    rdfs:label "Completed" .

uad:Failed
    a owl:NamedIndividual, uad:ExecutionStatus ;
    rdfs:label "Failed" .
