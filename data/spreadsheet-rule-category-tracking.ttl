    t:dataPointNameValue "OwnershipTransferAmountNotAvailableReasonTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1199>
    t:messageText "Provide at least one data source when the sales comparable does not have any prior sales or transfer history. In the UAD XML, a minimum of one RELATIONSHIP must be included that links DATA_SOURCE to PriorSalesOrTransfersIndicator. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and PriorSalesOrTransfersIndicator = \"false\", and there is no instance of RELATIONSHIP with @xlink:arcrole = \"urn:fdc:mismo.org:2009:residential/DATA_SOURCE_IsDataSourceFor_PriorSalesOrTransfersIndicator\" that links DATA_SOURCE to PriorSalesOrTransfersIndicator" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "@xlink:arcrole" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1200>
    t:messageText "Provide at least one data source when the subject property does not have any prior sales or transfer history. In the UAD XML, a minimum of one RELATIONSHIP must be included that links DATA_SOURCE to PriorSalesOrTransfersIndicator. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SubjectProperty\" and PriorSalesOrTransfersIndicator = \"false\", and there is no instance of RELATIONSHIP with @xlink:arcrole = \"urn:fdc:mismo.org:2009:residential/DATA_SOURCE_IsDataSourceFor_PriorSalesOrTransfersIndicator\" that links DATA_SOURCE to PriorSalesOrTransfersIndicator" ;
    t:propertyAffected "Subject" ;
