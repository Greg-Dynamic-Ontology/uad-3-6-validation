<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1605>
    t:messageText "Deliver ProjectComponentCompletedIndicator as false for each incomplete project element. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If ProjectCompletedIndicator = \"false\" and ProjectComponentCompletedIndicator is not = \"false\" in a given instance of PROJECT_COMPONENT" ;
