<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1205>
    t:messageText "Provide the 'Current or Final List Price'." ;
    t:ruleLogic "If ListedWithinPreviousYearIndicator = \"true\" and FinalListPriceAmount is not provided in a given instance of LISTING_INFORMATION_DETAIL" ;
    t:propertyAffected "Subject" ;
