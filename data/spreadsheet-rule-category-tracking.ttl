<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1177>
    t:messageText "Provide the level type (e.g., Level 1, Level 2, Level B1)." ;
    t:ruleLogic "If (ImprovementType = \"Dwelling\" or (ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and AccessoryDwellingUnitIndicator = \"true\")), and LevelType is not provided in a given instance ROOM_DETAIL" ;
