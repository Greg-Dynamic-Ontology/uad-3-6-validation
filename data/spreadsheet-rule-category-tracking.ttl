<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1402>
    t:messageText "Provide 'Listing Status' for the sales comparable." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and ListingStatusType is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "General Information" ;
    t:reportLabelValue "Listing Status" ;
    t:dataPointNameValue "ListingStatusType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LISTING_INFORMATIONS/LISTING_INFORMATION/LISTING_INFORMATION_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1403>
    t:messageText "Only one listing status must be delivered for the sales comparable." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and there is more than one instance of LISTING_INFORMATION" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "General Information" ;
    t:reportLabelValue "Listing Status" ;
    t:dataPointNameValue "ListingStatusType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LISTING_INFORMATIONS/LISTING_INFORMATION/LISTING_INFORMATION_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1404>
    t:messageText "Sales comparison approach is included in the appraisal, however, no sales comparables have been provided. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If SalesComparisonApproachIndicator = \"true\" and there are no instances of PROPERTY with @ValuationUseType = \"SalesComparable\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "SalesComparisonApproachIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1405>
    t:messageText "Provide the type of vehicle storage. Select 'None' if there is no vehicle storage." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and (at least one instance of CAR_STORAGE_DETAIL is not provided or CarStorageType is not provided in a given instance of CAR_STORAGE_DETAIL)" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Vehicle Storage" ;
    t:reportLabelValue "Type | Spaces | Detail" ;
    t:dataPointNameValue "CarStorageType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/CAR_STORAGES/CAR_STORAGE/CAR_STORAGE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1407>
    t:messageText "Provide a description when vehicle storage type = 'Other'." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and CarStorageType = \"Other\" and CarStorageTypeOtherDescription is not provided in a given instance of CAR_STORAGE_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Vehicle Storage" ;
    t:reportLabelValue "Type | Spaces | Detail" ;
    t:dataPointNameValue "CarStorageTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/CAR_STORAGES/CAR_STORAGE/CAR_STORAGE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1408>
    t:messageText "Provide the attachment type for the 'Carport' or 'Garage'." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and CarStorageType = \"Garage\" or \"Carport\", and CarStorageAttachmentType is not provided in a given instance of CAR_STORAGE_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Vehicle Storage" ;
    t:reportLabelValue "Type | Spaces | Detail" ;
    t:dataPointNameValue "CarStorageAttachmentType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/CAR_STORAGES/CAR_STORAGE/CAR_STORAGE_DETAIL/" ;
    t:relatedValues "CarStorageType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1409>
    t:messageText "Provide the material used for the 'Driveway' or 'SharedDriveway'." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and CarStorageType = \"Driveway\" or \"SharedDriveway\", and ImprovedSurfaceMaterialType is not provided in a given instance of CAR_STORAGE_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Vehicle Storage" ;
    t:reportLabelValue "Type | Spaces | Detail" ;
    t:dataPointNameValue "ImprovedSurfaceMaterialType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/CAR_STORAGES/CAR_STORAGE/CAR_STORAGE_DETAIL/" ;
    t:relatedValues "CarStorageType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1410>
    t:messageText "Provide a description when street surface material = 'Other'." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and ImprovedSurfaceMaterialType = \"Other\" and ImprovedSurfaceMaterialTypeOtherDescription is not provided in a given instance of CAR_STORAGE_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Vehicle Storage" ;
    t:reportLabelValue "Type | Spaces | Detail" ;
    t:dataPointNameValue "ImprovedSurfaceMaterialTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/CAR_STORAGES/CAR_STORAGE/CAR_STORAGE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1411>
    t:messageText "Provide the number of parking spaces." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and (CarStorageType = \"Driveway\" or \"SharedDriveway\" and TenOrMoreParkingSpacesIndicator = \"false\") or (CarStorageType = \"Carport\" or \"CommonCarport\" or \"Garage\" or \"OpenLot\" or \"Other\" or \"ParkingGarage\"), and ParkingSpacesCount is not provided in a given instance of CAR_STORAGE_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Vehicle Storage" ;
    t:reportLabelValue "Type | Spaces | Detail" ;
    t:dataPointNameValue "ParkingSpacesCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/CAR_STORAGES/CAR_STORAGE/CAR_STORAGE_DETAIL/" ;
    t:relatedValues "CarStorageType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1412>
    t:messageText "Provide the type of parking space assignment for 'CommonCarport' , 'OpenLot', or 'ParkingGarage'." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\", and CarStorageType = \"CommonCarport\" or \"OpenLot\" or \"ParkingGarage\", and ProjectParkingSpaceAssignmentType is not provided in a given instance of CAR_STORAGE_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Vehicle Storage" ;
    t:reportLabelValue "Type | Spaces | Detail" ;
    t:dataPointNameValue "ProjectParkingSpaceAssignmentType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/CAR_STORAGES/CAR_STORAGE/CAR_STORAGE_DETAIL/" ;
    t:relatedValues "CarStorageType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1414>
    t:messageText "Indicate whether the 'Driveway' or 'SharedDriveway' has ten or more parking spaces." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\", and CarStorageType = \"Driveway\" or \"SharedDriveway\", and TenOrMoreParkingSpacesIndicator is not provided in a given instance of CAR_STORAGE_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Vehicle Storage" ;
    t:reportLabelValue "Type | Spaces | Detail" ;
    t:dataPointNameValue "TenOrMoreParkingSpacesIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/CAR_STORAGES/CAR_STORAGE/CAR_STORAGE_DETAIL/" ;
    t:relatedValues "CarStorageType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1415>
    t:messageText "Indicate whether the structure is a 'Dwelling' or 'Outbuilding'." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and ImprovementType is not provided in a given instance of IMPROVEMENT_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Unit(s); ADU Interior Quality and Condition" ;
    t:reportLabelValue "Location of ADU" ;
    t:dataPointNameValue "ImprovementType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1416>
    t:messageText "Provide the calendar year in which the construction of the structure was completed." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and ImprovementType = \"Dwelling\" and PropertyStructureBuiltYear is not provided in a given instance of IMPROVEMENT_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Dwelling(s)" ;
    t:reportLabelValue "Year Built" ;
    t:dataPointNameValue "PropertyStructureBuiltYear" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1418>
    t:messageText "The 'Year Built' is prior to 1800. Please check for accuracy." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and PropertyStructureBuiltYear < 1800 in a given instance of IMPROVEMENT_DETAIL with ImprovementType = \"Dwelling\"" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Dwelling(s)" ;
    t:reportLabelValue "Year Built (%PV%)" ;
    t:dataPointNameValue "PropertyStructureBuiltYear (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" ;
    t:minValue "1800" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1419>
    t:messageText "Provide the interior condition rating." ;
    t:ruleLogic """If @ValuationUseType = "SalesComparable" and (ImprovementType = "Dwelling"
or (ImprovementType = "Outbuilding" and OutbuildingRealPropertyIndicator = "true" and AccessoryDwellingUnitIndicator = "true")), and InteriorConditionRatingCode is not provided in a given instance of PROPERTY_UNIT_DETAIL""" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Interior Quality and Condition; ADU Interior Quality and Condition" ;
    t:reportLabelValue "Condition" ;
    t:dataPointNameValue "InteriorConditionRatingCode" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_DETAIL/" ;
    t:relatedValues "ImprovementType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1420>
    t:messageText "Provide the interior quality rating." ;
    t:ruleLogic """If @ValuationUseType = "SalesComparable" and (ImprovementType = "Dwelling"
OR (ImprovementType = "Outbuilding" and OutbuildingRealPropertyIndicator = "true" and AccessoryDwellingUnitIndicator = "true")), and InteriorQualityRatingCode is not provided in a given instance of PROPERTY_UNIT_DETAIL""" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Interior Quality and Condition; ADU Interior Quality and Condition" ;
    t:reportLabelValue "Quality" ;
    t:dataPointNameValue "InteriorQualityRatingCode" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_DETAIL/" ;
    t:relatedValues "ImprovementType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1421>
    t:messageText "Provide the heating system type. Select 'None' if there is no heating system." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" AND ImprovementType = \"Dwelling\" and (at least one instance of HEATING_SYSTEM is not provided or HeatingSystemType is not provided in a given instance of HEATING_SYSTEM)" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Dwelling(s)" ;
    t:reportLabelValue "Heating" ;
    t:dataPointNameValue "HeatingSystemType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/SYSTEM/HEATING_SYSTEMS/HEATING_SYSTEM/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1422>
    t:messageText "Provide a description when heating system type = 'Other'." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and HeatingSystemType = \"Other\" and HeatingSystemTypeOtherDescription is not provided in a given instance of HEATING_SYSTEM" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Dwelling(s)" ;
    t:reportLabelValue "Heating" ;
    t:dataPointNameValue "HeatingSystemTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/SYSTEM/HEATING_SYSTEMS/HEATING_SYSTEM/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1423>
    t:messageText "Provide 'Structural Design'." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and ImprovementType = \"Dwelling\" and AttachmentType = \"Attached\" and StructuralDesignType is not provided in a given instance of ARCHITECTURAL_DESIGN" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Dwelling(s)" ;
    t:reportLabelValue "Structure Design" ;
    t:dataPointNameValue "StructuralDesignType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/ARCHITECTURAL_DESIGN/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1424>
    t:messageText "Provide a description when 'Structure Design' = 'Other'." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and StructuralDesignType = \"Other\" and StructuralDesignTypeOtherDescription is not provided in a given instance of ARCHITECTURAL_DESIGN" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Dwelling(s)" ;
    t:reportLabelValue "Structure Design" ;
    t:dataPointNameValue "StructuralDesignTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/ARCHITECTURAL_DESIGN/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1425>
    t:messageText "Provide the 'Gross Building Finished Area'." ;
    t:ruleLogic "If SalesComparisonApproachIndicator = \"true\" and LivingUnitExcludingADUCount > 1 and TotalFinishedAreaOfAllLivingUnitsIncludingADUAreaMeasure is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Dwelling(s)" ;
    t:reportLabelValue "Gross Building Finished Area" ;
    t:dataPointNameValue "TotalFinishedAreaOfAllLivingUnitsIncludingADUAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1426>
    t:messageText "Provide the exterior condition rating." ;
    t:ruleLogic "If (@ValuationUseType = \"SalesComparable\" and ImprovementType = \"Dwelling\" and HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\"), and (@ValuationUseType = \"SubjectProperty\" and HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\") and ExteriorConditionRatingCode is not provided in a given instance of STRUCTURE_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Exterior Quality and Condition" ;
    t:reportLabelValue "Condition" ;
    t:dataPointNameValue "ExteriorConditionRatingCode" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1427>
    t:messageText "Provide the exterior quality rating." ;
    t:ruleLogic "If (@ValuationUseType = \"SalesComparable\" and ImprovementType = \"Dwelling\" and HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\"), and (@ValuationUseType = \"SubjectProperty\" and HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\") and ExteriorQualityRatingCode is not provided in a given instance of STRUCTURE_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Exterior Quality and Condition" ;
    t:reportLabelValue "Quality" ;
    t:dataPointNameValue "ExteriorQualityRatingCode" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1428>
    t:messageText "Provide the total number of days the property has been on the market." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and DaysOnMarketCount is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "General Information" ;
    t:reportLabelValue "Days on Market" ;
    t:dataPointNameValue "DaysOnMarketCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LISTING_INFORMATIONS/LISTING_INFORMATION/LISTING_INFORMATION_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1429>
    t:messageText "Provide the latitude for the sales comparable. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and LatitudeIdentifier is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "LatitudeIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LOCATION_IDENTIFIER/GEOSPATIAL_INFORMATION/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1430>
    t:messageText "Provide the longitude for the sales comparable. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and LongitudeIdentifier is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "LongitudeIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LOCATION_IDENTIFIER/GEOSPATIAL_INFORMATION/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1431>
    t:messageText "A numeric identifier ('Comparable #') must be assigned for each sales comparable. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and PropertyOrdinalNumber is not provided" ;
    t:propertyAffected "Sales Comparable" ;
    t:reportSection "Sales Comparison Approach; Prior Sale and Transfer History" ;
    t:reportSubsection "General Information; Comparable Transfer History" ;
    t:reportLabelValue "Comparable" ;
    t:dataPointNameValue "PropertyOrdinalNumber" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" ;
    t:relatedValues "AddressLineText (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1432>
    t:messageText "Comparable # must be unique. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "if PropertyOrdinalNumber is not unique across all instances of PROPERTY with @ValuationUseType = \"SalesComparable\"" ;
    t:propertyAffected "Sales Comparable" ;
    t:reportSection "Sales Comparison Approach; Prior Sale and Transfer History" ;
    t:reportSubsection "General Information; Comparable Transfer History" ;
    t:reportLabelValue "Comparable" ;
    t:dataPointNameValue "PropertyOrdinalNumber" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1433>
    t:messageText "Indicate whether the sales comparable is attached or detached." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and AttachmentType is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "General Information" ;
    t:reportLabelValue "Attached/Detached" ;
    t:dataPointNameValue "AttachmentType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1434>
    t:messageText "Provide the overall condition rating for the sales comparable." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and OverallConditionRatingCode is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Overall Quality and Condition" ;
    t:reportLabelValue "Condition" ;
    t:dataPointNameValue "OverallConditionRatingCode" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1435>
    t:messageText "Provide the overall quality rating for the sales comparable." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and OverallQualityRatingCode is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Overall Quality and Condition" ;
    t:reportLabelValue "Quality" ;
    t:dataPointNameValue "OverallQualityRatingCode" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1436>
    t:messageText "Indicate whether the sales comparable has a prior sale or transfer." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and PriorSalesOrTransfersIndicator is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Prior Sale and Transfer History" ;
    t:reportSubsection "Comparable Transfer History" ;
    t:reportLabelValue "Transfer Terms" ;
    t:dataPointNameValue "PriorSalesOrTransfersIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1439>
    t:messageText "Provide either the amount related to the transfer of ownership of real property (typically the sale price), or the reason why the ownership transfer amount was not available." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and (OwnershipTransferTransactionAmount and OwnershipTransferAmountNotAvailableReasonType) is not provided in a given instance of SALES_HISTORY" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Prior Sale and Transfer History; Sales Comparison Approach" ;
    t:reportSubsection "Comparable Transfer History; General Information" ;
    t:reportLabelValue "Amount; Sale Price" ;
    t:dataPointNameValue "OwnershipTransferTransactionAmount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
    t:relatedValues "OwnershipTransferTransactionType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1440>
    t:messageText "Provide a description when 'Ownership Transfer Amount Not Available Reason Type' = 'Other'." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and OwnershipTransferAmountNotAvailableReasonType = \"Other\" and OwnershipTransferAmountNotAvailableReasonTypeOtherDescription is not provided in a given instance of SALES_HISTORY" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Prior Sale and Transfer History" ;
    t:reportSubsection "Comparable Transfer History" ;
    t:reportLabelValue "Amount" ;
    t:dataPointNameValue "OwnershipTransferAmountNotAvailableReasonTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1442>
    t:messageText "The amount related to the transfer of ownership of real property (typically the sale price) must be greater than or equal to $0." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and OwnershipTransferTransactionAmount < 0 in a given instance of SALES_HISTORY" ;
    t:propertyAffected "Sales Comparable #n" ;
