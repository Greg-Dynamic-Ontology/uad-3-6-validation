<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1203>
    t:messageText "Indicate whether the property has been listed within the previous twelve (12) months." ;
    t:ruleLogic "If ListedWithinPreviousYearIndicator is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Listing Information" ;
