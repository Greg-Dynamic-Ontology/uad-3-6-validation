    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Assignment Reason" ;
    t:dataPointNameValue "ValuationAssignmentType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1220>
    t:messageText "Provide a description when 'Assignment Reason' = 'Other'." ;
    t:ruleLogic "If ValuationAssignmentType = \"Other\" and ValuationAssignmentTypeOtherDescription is not provided" ;
