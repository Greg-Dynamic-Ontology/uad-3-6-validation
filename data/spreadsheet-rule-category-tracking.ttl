<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1192>
    t:messageText "Provide the ownership transfer transaction type (i.e., sale, deed transfer only)." ;
    t:ruleLogic "If PriorSalesOrTransfersIndicator = \"true\" and (at least one instance of SALES_HISTORY is not provided or OwnershipTransferTransactionType is not provided in a given instance of SALES_HISTORY)" ;
