    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Physical Address" ;
    t:dataPointNameValue "AddressLineText" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/ADDRESS/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1002>
    t:messageText "Provide the city name for the subject property physical address." ;
    t:ruleLogic "If CityName is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Physical Address" ;
    t:dataPointNameValue "CityName" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/ADDRESS/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1003>
    t:messageText "Provide the county name for the subject property physical address." ;
    t:ruleLogic "If CountyName is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "County" ;
    t:dataPointNameValue "CountyName" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/ADDRESS/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1004>
    t:messageText "Provide the ZIP code for the subject property physical address." ;
    t:ruleLogic "If PostalCode is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Physical Address" ;
    t:dataPointNameValue "PostalCode" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/ADDRESS/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1005>
    t:messageText "The ZIP code for the subject property physical address must be either 5 digits, or 5 digits, a hyphen, and 4 digits (ZIP+4)." ;
    t:ruleLogic "If PostalCode is not in the required format (5 digits, or 5 digits, a hyphen, and 4 digits)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Physical Address (%PV%)" ;
    t:dataPointNameValue "PostalCode (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/ADDRESS/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1006>
    t:messageText "Provide the state code for the subject property physical address." ;
    t:ruleLogic "If StateCode is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Physical Address" ;
    t:dataPointNameValue "StateCode" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/ADDRESS/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1007>
    t:messageText "The state code for the subject property physical address must be a valid 2-character US State or Territory Code." ;
    t:ruleLogic "If StateCode is not a valid 2-character US State or Territory Code" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Physical Address (%PV%)" ;
    t:dataPointNameValue "StateCode (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/ADDRESS/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1008>
    t:messageText "Provide the latitude for subject property. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If LatitudeIdentifier is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "LatitudeIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LOCATION_IDENTIFIER/GEOSPATIAL_INFORMATION/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1009>
    t:messageText "Provide the longitude for subject property. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If LongitudeIdentifier is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "LongitudeIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LOCATION_IDENTIFIER/GEOSPATIAL_INFORMATION/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1010>
    t:messageText "Provide the total number of ADUs, even if the value is 0." ;
    t:ruleLogic "If AccessoryDwellingUnitTotalCount is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Accessory Dwelling Units" ;
    t:dataPointNameValue "AccessoryDwellingUnitTotalCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1011>
    t:messageText "The number of 'Accessory Dwelling Units' does not equal the number of living units identified as an ADU." ;
    t:ruleLogic "If AccessoryDwellingUnitTotalCount <> the number of instances of PROPERTY_UNIT_DETAIL with AccessoryDwellingUnitIndicator = \"true\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Accessory Dwelling Units (%PV%)" ;
    t:dataPointNameValue "AccessoryDwellingUnitTotalCount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1012>
    t:messageText "Provide the 'Attachment Type' for the property." ;
    t:ruleLogic "If AttachmentType is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Attachment Type" ;
    t:dataPointNameValue "AttachmentType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1013>
    t:messageText "Provide the total number of dwellings." ;
    t:ruleLogic "If DwellingCount is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Dwellings Containing Units" ;
    t:dataPointNameValue "DwellingCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1014>
    t:messageText "The total number of dwellings must be at least 1." ;
    t:ruleLogic "If DwellingCount < 1" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Dwellings Containing Units (%PV%)" ;
    t:dataPointNameValue "DwellingCount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" ;
    t:minValue "1" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1015>
    t:messageText "The total number of dwellings exceeds the total number of living units, excluding any ADUs." ;
    t:ruleLogic "If DwellingCount > LivingUnitExcludingADUCount" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Dwellings Containing Units (%PV%)" ;
    t:dataPointNameValue "DwellingCount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1016>
    t:messageText "The 'Dwellings Containing Units' does not equal the number of structures identified as a dwelling." ;
    t:ruleLogic "If DwellingCount does not equal the number of instances of IMPROVEMENT_DETAIL with ImprovementType = \"Dwelling\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Dwellings Containing Units (%PV%)" ;
    t:dataPointNameValue "DwellingCount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1017>
    t:messageText "Provide the total number of living units, excluding any ADUs." ;
    t:ruleLogic "If LivingUnitExcludingADUCount is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Units Excluding ADUs" ;
    t:dataPointNameValue "LivingUnitExcludingADUCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1018>
    t:messageText "The total number of living units, excluding any ADUs, must be at least 1." ;
    t:ruleLogic "If LivingUnitExcludingADUCount < 1" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Units Excluding ADUs (%PV%)" ;
    t:dataPointNameValue "LivingUnitExcludingADUCount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" ;
    t:minValue "1" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1019>
    t:messageText "The 'Units Excluding ADUs' does not equal the number of living units delivered in the UAD XML." ;
    t:ruleLogic "If LivingUnitExcludingADUCount does not equal the number of instances of PROPERTY_UNIT_DETAIL with AccessoryDwellingUnitIndicator = \"false\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Units Excluding ADUs (%PV%)" ;
    t:dataPointNameValue "LivingUnitExcludingADUCount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1021>
    t:messageText "Provide 'Property Rights Appraised'." ;
    t:ruleLogic "If (PropertyInProjectIndicator = \"false\" or ProjectLegalStructureType = \"Condominium\"), and PropertyEstateType is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "Ownership Rights" ;
    t:reportLabelValue "Property Rights Appraised" ;
    t:dataPointNameValue "PropertyEstateType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1022>
    t:messageText "Provide a description when 'Property Rights Appraised' = 'Other'." ;
    t:ruleLogic "If PropertyEstateType = \"Other\" and PropertyEstateTypeOtherDescription is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "Ownership Rights" ;
    t:reportLabelValue "Property Rights Appraised" ;
    t:dataPointNameValue "PropertyEstateTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1023>
    t:messageText "Indicate whether the property is located within a PUD." ;
    t:ruleLogic "If PUDIndicator is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Planned Unit Development (PUD)" ;
    t:dataPointNameValue "PUDIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1024>
    t:messageText "Provide 'Ground Rent Annual Amount'." ;
    t:ruleLogic "If PropertyEstateType = \"Leasehold\" and LandOwnedInCommonIndicator = \"false\", and PropertyGroundLeaseAnnualAmount is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "Ownership Rights" ;
    t:reportLabelValue "Ground Rent Annual Amount" ;
    t:dataPointNameValue "PropertyGroundLeaseAnnualAmount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_GROUND_RENT/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1025>
    t:messageText "Provide the property ground lease expiration date." ;
    t:ruleLogic "If PropertyEstateType = \"Leasehold\" and LandOwnedInCommonIndicator = \"false\", and PropertyGroundLeaseExpirationDate is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "Ownership Rights" ;
    t:reportLabelValue "Expires" ;
    t:dataPointNameValue "PropertyGroundLeaseExpirationDate" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_GROUND_RENT/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1026>
    t:messageText "Indicate whether the property ground lease is renewable." ;
    t:ruleLogic "If PropertyEstateType = \"Leasehold\" and LandOwnedInCommonIndicator = \"false\", and PropertyGroundLeaseRenewableIndicator is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "Ownership Rights" ;
    t:reportLabelValue "Renewable" ;
    t:dataPointNameValue "PropertyGroundLeaseRenewableIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_GROUND_RENT/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1027>
    t:messageText "Indicate whether the property has any special tax assessments." ;
    t:ruleLogic "If SpecialTaxAssessmentsIndicator is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Special Tax Assessments" ;
    t:dataPointNameValue "SpecialTaxAssessmentsIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_TAXES/PROPERTY_TAX/PROPERTY_TAX_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1028>
    t:messageText "Indicate whether all ownership rights of the property are included as part of the valuation." ;
    t:ruleLogic "If LandOwnedInCommonIndicator = \"false\" and AllPropertyRightsAppraisedIndicator is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "Ownership Rights" ;
    t:reportLabelValue "All Rights Included in Appraisal" ;
    t:dataPointNameValue "AllPropertyRightsAppraisedIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_CONTRACTS/SALES_CONTRACT/SALES_CONTRACT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1029>
    t:messageText "Deliver this indicator as false for each ownership right that is not included in the appraisal. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If AppraisedIndicator is not \"false\" in a given instance of REAL_PROPERTY_INTEREST" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "AppraisedIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/REAL_PROPERTY_INTERESTS/REAL_PROPERTY_INTEREST/" ;
    t:relatedValues "PropertyPartialInterestType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1030>
    t:messageText "Provide 'Rights Not Included'." ;
    t:ruleLogic "If AllPropertyRightsAppraisedIndicator = \"false\" and (at least one instance of REAL_PROPERTY_INTEREST is not provided or PropertyPartialInterestType is not provided in a given instance of REAL_PROPERTY_INTEREST)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "Ownership Rights" ;
    t:reportLabelValue "Rights Not Included" ;
    t:dataPointNameValue "PropertyPartialInterestType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/REAL_PROPERTY_INTERESTS/REAL_PROPERTY_INTEREST/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1031>
    t:messageText "Provide a description when 'Rights Not Included' = 'Other'." ;
    t:ruleLogic "If PropertyPartialInterestType = \"Other\" and PropertyPartialInterestTypeOtherDescription is not provided in a given instance of REAL_PROPERTY_INTEREST" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "Ownership Rights" ;
    t:reportLabelValue "Rights Not Included" ;
    t:dataPointNameValue "PropertyPartialInterestTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/REAL_PROPERTY_INTERESTS/REAL_PROPERTY_INTEREST/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1032>
    t:messageText "The subject property has not been identified in the UAD XML. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If an instance of PROPERTY is not provided with @ValuationUseType = \"SubjectProperty\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "@ValuationUseType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1033>
    t:messageText "More than one property has been identified as the subject property. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If more than one instance of PROPERTY has @ValuationUseType = \"SubjectProperty\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "@ValuationUseType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1034>
    t:messageText "Provide 'ValuationUseType' for each property included in the appraisal. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType is not provided for one or more instances of PROPERTY" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "@ValuationUseType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/" ;
    t:relatedValues "AddressLineText (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1035>
    t:messageText "Provide 'Homeowner Responsible for all Exterior Maintenance of Dwelling(s)'." ;
    t:ruleLogic "If HomeownerResponsibleForExteriorMaintenanceIndicator is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Homeowner Responsible for all Exterior Maintenance of Dwelling(s)" ;
    t:dataPointNameValue "HomeownerResponsibleForExteriorMaintenanceIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1036>
    t:messageText "Indicate whether the site is owned in common." ;
    t:ruleLogic "If LandOwnedInCommonIndicator is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Subject Site Owned in Common" ;
    t:dataPointNameValue "LandOwnedInCommonIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SITE/SITE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1037>
    t:messageText "Each ValuationAnalysisCategoryType can only be delivered once. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If there is more than one instance of VALUATION_COMMENTARY with the same ValuationAnalysisCategoryType enumeration" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ValuationAnalysisCategoryType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_COMMENTARIES/VALUATION_COMMENTARY/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1038>
    t:messageText "Provide ValuationAnalysisCategoryType = 'PropertySpecialTaxAssessments' when there are special tax assessments. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If SpecialTaxAssessmentsIndicator = \"true\", and there is no instance of VALUATION_COMMENTARY with ValuationAnalysisCategoryType = \"PropertySpecialTaxAssessments\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ValuationAnalysisCategoryType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_COMMENTARIES/VALUATION_COMMENTARY/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1039>
    t:messageText "Provide 'Description of Special Tax Assessments and Impact to Value / Marketability'." ;
    t:ruleLogic "If SpecialTaxAssessmentsIndicator = \"true\" and ValuationCommentText is not provided in the instance of VALUATION_COMMENTARY with ValuationAnalysisCategoryType = \"PropertySpecialTaxAssessments\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Description of Special Tax Assessments and Impact to Value / Marketability" ;
    t:dataPointNameValue "ValuationCommentText" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_COMMENTARIES/VALUATION_COMMENTARY/" ;
    t:relatedValues "ValuationAnalysisCategoryType (PropertySpecialTaxAssessments)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1040>
    t:messageText "Indicate whether the property is located on Native American lands." ;
    t:ruleLogic "If NativeAmericanLandsIndicator is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Property on Native American Lands" ;
    t:dataPointNameValue "NativeAmericanLandsIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1041>
    t:messageText "Provide the total number of ADUs in the sales comparable." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and AccessoryDwellingUnitTotalCount is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "AccessoryDwellingUnitTotalCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1042>
    t:messageText "Indicate whether the property is located in a project." ;
    t:ruleLogic "If PropertyInProjectIndicator is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Condominium; Cooperative; Condop" ;
    t:dataPointNameValue "PropertyInProjectIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1043>
    t:messageText "Provide the legal description or an image of the legal description." ;
    t:ruleLogic "If ImageCategoryType = \"LegalDescription\" is not provided in any instance of IMAGE, and ParcelsLegalDescription is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "Legal Description" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "ParcelsLegalDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PARCEL_SUMMARY/PARCEL_SUMMARY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1044>
    t:messageText "Indicate whether the structure is a 'Dwelling' or 'Outbuilding'." ;
    t:ruleLogic "If @ValuationUseType = \"RentalComparable\" and ImprovementType is not provided in a given instance of IMPROVEMENT_DETAIL" ;
    t:propertyAffected "Rental Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ImprovementType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1045>
    t:messageText "Indicate whether the property has any amenities." ;
    t:ruleLogic "If PropertyAmenityExistsIndicator is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property Amenities" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "PropertyAmenityExistsIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1046>
    t:messageText "Indicate whether the subject property amenities have any defects, damages, or deficiencies." ;
    t:ruleLogic "If PropertyAmenityExistsIndicator = \"true\" and SubjectPropertyAmenitiesDefectsExistIndicator is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property Amenities" ;
    t:reportSubsection "Apparent Defects, Damages, Deficiencies" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "SubjectPropertyAmenitiesDefectsExistIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1047>
    t:messageText "Indicate whether the structure is a 'Dwelling' or 'Outbuilding'." ;
    t:ruleLogic "If ImprovementType is not provided in a given instance of IMPROVEMENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:dataPointNameValue "ImprovementType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1048>
    t:messageText "At least one structure on the property must be identified as a 'Dwelling'." ;
    t:ruleLogic "If ImprovementType is not \"Dwelling\" in at least one instance of IMPROVEMENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "ImprovementType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" ;
    t:minValue "1" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1049>
    t:messageText "Indicate whether the property is new construction." ;
    t:ruleLogic "If NewConstructionIndicator is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "New Construction" ;
    t:dataPointNameValue "NewConstructionIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1050>
    t:messageText "Provide 'Year Built' for each dwelling." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" and PropertyStructureBuiltYear is not provided in a given instance of IMPROVEMENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Year Built" ;
    t:dataPointNameValue "PropertyStructureBuiltYear" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1051>
    t:messageText "The property can only be considered as new construction when 'Year Built' for the dwelling(s) is within 1 year of the 'Effective Date of Appraisal'." ;
    t:ruleLogic "If NewConstructionIndicator = \"true\", and PropertyStructureBuiltYear is not the same year, or within 1 year of the AppraisalReportEffectiveDate, for one or more instances of IMPROVEMENT_DETAIL with ImprovementType = \"Dwelling\"." ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "New Construction" ;
    t:dataPointNameValue "NewConstructionIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" ;
    t:minValue "Extract Year from AppraisalReportEffectiveDate" ;
    t:maxValue "Extract Year from AppraisalReportEffectiveDate - 1 year" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1052>
    t:messageText "The 'Year Built' is prior to 1800. Please check for accuracy." ;
    t:ruleLogic "If PropertyStructureBuiltYear < 1800 in a given instance of IMPROVEMENT_DETAIL with ImprovementType = \"Dwelling\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Year Built (%PV%)" ;
    t:dataPointNameValue "PropertyStructureBuiltYear (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" ;
    t:minValue "1800" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1053>
    t:messageText "The 'Year Built' for a dwelling cannot be after 'Effective Date of Appraisal'." ;
    t:ruleLogic "If ((ExteriorConditionRatingCode = \"C1\" and PropertyStructureBuiltYear > year of (AppraisalReportEffectiveDate) + 2 years ) or (ExteriorConditionRatingCode <> \"C1\" and PropertyStructureBuiltYear > year of (AppraisalReportEffectiveDate)) in a given instance of IMPROVEMENT_DETAIL with ImprovementType = \"Dwelling\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Year Built (%PV%)" ;
    t:dataPointNameValue "PropertyStructureBuiltYear (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1054>
    t:messageText "For each dwelling indicate whether the 'Year Built' was estimated." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\", and PropertyStructureBuiltYearEstimatedIndicator is not provided in a given instance of IMPROVEMENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Year Built" ;
    t:dataPointNameValue "PropertyStructureBuiltYearEstimatedIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1055>
    t:messageText "Indicate whether the structure has a permanent heating system." ;
    t:ruleLogic "If ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\", and LivingUnitCount = 0, and HeatingSystemExistsIndicator is not provided in a given instance of IMPROVEMENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Outbuilding" ;
    t:reportSubsection "Detail" ;
    t:reportLabelValue "Heating" ;
    t:dataPointNameValue "HeatingSystemExistsIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" ;
    t:relatedValues "OutbuildingType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1056>
    t:messageText "Provide the intended functional design for each outbuilding (e.g., barn, standalone ADU, pool house)." ;
    t:ruleLogic "If ImprovementType = \"Outbuilding\" and OutbuildingType is not provided in a given instance of IMPROVEMENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Outbuilding" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "OutbuildingType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1057>
    t:messageText "Provide a description when 'Outbuilding Type' = 'Other'." ;
    t:ruleLogic "If OutbuildingType = \"Other\" and OutbuildingTypeOtherDescription is not provided in a given instance of IMPROVEMENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Outbuilding" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "OutbuildingTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1058>
    t:messageText "The type of utility(s) that exist in the outbuilding must be included. Select 'None' if there are no utilities." ;
    t:ruleLogic "If ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\", and (at least one instance of OUTBUILDING_UTILITY is not provided or UtilityType is not provided in a given instance of OUTBUILDING_UTILITY)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Outbuilding" ;
    t:reportSubsection "Detail" ;
    t:reportLabelValue "Utilities" ;
    t:dataPointNameValue "UtilityType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/OUTBUILDING/OUTBUILDING_UTILITIES/OUTBUILDING_UTILITY/" ;
    t:relatedValues "OutbuildingType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1059>
    t:messageText "Provide a description when utility type = 'Other'." ;
    t:ruleLogic "If ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and UtilityType = \"Other\" and UtilityTypeOtherDescription is not provided in a given instance of OUTBUILDING_UTILITY" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Outbuilding" ;
    t:reportSubsection "Detail" ;
    t:reportLabelValue "Utilities" ;
    t:dataPointNameValue "UtilityTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/OUTBUILDING/OUTBUILDING_UTILITIES/OUTBUILDING_UTILITY/" ;
    t:relatedValues "OutbuildingType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1060>
    t:messageText "Provide 'Structure Design' (e.g., Low-rise, Mid-rise, High-rise, Rowhouse / Townhouse, Semi-Detached) for each dwelling." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" and AttachmentType = \"Attached\", and StructuralDesignType is not provided in ARCHITECTURAL_DESIGN in a given instance of IMPROVEMENT" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Structure Design" ;
    t:dataPointNameValue "StructuralDesignType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/ARCHITECTURAL_DESIGN/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1061>
    t:messageText "Provide a description when 'Structure Design' = 'Other'." ;
    t:ruleLogic "If StructuralDesignType = \"Other\" and StructuralDesignTypeOtherDescription is not provided in a given instance of ARCHITECTURAL_DESIGN" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Structure Design" ;
    t:dataPointNameValue "StructuralDesignTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/ARCHITECTURAL_DESIGN/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1062>
    t:messageText "Provide 'Construction Method' (e.g., Site Built, Manufactured, Modular) for each dwelling." ;
    t:ruleLogic "If ((ImprovementType = \"Dwelling\" and AttachmentType = \"Detached\") or (ImprovementType = \"Dwelling\" and AttachmentType = \"Attached\" and StructuralDesignType = \"RowhouseTownhouse\" or \"SemiDetached\" or \"Other\")), and (at least one instance of CONSTRUCTION_METHOD is not provided or ConstructionMethodType is not provided in a given instance of CONSTRUCTION_METHOD)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Construction Method" ;
    t:dataPointNameValue "ConstructionMethodType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/CONSTRUCTION_METHODS/CONSTRUCTION_METHOD/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1063>
    t:messageText "Provide a description when 'Construction Method' = 'Other'." ;
    t:ruleLogic "If ConstructionMethodType = \"Other\" and ConstructionMethodTypeOtherDescription is not provided in a given instance of CONSTRUCTION_METHOD" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Construction Method" ;
    t:dataPointNameValue "ConstructionMethodTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/CONSTRUCTION_METHODS/CONSTRUCTION_METHOD/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1064>
    t:messageText "Provide the estimated number of years of the dwelling's remaining useful life." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and ImprovementType = \"Dwelling\" and EstimatedRemainingEconomicLifeYearsCount is not provided in a given instance of STRUCTURE_ANALYSIS_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Cost Approach" ;
    t:reportSubsection "Depreciated Cost - Dwelling" ;
    t:reportLabelValue "Remaining Economic Life" ;
    t:dataPointNameValue "EstimatedRemainingEconomicLifeYearsCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_ANALYSES/STRUCTURE_ANALYSIS/STRUCTURE_ANALYSIS_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1065>
    t:messageText "The exterior feature type must be included. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" and HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\" and ImprovementComponentType is not provided in a given instance of STRUCTURE_COMPONENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Feature" ;
    t:dataPointNameValue "ImprovementComponentType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/STRUCTURE_COMPONENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1066>
    t:messageText "Provide a description when 'Feature Type' = 'Other'." ;
    t:ruleLogic "If ImprovementComponentType = \"Other\" and ImprovementComponentTypeOtherDescription is not provided in a given instance of STRUCTURE_COMPONENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Feature" ;
    t:dataPointNameValue "ImprovementComponentTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/STRUCTURE_COMPONENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1067>
    t:messageText "Provide the foundation details (e.g., style, material) for the structure." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" AND HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\" and there is no instance of STRUCTURE_COMPONENT_DETAIL with ImprovementComponentType = \"Foundation\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Feature" ;
    t:dataPointNameValue "ImprovementComponentType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/STRUCTURE_COMPONENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1068>
    t:messageText "Provide the materials used for the foundation." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" AND HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\" and ImprovementComponentType = \"Foundation\" and (at least one instance of FOUNDATION_MATERIAL is not provided or FoundationMaterialType is not provided in a given instance of FOUNDATION_MATERIAL)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Detail" ;
    t:dataPointNameValue "FoundationMaterialType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/FOUNDATIONS/FOUNDATION/FOUNDATION_MATERIALS/FOUNDATION_MATERIAL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1069>
    t:messageText "Provide a description when foundation material = 'Other'." ;
    t:ruleLogic "If FoundationMaterialType = \"Other\" and FoundationMaterialTypeOtherDescription is not provided in a given instance of FOUNDATION_MATERIAL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Detail" ;
    t:dataPointNameValue "FoundationMaterialTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/FOUNDATIONS/FOUNDATION/FOUNDATION_MATERIALS/FOUNDATION_MATERIAL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1070>
    t:messageText "Provide the type of foundation." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" AND HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\" and ImprovementComponentType = \"Foundation\" and (at least one instance of FOUNDATION_STYLE is not provided or FoundationType is not provided in a given instance of FOUNDATION_STYLE)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Detail" ;
    t:dataPointNameValue "FoundationType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/FOUNDATIONS/FOUNDATION/FOUNDATION_STYLES/FOUNDATION_STYLE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1071>
    t:messageText "Provide a description when foundation type = 'Other'." ;
    t:ruleLogic "If FoundationType = \"Other\" and FoundationTypeOtherDescription is not provided in a given instance of FOUNDATION_STYLE" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Detail" ;
    t:dataPointNameValue "FoundationTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/FOUNDATIONS/FOUNDATION/FOUNDATION_STYLES/FOUNDATION_STYLE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1072>
    t:messageText "Provide the roof details (e.g., estimated age, material) for the structure." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" AND HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\" and there is no instance of STRUCTURE_COMPONENT_DETAIL with ImprovementComponentType = \"Roof\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Feature" ;
    t:dataPointNameValue "ImprovementComponentType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/STRUCTURE_COMPONENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1073>
    t:messageText "Provide the estimated age of the roof." ;
    t:ruleLogic "If ImprovementComponentType = \"Roof\" and RoofEstimatedAgeRangeType is not provided in ROOF_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Detail" ;
    t:dataPointNameValue "RoofEstimatedAgeRangeType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/ROOF/ROOF_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1074>
    t:messageText "Indicate whether the roof is observable." ;
    t:ruleLogic "If ImprovementComponentType = \"Roof\" and RoofObservableIndicator is not provided in ROOF_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Feature" ;
    t:dataPointNameValue "RoofObservableIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/ROOF/ROOF_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1075>
    t:messageText "Provide the roof material." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" AND HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\" and ImprovementComponentType = \"Roof\" and (at least one instance of ROOF_MATERIAL is not provided or RoofMaterialType is not provided in a given instance of ROOF_MATERIAL)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Detail" ;
    t:dataPointNameValue "RoofMaterialType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/ROOF/ROOF_MATERIALS/ROOF_MATERIAL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1076>
    t:messageText "Provide a description when roof material = 'Other'." ;
    t:ruleLogic "If RoofMaterialType = \"Other\" and RoofMaterialTypeOtherDescription is not provided in a given instance of ROOF_MATERIAL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Detail" ;
    t:dataPointNameValue "RoofMaterialTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/ROOF/ROOF_MATERIALS/ROOF_MATERIAL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1077>
    t:messageText "Provide additional description for the exterior feature being referenced." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\", and HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\", and ImprovementComponentType = \"Windows\" or \"Other\", and ImprovementComponentTypeAdditionalDescription is not provided in a given instance of STRUCTURE_COMPONENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Detail" ;
    t:dataPointNameValue "ImprovementComponentTypeAdditionalDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/STRUCTURE_COMPONENT_DETAIL/" ;
    t:relatedValues "ImprovementComponentType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1078>
    t:messageText "Provide the 'Condition Status'." ;
    t:ruleLogic "If (ImprovementType = \"Dwelling\" and ImprovementComponentType <> \"Roof\"), or (ImprovementType = \"Dwelling\" and ImprovementComponentType = \"Roof\" and RoofObservableIndicator = \"true\"), and ImprovementComponentConditionStatusType is not provided in a given instance of STRUCTURE_COMPONENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Condition Status" ;
    t:dataPointNameValue "ImprovementComponentConditionStatusType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/STRUCTURE_COMPONENT_DETAIL/" ;
    t:relatedValues "ImprovementComponentType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1079>
    t:messageText "Provide the exterior walls and trim details (e.g., material) for the structure." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" AND HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\" and there is no instance of STRUCTURE_COMPONENT_DETAIL with ImprovementComponentType = \"'ExteriorWallsAndTrim\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Feature" ;
    t:dataPointNameValue "ImprovementComponentType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/STRUCTURE_COMPONENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1080>
    t:messageText "Provide the exterior wall material type." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" AND HomeownerResponsibleForExteriorMaintenanceIndicator = \"true\" and ImprovementComponentType = \"ExteriorWallsAndTrim\" and (at least one instance of EXTERIOR_WALL is not provided or WallMaterialType is not provided in a given instance of EXTERIOR_WALL)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Detail" ;
    t:dataPointNameValue "WallMaterialType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/EXTERIOR_WALLS/EXTERIOR_WALL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1081>
    t:messageText "Provide a description when exterior wall material = 'Other'." ;
    t:ruleLogic "If WallMaterialType = \"Other\" and WallMaterialTypeOtherDescription is not provided in a given instance of EXTERIOR_WALL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Quality and Condition" ;
    t:reportLabelValue "Detail" ;
    t:dataPointNameValue "WallMaterialTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_COMPONENTS/STRUCTURE_COMPONENT/EXTERIOR_WALLS/EXTERIOR_WALL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1082>
    t:messageText "Indicate whether the rowhouse / townhouse is an end unit." ;
    t:ruleLogic "If StructuralDesignType = \"RowhouseTownhouse\" and RowhouseTownhouseEndUnitIndicator is not provided in a given instance of STRUCTURE_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Townhouse End Unit" ;
    t:dataPointNameValue "RowhouseTownhouseEndUnitIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1083>
    t:messageText "Provide the 'Gross Building Area' of the outbuilding." ;
    t:ruleLogic "If ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\", and StructureAreaMeasure is not provided in a given instance of STRUCTURE_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Outbuilding" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Gross Building Area" ;
    t:dataPointNameValue "StructureAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" ;
    t:relatedValues "OutbuildingType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1084>
    t:messageText "Provide the number of living units in the structure." ;
    t:ruleLogic """If ImprovementType = "Dwelling" or
(ImprovementType = "Outbuilding" and OutbuildingRealPropertyIndicator = "true"), and LivingUnitCount is not provided in a given instance of STRUCTURE_DETAIL""" ;
    t:propertyAffected "Subject" ;
    t:dataPointNameValue "LivingUnitCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1085>
    t:messageText "The number of living units cannot be 0 for any dwelling." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" and LivingUnitCount = 0 in a given instance of STRUCTURE_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Subject Property Units in Structure" ;
    t:dataPointNameValue "LivingUnitCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" ;
    t:minValue "1" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1086>
    t:messageText "The number of living units in the structure does not equal the number of units delivered in the UAD XML for the structure. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "For each IMPROVEMENT, if LivingUnitCount <> the number of instances of PROPERTY_UNIT" ;
    t:propertyAffected "Subject" ;
    t:dataPointNameValue "LivingUnitCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1087>
    t:messageText "Provide the number of 'Floors in Building'." ;
    t:ruleLogic "If StructuralDesignType = \"Highrise\" or \"Midrise\", and StoriesCount is not provided in a given instance of STRUCTURE_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Floors in Building" ;
    t:dataPointNameValue "StoriesCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1088>
    t:messageText "Indicate whether the factory-built certification has been examined for an on-frame modular or modular home." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\", and ConstructionMethodType = \"Modular\" or \"OnFrameModular\", and FactoryBuiltCertificationExaminedIndicator is not provided in a given instance of STRUCTURE_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Factory Built Certification" ;
    t:dataPointNameValue "FactoryBuiltCertificationExaminedIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1089>
    t:messageText "Provide the heating system type. Select 'None' if there is no heating system." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" or (ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and LivingUnitCount > 0), and (at least one instance of HEATING_SYSTEM is not provided or HeatingSystemType is not provided in a given instance of HEATING_SYSTEM)" ;
    t:propertyAffected "Subject" ;
    t:reportLabelValue "System" ;
    t:dataPointNameValue "HeatingSystemType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/SYSTEM/HEATING_SYSTEMS/HEATING_SYSTEM/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1090>
    t:messageText "Provide a description when heating system type = 'Other'." ;
    t:ruleLogic "If HeatingSystemType = \"Other\" and HeatingSystemTypeOtherDescription is not provided in a given instance of HEATING_SYSTEM" ;
    t:propertyAffected "Subject" ;
    t:reportLabelValue "System" ;
    t:dataPointNameValue "HeatingSystemTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/SYSTEM/HEATING_SYSTEMS/HEATING_SYSTEM/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1091>
    t:messageText "When 'Units Excluding ADUs' is more than 1, the structure identifier must be provided for each dwelling." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" and LivingUnitExcludingADUCount > 1, and StructureIdentifier is not provided in a given instance of STRUCTURE_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "StructureIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1092>
    t:messageText "The structure identifier must be unique." ;
    t:ruleLogic "If StructureIdentifier is not unique across all instances of STRUCTURE_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "StructureIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1093>
    t:messageText "The structure identifier must be unique." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and StructureIdentifier is not unique across all instances of IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL for a given comp" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Unit(s); Exterior Quality and Condition; Interior Quality and Condition" ;
    t:reportLabelValue "Structure ID | Unit ID" ;
    t:dataPointNameValue "StructureIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1094>
    t:messageText "Indicate whether the outbuilding has any defects, damages, or deficiencies." ;
    t:ruleLogic "If ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and OutbuildingDefectsExistIndicator is not provided in a given instance of IMPROVEMENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Outbuilding" ;
    t:reportSubsection "Apparent Defects, Damages, Deficiencies" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "OutbuildingDefectsExistIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" ;
    t:relatedValues "OutbuildingType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1095>
    t:messageText "Provide the finished area of the outbuilding, even if the value is 0." ;
    t:ruleLogic "If ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and StructureExcludingVehicleStorageAndADUFinishedAreaMeasure is not provided in a given instance of STRUCTURE_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Outbuilding" ;
    t:reportSubsection "Detail" ;
    t:reportLabelValue "Total Area" ;
    t:dataPointNameValue "StructureExcludingVehicleStorageAndADUFinishedAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" ;
    t:relatedValues "OutbuildingType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1096>
    t:messageText "Provide the unfinished area of the outbuilding, even if the value is 0." ;
    t:ruleLogic "If ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and StructureExcludingVehicleStorageAndADUUnfinishedAreaMeasure is not provided in a given instance of STRUCTURE_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Outbuilding" ;
    t:reportSubsection "Detail" ;
    t:reportLabelValue "Total Area" ;
    t:dataPointNameValue "StructureExcludingVehicleStorageAndADUUnfinishedAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" ;
    t:relatedValues "OutbuildingType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1097>
    t:messageText "Indicate whether the dwelling has any non-continuous finished area (e.g., a finished office above, below, or behind an attached garage that cannot be accessed from within any living unit)." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" and LivingUnitExcludingADUCount = 1, and NonContinuousFinishedAreaIndicator is not provided in in a given instance of IMPROVEMENT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Dwelling(s)" ;
    t:reportLabelValue "Noncontinuous Finished Area" ;
    t:dataPointNameValue "NonContinuousFinishedAreaIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1098>
    t:messageText "Indicate whether the core heating system for dwelling is located below grade." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" and HeatingSystemType <> \"None\", and CoreHeatingSystemBelowGradeIndicator is not provided in SYSTEM_DETAIL for a given instance of IMPROVEMENT" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Mechanical System Details" ;
    t:reportLabelValue "Core Heating System Below Grade" ;
    t:dataPointNameValue "CoreHeatingSystemBelowGradeIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/SYSTEM/SYSTEM_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1099>
    t:messageText "Provide the approximate elevation range from grade level to the bottom of the front entrance door of the dwelling." ;
    t:ruleLogic "If FrontDoorApproximateElevationRangeType is not provided in STRUCTURE_DETAIL for a given instance of IMRPOVEMENT with ImprovementType = \"Dwelling\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Front Door Elevation" ;
    t:dataPointNameValue "FrontDoorApproximateElevationRangeType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1100>
    t:messageText "The manufactured home certification program name (e.g., Fannie Mae MH Advantage, Freddie Mac CHOICEHome) must be included when the manufactured home certification program identifier has been delivered." ;
    t:ruleLogic "If ManufacturedHomeFinancingProgramEligibilityIdentifier is provided and ManufacturedHomeFinancingProgramEligibilityType is not provided in a given instance of MANUFACTURED_HOME_FINANCING_PROGRAM" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Manufactured Home" ;
    t:reportSubsection "Manufactured Home Certification Program" ;
    t:reportLabelValue "Certification" ;
    t:dataPointNameValue "ManufacturedHomeFinancingProgramEligibilityType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/MANUFACTURED_HOME/MANUFACTURED_HOME_FINANCING_PROGRAMS/MANUFACTURED_HOME_FINANCING_PROGRAM/" ;
    t:relatedValues "ManufacturedHomeFinancingProgramEligibilityIdentifier (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1101>
    t:messageText "The manufactured home certification program identifier must be included when the manufactured home certification program name (e.g., Fannie Mae MH Advantage, Freddie Mac CHOICEHome) has been delivered." ;
    t:ruleLogic "If ManufacturedHomeFinancingProgramEligibilityType is provided and ManufacturedHomeFinancingProgramEligibilityIdentifier is not provided in a given instance of MANUFACTURED_HOME_FINANCING_PROGRAM" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Manufactured Home" ;
    t:reportSubsection "Manufactured Home Certification Program" ;
    t:reportLabelValue "Identifier" ;
    t:dataPointNameValue "ManufacturedHomeFinancingProgramEligibilityIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/MANUFACTURED_HOME/MANUFACTURED_HOME_FINANCING_PROGRAMS/MANUFACTURED_HOME_FINANCING_PROGRAM/" ;
    t:relatedValues "ManufacturedHomeFinancingProgramEligibilityType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1102>
    t:messageText "Provide a description when 'Manufactured Home Certification Program' = 'Other'." ;
    t:ruleLogic "If ManufacturedHomeFinancingProgramEligibilityType = \"Other\" and ManufacturedHomeFinancingProgramEligibilityTypeOtherDescription is not provided in a given instance of MANUFACTURED_HOME_FINANCING_PROGRAM" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Manufactured Home" ;
    t:reportSubsection "Manufactured Home Certification Program" ;
    t:reportLabelValue "Certification" ;
    t:dataPointNameValue "ManufacturedHomeFinancingProgramEligibilityTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/MANUFACTURED_HOME/MANUFACTURED_HOME_FINANCING_PROGRAMS/MANUFACTURED_HOME_FINANCING_PROGRAM/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1103>
    t:messageText "Indicate whether the manufactured home is attached to a permanent foundation." ;
    t:ruleLogic "If (ImprovementType = \"Dwelling\" and ConstructionMethodType = \"Manufactured\") or (ImprovementType = \"Outbuilding\" and OutbuildingType = \"ManufacturedHome\"), and ManufacturedHomeAttachedToFoundationIndicator is not provided in a given instance of MANUFACTURED_HOME_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportLabelValue "Attached to Permanent Foundation" ;
    t:dataPointNameValue "ManufacturedHomeAttachedToFoundationIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/MANUFACTURED_HOME/MANUFACTURED_HOME_DETAIL/" ;
    t:relatedValues "ImprovementType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1104>
    t:messageText "Indicate whether the towing hitch, wheels and axles have been removed from the frame of the manufactured home." ;
    t:ruleLogic "If (ImprovementType = \"Dwelling\" and ConstructionMethodType = \"Manufactured\") or (ImprovementType = \"Outbuilding\" and OutbuildingType = \"ManufacturedHome\" and OutbuildingRealPropertyIndicator = \"true\" and LivingUnitCount > 0), and ManufacturedHomeHitchWheelsAxlesRemovedIndicator is not provided in a given instance of MANUFACTURED_HOME_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Manufactured Home" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Towing Hitch, Wheels, Axles Removed" ;
    t:dataPointNameValue "ManufacturedHomeHitchWheelsAxlesRemovedIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/MANUFACTURED_HOME/MANUFACTURED_HOME_DETAIL/" ;
    t:relatedValues "ImprovementType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1105>
    t:messageText "Indicate whether the HUD certification label is present for each section of the manufactured home." ;
    t:ruleLogic "If (ImprovementType = \"Dwelling\" and ConstructionMethodType = \"Manufactured\") or (ImprovementType = \"Outbuilding\" and OutbuildingType = \"ManufacturedHome\" and OutbuildingRealPropertyIndicator = \"true\" and LivingUnitCount > 0), and ManufacturedHomeHUDCertificateLabelIndicator is not provided in a given instance of MANUFACTURED_HOME_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Manufactured Home" ;
    t:reportSubsection "HUD Certification Label" ;
    t:reportLabelValue "Label Present for All Sections" ;
    t:dataPointNameValue "ManufacturedHomeHUDCertificateLabelIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/MANUFACTURED_HOME/MANUFACTURED_HOME_DETAIL/" ;
    t:relatedValues "ImprovementType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1106>
    t:messageText "Indicate whether the HUD data plate is attached to the manufactured home." ;
    t:ruleLogic "If (ImprovementType = \"Dwelling\" and ConstructionMethodType = \"Manufactured\") or (ImprovementType = \"Outbuilding\" and OutbuildingType = \"ManufacturedHome\" and OutbuildingRealPropertyIndicator = \"true\" and LivingUnitCount > 0), and ManufacturedHomeHUDDataPlateAttachedIndicator is not provided in a given instance of MANUFACTURED_HOME_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Manufactured Home" ;
    t:reportSubsection "HUD Data Plate" ;
    t:reportLabelValue "HUD Data Plate Attached" ;
    t:dataPointNameValue "ManufacturedHomeHUDDataPlateAttachedIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/MANUFACTURED_HOME/MANUFACTURED_HOME_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1107>
    t:messageText "Provide the year (YYYY format) in which the manufactured home was installed." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" and ConstructionMethodType = \"Manufactured\", and ManufacturedHomeInstalledDate is not provided in a given instance of MANUFACTURED_HOME_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Manufactured Home" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Year Installed" ;
    t:dataPointNameValue "ManufacturedHomeInstalledDate" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/MANUFACTURED_HOME/MANUFACTURED_HOME_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1108>
    t:messageText "Indicate whether the content of the manufacturer's or retailer's invoice appears reasonable." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" and ConstructionMethod = \"Manufactured\" and (ManufacturedHomeRetailerInvoiceReviewedIndicator = \"true\" or ManufacturedHomeInvoiceReviewedIndicator = \"true\") and ManufacturedHomeInvoiceReasonableIndicator is not provided in a given instance of MANUFACTURED_HOME_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Manufactured Home" ;
