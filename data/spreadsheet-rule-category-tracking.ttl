<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1741>
    t:messageText "The cooperative proprietary lease expiration date must include year and month (YYYY-MM format)." ;
    t:ruleLogic "If CooperativeProprietaryLeaseExpirationDate is not provided in YYYY-MM format." ;
    t:propertyAffected "Subject" ;
    t:reportSection "Project Information" ;
    t:reportSubsection "Cooperative Information" ;
    t:reportLabelValue "Proprietary Lease Expires (%PV%)" ;
    t:dataPointNameValue "CooperativeProprietaryLeaseExpirationDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" ;
    t:dateFormat "CCYY-MM" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1742>
    t:messageText "The latitude must be a value between -90 and 90 with at least 5 digits of precision to the right of the decimal point. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If LatitudeIdentifier is not provided between -90 and 90 with at least 5 digits of precision to the right of the decimal point" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "LatitudeIdentifier (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LOCATION_IDENTIFIER/GEOSPATIAL_INFORMATION/" ;
    t:minValue "-90" ;
    t:maxValue "90" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1743>
    t:messageText "The longitude must be a value between -180 and 180 with at least 5 digits of precision to the right of the decimal point. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If LongitudeIdentifier is not provided between -180 and 180 with at least 5 digits of precision to the right of the decimal point" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "LongitudeIdentifier (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LOCATION_IDENTIFIER/GEOSPATIAL_INFORMATION/" ;
    t:minValue "-180" ;
    t:maxValue "180" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1744>
    t:messageText "The prior sale or transfer date for the sales comparable must include year, month and day." ;
    t:ruleLogic "If OwnershipTransferDate does not include year, month and day (YYYY-MM-DD format) in a given instance of SALES_HISTORY" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach; Prior Sale and Transfer History" ;
    t:reportSubsection "General Information; Comparable Transfer History" ;
    t:reportLabelValue "Sale Date; Date (%PV%)" ;
    t:dataPointNameValue "OwnershipTransferDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
    t:dateFormat "CCYY-MM-DD" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1745>
    t:messageText "The amount related to the transfer of ownership of real property (typically the sale price) must be greater than or equal to $0." ;
    t:ruleLogic "If OwnershipTransferTransactionAmount < 0 in SALES_HISTORY" ;
    t:propertyAffected "Gross Rent Multiplier Comparable #n" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Gross Rent Multiplier Comparables" ;
    t:reportLabelValue "Sale Price (%PV%)" ;
    t:dataPointNameValue "OwnershipTransferTransactionAmount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
    t:minValue "0" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1746>
    t:messageText "Provide 'Reasonable Exposure Time' as a number of days or as a range of days." ;
    t:ruleLogic "If MarketingOrExposureDaysCount is not provided, and (either MarketingOrExposureLowRangeDaysCount or MarketingOrExposureHighRangeDaysCount is not provided)" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Appraisal Summary" ;
    t:reportLabelValue "Reasonable Exposure Time" ;
    t:dataPointNameValue "MarketingOrExposureDaysCount" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_RECONCILIATION_SUMMARY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1747>
    t:messageText "The exterior inspection method, interior inspection method, and inspection date must be associated with the party that performed the inspection. In the UAD XML, one instance of RELATIONSHIP must be included for each Appraiser and/or Supervisory Appraiser that links INSPECTION to ROLE. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If PartyRoleType = \"Appraiser\" or \"AppraiserSupervisor\" and there is no instance of RELATIONSHIP provided for each role that links INSPECTION to the associated ROLE." ;
    t:propertyAffected "N/A" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "Contact Information" ;
    t:reportLabelValue "Subject Property Inspection" ;
    t:dataPointNameValue "@xlink:arcrole" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1748>
    t:messageText "The latitude must be a value between -90 and 90 with at least 5 digits of precision to the right of the decimal point. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and LatitudeIdentifier is not provided between -90 and 90 with at least 5 digits of precision to the right of the decimal point" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "LatitudeIdentifier (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LOCATION_IDENTIFIER/GEOSPATIAL_INFORMATION/" ;
    t:minValue "-90" ;
    t:maxValue "90" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1749>
    t:messageText "The longitude must be a value between -180 and 180 with at least 5 digits of precision to the right of the decimal point. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and LongitudeIdentifier is not provided between -180 and 180 with at least 5 digits of precision to the right of the decimal point" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "LongitudeIdentifier (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LOCATION_IDENTIFIER/GEOSPATIAL_INFORMATION/" ;
    t:minValue "-180" ;
    t:maxValue "180" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1750>
    t:messageText "Indicate whether a reconsideration of value has been requested." ;
    t:ruleLogic "If ReconsiderationOfValueIndicator is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ReconsiderationOfValueIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_REPORT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1751>
    t:messageText "Provide the commentary on the outcome of the reconsideration of value." ;
    t:ruleLogic "If ReconsiderationOfValueIndicator = \"true\" and ReconsiderationOfValueCommentDescription is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Revision History" ;
    t:reportSubsection "Reconsideration of Value" ;
    t:reportLabelValue "Reconsideration of Value Commentary" ;
    t:dataPointNameValue "ReconsiderationOfValueCommentDescription" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/RECONSIDERATIONS_OF_VALUE/RECONSIDERATION_OF_VALUE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1752>
    t:messageText "Provide the party that initiated the request for reconsideration of value." ;
    t:ruleLogic "If ReconsiderationOfValueIndicator = \"true\" and ReconsiderationOfValueRequestedByType is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Revision History" ;
    t:reportSubsection "Reconsideration of Value" ;
    t:reportLabelValue "Type" ;
    t:dataPointNameValue "ReconsiderationOfValueRequestedByType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/RECONSIDERATIONS_OF_VALUE/RECONSIDERATION_OF_VALUE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1753>
    t:messageText "Indicate whether the reconsideration of value request resulted in a change to the Opinion of Market Value." ;
    t:ruleLogic "If ReconsiderationOfValueIndicator = \"true\" and ReconsiderationOfValueResultType is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Revision History" ;
    t:reportSubsection "Reconsideration of Value" ;
    t:reportLabelValue "Result" ;
    t:dataPointNameValue "ReconsiderationOfValueResultType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/RECONSIDERATIONS_OF_VALUE/RECONSIDERATION_OF_VALUE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1754>
    t:messageText "Provide the date the appraiser completed the reconsideration of value." ;
    t:ruleLogic "If ReconsiderationOfValueIndicator = \"true\" and ReconsiderationOfValueResultDate is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Revision History" ;
    t:reportSubsection "Reconsideration of Value" ;
    t:reportLabelValue "Date" ;
    t:dataPointNameValue "ReconsiderationOfValueResultDate" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/RECONSIDERATIONS_OF_VALUE/RECONSIDERATION_OF_VALUE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1755>
    t:messageText "The reconsideration of value date must include year, month and day." ;
    t:ruleLogic "If ReconsiderationOfValueResultDate does not include year, month and day YYYY-MM-DD format" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Revision History" ;
    t:reportSubsection "Reconsideration of Value" ;
    t:reportLabelValue "Date (%PV%)" ;
    t:dataPointNameValue "ReconsiderationOfValueResultDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/RECONSIDERATIONS_OF_VALUE/RECONSIDERATION_OF_VALUE/" ;
    t:dateFormat "CCYY-MM-DD" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1756>
    t:messageText "The reconsideration of value date must be on or after the 'Effective Date of Appraisal'." ;
    t:ruleLogic "If ReconsiderationOfValueResultDate < AppraisalReportEffectiveDate" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Revision History" ;
    t:reportSubsection "Reconsideration of Value" ;
    t:reportLabelValue "Date (%PV%)" ;
    t:dataPointNameValue "ReconsiderationOfValueResultDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/RECONSIDERATIONS_OF_VALUE/RECONSIDERATION_OF_VALUE/" ;
    t:relatedValues "AppraisalReportEffectiveDate (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1757>
    t:messageText "The reconsideration of value date cannot be more than a year old." ;
    t:ruleLogic "If ReconsiderationOfValueResultDate is more than 367 days before the current date" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Revision History" ;
    t:reportSubsection "Reconsideration of Value" ;
    t:reportLabelValue "Date (%PV%)" ;
    t:dataPointNameValue "ReconsiderationOfValueResultDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/RECONSIDERATIONS_OF_VALUE/RECONSIDERATION_OF_VALUE/" ;
    t:dateFormat "CCYY-MM-DD" ;
    t:minValue "Current - 367" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1758>
    t:messageText "Only one line-item adjustment is allowed for this Adjustment Type." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and there is more than one instance of COMPARABLE_ADJUSTMENT with the same ComparableAdjustmentType enumeration that should only be adjusted once (e.g., View). Please refer to the Adjustments Cardinality tab for the list of adjustments that can be applied only once." ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display (Comparable Adjustment Type (%PV%))" ;
    t:dataPointNameValue "ComparableAdjustmentType (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_ADJUSTMENTS/COMPARABLE_ADJUSTMENT/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1759>
    t:messageText "More than one Supervisory Appraiser has been identified in the appraisal. There can be only one Supervisory Appraiser." ;
    t:ruleLogic "If more than one instance of ROLE_DETAIL has PartyRoleType = \"AppraiserSupervisor\" across all instances of PARTY" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "Contact Information" ;
    t:reportLabelValue "Supervisory Appraiser" ;
    t:dataPointNameValue "PartyRoleType" ;
    t:xpath "../SERVICE/PARTIES/PARTY/ROLES/ROLE/ROLE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1760>
    t:messageText "Provide 'Reconciliation of Sales Comparison Approach' when sales comparison approach is included in the appraisal." ;
    t:ruleLogic "If SalesComparisonApproachIndicator = \"true\" and SalesComparisonCommentDescription is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Reconciliation of Sales Comparison Approach" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "SalesComparisonCommentDescription" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/SALES_COMPARISON_APPROACH/SALES_COMPARISON_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1761>
    t:messageText "Provide 'Cost Approach Commentary' when cost approach is included in the appraisal." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and CostAnalysisCommentDescription is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportSubsection "Cost Approach Commentary" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "CostAnalysisCommentDescription" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/COST_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1762>
    t:messageText "Provide 'Income Approach Commentary' when income approach is included in the appraisal." ;
    t:ruleLogic "If IncomeApproachIndicator = \"true\" and IncomeAnalysisCommentDescription is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Income Approach Commentary" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "IncomeAnalysisCommentDescription" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/INCOME_APPROACH/INCOME_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1763>
    t:messageText "Provide 'Rental Analysis Commentary' when rent schedule is included in the appraisal." ;
    t:ruleLogic "If RentScheduleIndicator = \"true\" and there is no instance of VALUATION_COMMENTARY with ValuationAnalysisCategoryType = \"ComparableRental\" and ValuationCommentText" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Rental Analysis Commentary" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "ValuationAnalysisCategoryType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_COMMENTARIES/VALUATION_COMMENTARY/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1764>
    t:messageText "Each dwelling must contain at least one living unit." ;
    t:ruleLogic "If ImprovementType = ‘Dwelling’ and there are no instances of PROPERTY_UNIT" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Unit Interior" ;
    t:reportSubsection "{No Subsection}" ;
    t:dataPointNameValue "PROPERTY_UNIT" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1765>
    t:messageText "The commentary provided for the specified field exceeds the allowable limit of 140 characters." ;
    t:ruleLogic "If ValuationAnalysisCategoryType = (\"HazardZones\" or \"PropertyNonResidentialUses\") and ValuationCommentText length exceeds 140 characters" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Site" ;
    t:reportSubsection "Site Features and Impact to Value / Marketability" ;
    t:reportLabelValue "Comment" ;
    t:dataPointNameValue "ValuationCommentText" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_COMMENTARIES/VALUATION_COMMENTARY/" ;
    t:relatedValues "ValuationAnalysisCategoryType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1766>
    t:messageText "The commentary provided for the specified field exceeds the allowable limit of 210 characters." ;
    t:ruleLogic "If ValuationAnalysisCategoryType = (\"ProjectDeveloperOrSponsorControlsProjectManagement\" or \"IncompleteProject\" or \"ProjectConversion\" or \"SingleEntityGreatestNumberOfUnitsOwned\" or \"SingleEntityGreatestNumberOfSharesOwned\" or \"ProjectCommercialSpace\" or \"ProjectLegalAction\" or \"ProjectSpecialAssessmentsAttributedToSubjectProperty\" or \"TransferFeeAttributedToSubjectProperty\" or \"PropertyTaxAbatementsOrExemptions\") and ValuationCommentText length exceeds 210 characters " ;
    t:propertyAffected "N/A" ;
    t:dataPointNameValue "ValuationCommentText" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_COMMENTARIES/VALUATION_COMMENTARY/" ;
    t:relatedValues "ValuationAnalysisCategoryType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1767>
    t:messageText "The commentary provided for the specified field exceeds the allowable limit of 540 characters." ;
    t:ruleLogic "If ValuationAnalysisCategoryType = \"PropertySpecialTaxAssessments\" and ValuationCommentText length exceeds 540 characters " ;
    t:propertyAffected "N/A" ;
    t:reportSection "Subject Property" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Description of Special Tax Assessments and Impact to Value / Marketability" ;
    t:dataPointNameValue "ValuationCommentText" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_COMMENTARIES/VALUATION_COMMENTARY/" ;
    t:relatedValues "ValuationAnalysisCategoryType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1768>
    t:messageText "The commentary provided for the specified field exceeds the allowable limit of 2500 characters." ;
    t:ruleLogic "If ValuationAnalysisCategoryType = (\"ProjectFactors\" or \"Project\" or \"WaterFrontages\" or \"SiteFeatures\" or \"SiteViews\" or \"SiteInfluences\") and ValuationCommentText length exceeds 2500 characters" ;
    t:propertyAffected "N/A" ;
    t:dataPointNameValue "ValuationCommentText" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_COMMENTARIES/VALUATION_COMMENTARY/" ;
    t:relatedValues "ValuationAnalysisCategoryType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1769>
    t:messageText "Provide 'Site Influence (Location)' for the sales comparable." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and (at least one instance of SITE_INFLUENCE_DETAIL is not provided or SiteInfluenceType is not provided in a given instance of SITE_INFLUENCE_DETAIL)" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Site" ;
    t:reportLabelValue "Site Influence (Location)" ;
    t:dataPointNameValue "SiteInfluenceType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SITE/SITE_INFLUENCES/SITE_INFLUENCE/SITE_INFLUENCE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1770>
    t:messageText "Provide a description when 'Site Influence (Location)' = 'Other'." ;
    t:ruleLogic "If SiteInfluenceType = \"Other\" and SiteInfluenceTypeOtherDescription is not provided in a given instance of SITE_INFLUENCE_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Site" ;
    t:reportLabelValue "Site Influence (Location)" ;
    t:dataPointNameValue "SiteInfluenceTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SITE/SITE_INFLUENCES/SITE_INFLUENCE/SITE_INFLUENCE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1771>
    t:messageText "Provide the 'Transfer Terms' for the associated transaction." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and OwnershipTransferTransactionType = \"Sale\" and SaleType is not provided in a given instance of SALES_HISTORY" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "General Information" ;
    t:reportLabelValue "Transfer Terms" ;
    t:dataPointNameValue "SaleType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
    t:relatedValues "OwnershipTransferDate (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1772>
    t:messageText "Provide 'Floor Number' for the sales comparable." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and  ImprovementType = \"Dwelling\" and AttachmentType = \"Attached\" and StructuralDesignType = (\"Lowrise\" or \"Highrise\" or \"Midrise\"), and FloorIdentifier is not provided in a given instance of PROPERTY_UNIT_DETAIL" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Unit(s)" ;
    t:reportLabelValue "Floor Number" ;
    t:dataPointNameValue "FloorIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1773>
    t:messageText "Provide 'Property Rights Appraised' for the sales comparable." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and (PropertyInProjectIndicator = \"false\" or (PropertyInProjectIndicator = \"true\" and ProjectLegalStructureType = \"Condominium\")), and PropertyEstateType is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "General Information" ;
    t:reportLabelValue "Property Rights Appraised" ;
    t:dataPointNameValue "PropertyEstateType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1774>
    t:messageText "Provide 'Construction Method' (e.g., Site Built, Manufactured, Modular) for each dwelling of the sales comparable." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and ((ImprovementType = \"Dwelling\" and AttachmentType = \"Detached\") or (ImprovementType = \"Dwelling\" and AttachmentType = \"Attached\" and StructuralDesignType = \"RowhouseTownhouse\" or \"SemiDetached\" or \"Other\")), and (at least one instance of CONSTRUCTION_METHOD is not provided or ConstructionMethodType is not provided in a given instance of CONSTRUCTION_METHOD)" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Dwelling(s)" ;
    t:reportLabelValue "Construction Method" ;
    t:dataPointNameValue "ConstructionMethodType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/CONSTRUCTION_METHODS/CONSTRUCTION_METHOD/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1775>
    t:messageText "Provide the 'Manufactured Home Width' (i.e., Single Wide, Multi Wide) for the sales comparable." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and ImprovementType = \"Dwelling\" and ConstructionMethodType = \"Manufactured\" and ManufacturedHomeWidthType is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Dwelling(s)" ;
    t:reportLabelValue "Manufactured Home Width" ;
    t:dataPointNameValue "ManufacturedHomeWidthType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/MANUFACTURED_HOME/MANUFACTURED_HOME_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1776>
    t:messageText "Provide the 'Unfinished Area Below Grade' for the sales comparable, even if the value is 0." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and (ImprovementType = \"Dwelling\" or (ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and AccessoryDwellingUnitIndicator = \"true\")), and UnitBelowGradeUnfinishedAreaMeasure is not provided in a given instance of PROPERTY_UNIT_AREA" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Unit(s)" ;
    t:reportLabelValue "Unfinished Area Below Grade" ;
    t:dataPointNameValue "UnitBelowGradeUnfinishedAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_AREA/" ;
    t:relatedValues "ImprovementType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1777>
    t:messageText "Provide the 'Finished Area Below Grade (Nonstandard)' for the sales comparable, even if the value is 0." ;
    t:ruleLogic "If (@ValuationUseType  = \"SalesComparable\" or @ValuationUseType = \"SubjectProperty\") and (ImprovementType = \"Dwelling\" or  (ImprovementType = \"Outbuilding\" and  OutbuildingRealPropertyIndicator = \"true\" and AccessoryDwellingUnitIndicator = \"true\")) and  ((UnitNonStandardBelowGradeFinishedAreaMeasure > 0 for @ValuationUseType = \"SubjectProperty\") and UnitNonStandardBelowGradeFinishedAreaMeasure is not provided in the comparable instance of PROPERTY_UNIT_AREA that was compared with the subject unit)" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Unit(s)" ;
    t:reportLabelValue "Finished Area Below Grade (Nonstandard)" ;
    t:dataPointNameValue "UnitNonStandardBelowGradeFinishedAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_AREA/" ;
    t:relatedValues "UnitIdentifier (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1778>
    t:messageText "Provide the 'Unfinished Area Above Grade' for the sales comparable, even if the value is 0." ;
    t:ruleLogic "If (@ValuationUseType  = \"SalesComparable\" or @ValuationUseType = \"SubjectProperty\") and (ImprovementType = \"Dwelling\" or  (ImprovementType = \"Outbuilding\" and  OutbuildingRealPropertyIndicator = \"true\" and AccessoryDwellingUnitIndicator = \"true\")) and  ((UnitAboveGradeUnfinishedAreaMeasure > 0 for @ValuationUseType = \"SubjectProperty\") and UnitAboveGradeUnfinishedAreaMeasure is not provided in the comparable instance of PROPERTY_UNIT_AREA that was compared with the subject unit)" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Unit(s)" ;
    t:reportLabelValue "Unfinished Area Above Grade" ;
    t:dataPointNameValue "UnitAboveGradeUnfinishedAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_AREA/" ;
    t:relatedValues "UnitIdentifier (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1779>
    t:messageText "Provide the 'Finished Area Above Grade (Nonstandard)' for the sales comparable, even if the value is 0." ;
    t:ruleLogic "If (@ValuationUseType  = \"SalesComparable\" or @ValuationUseType = \"SubjectProperty\") and (ImprovementType = \"Dwelling\" or  (ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and AccessoryDwellingUnitIndicator = \"true\")) and  ((UnitNonStandardAboveGradeFinishedAreaMeasure > 0 for @ValuationUseType = \"SubjectProperty\") and UnitNonStandardAboveGradeFinishedAreaMeasure is not provided in the comparable instance of PROPERTY_UNIT_AREA that was compared with the subject unit)" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Unit(s)" ;
    t:reportLabelValue "Finished Area Above Grade (Nonstandard)" ;
    t:dataPointNameValue "UnitNonStandardAboveGradeFinishedAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_AREA/" ;
    t:relatedValues "UnitIdentifier (%RV1%)" .
