    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1686>
    t:messageText "Provide at least one defect when the Appraiser identified a defect, damage or deficiency with one or more vehicle storages. In the UAD XML, a minimum of one RELATIONSHIP must be included linking each DEFECT to the CAR_STORAGE that has the defect. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SubjectProperty\" and VehicleStorageDefectsExistIndicator = \"true\", and there is no instance of RELATIONSHIP with @xlink:arcrole = \"urn:fdc:mismo.org:2009:residential/DEFECT_ContainsDefectOf_CAR_STORAGE\" linking DEFECT to CAR_STORAGE" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "@xlink:arcrole" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1687>
    t:messageText "Indicate whether any defects, damages, or deficiencies are observed on the exterior of the dwelling." ;
    t:ruleLogic "If DwellingExteriorDefectsExistIndicator is not provided in a given instance of IMPROVEMENT_DETAIL where ImprovementType = \"Dwelling\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Dwelling Exterior" ;
    t:reportSubsection "Apparent Defects, Damages, Deficiencies" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "DwellingExteriorDefectsExistIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1688>
    t:messageText "Indicate whether the living unit has any defects, damages, or deficiencies." ;
    t:ruleLogic "If (ImprovementType = \"Dwelling\" or (ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and AccessoryDwellingUnitIndicator = \"true\")), and UnitInteriorDefectsExistIndicator is not provided in a given instance of PROPERTY_UNIT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Unit Interior" ;
    t:reportSubsection "Apparent Defects, Damages, Deficiencies" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "UnitInteriorDefectsExistIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1689>
    t:messageText "Provide at least one defect when the Appraiser identified a defect, damage or deficiency with the dwelling exterior. In the UAD XML, a minimum of one RELATIONSHIP must be included linking DEFECT to IMPROVEMENT (ImprovementType = 'Dwelling'). For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic """If @ValuationUseType = "SubjectProperty" and DwellingExteriorDefectsExistIndicator = "true", and there is no instance of RELATIONSHIP with @xlink:arcrole = "urn:fdc:mismo.org:2009:residential/DEFECT_ContainsDefectOf_IMPROVEMENT" that links DEFECT to the given instance of IMPROVEMENT with ImprovementType = 'Dwelling'
""" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "@xlink:arcrole" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1690>
    t:messageText "Provide at least one defect when the Appraiser identified a defect, damage or deficiency with the site. In the UAD XML, a minimum of one RELATIONSHIP must be included linking DEFECT to SITE. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SubjectProperty\" and SiteDefectsExistIndicator = \"true\", and there is no instance of RELATIONSHIP with @xlink:arcrole = \"urn:fdc:mismo.org:2009:residential/DEFECT_ContainsDefectOf_SITE\" linking DEFECT to SITE" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "@xlink:arcrole" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1691>
    t:messageText "Provide at least one defect when the Appraiser identified a defect, damage or deficiency in the interior of the living unit or the ADU. In the UAD XML, a minimum of one RELATIONSHIP must be included linking DEFECT to the PROPERTY_UNIT that has the defect. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SubjectProperty\" and UnitInteriorDefectsExistIndicator = \"true\", and there is no instance of RELATIONSHIP with @xlink:arcrole = \"urn:fdc:mismo.org:2009:residential/DEFECT_ContainsDefectOf_PROPERTY_UNIT\" linking DEFECT to the given instance of PROPERTY_UNIT" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "@xlink:arcrole" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1692>
    t:messageText "Provide at least one defect when the Appraiser identified a defect, damage or deficiency in the outbuilding. In the UAD XML, a minimum of one RELATIONSHIP must be included linking DEFECT to IMPROVEMENT (ImprovementType = 'Outbuilding'). For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SubjectProperty\" and OutbuildingDefectsExistIndicator = \"true\", and there is no instance of RELATIONSHIP with @xlink:arcrole = \"urn:fdc:mismo.org:2009:residential/DEFECT_ContainsDefectOf_IMPROVEMENT\" linking DEFECT to IMPROVEMENT with ImprovementType = 'Outbuilding'" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "@xlink:arcrole" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1693>
    t:messageText "The number of 'Accessory Dwelling Units' plus the number of 'Units Excluding ADUs' must equal the total number of living units across all buildings." ;
    t:ruleLogic """If AccessoryDwellingUnitTotalCount plus
LivingUnitExcludingADUCount does not equal the sum of LivingUnitCount across all instances of STRUCTURE_DETAIL""" ;
    t:propertyAffected "Subject" ;
    t:reportSubsection "{No Subsection}" ;
    t:dataPointNameValue "LivingUnitCount" ;
    t:xpath """../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_DETAIL/

""" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1694>
    t:messageText "Each dwelling must contain at least one living unit that is not an ADU." ;
    t:ruleLogic "For each instance of IMPROVEMENT_DETAIL with ImprovementType = \"Dwelling\", if there is no occurrences of PROPERTY_UNIT_DETAIL with AccessoryDwellingUnitIndicator = \"false\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Unit Interior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "ADU" ;
    t:dataPointNameValue "AccessoryDwellingUnitIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_DETAIL/" ;
    t:minValue "1" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1695>
    t:messageText "Provide 'Effective Age' either as a number of years or as a range of years, but not both." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and ImprovementType = \"Dwelling\" and EffectiveAgeYearsCount is provided, and (either or both of EffectiveAgeRangeLowYearsCount or EffectiveAgeRangeHighYearsCount is provided) in a given instance of STRUCTURE_ANALYSIS_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Cost Approach" ;
    t:reportSubsection "Depreciated Cost - Dwelling" ;
    t:reportLabelValue "Effective Age" ;
    t:dataPointNameValue "EffectiveAgeYearsCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_ANALYSES/STRUCTURE_ANALYSIS/STRUCTURE_ANALYSIS_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1696>
    t:messageText "Provide 'Effective Age' either as a number of years or as a range of years." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and ImprovementType = \"Dwelling\" and EffectiveAgeYearsCount is not provided, and (either EffectiveAgeRangeLowYearsCount or EffectiveAgeRangeHighYearsCount is not provided) in a given instance of STRUCTURE_ANALYSIS_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Cost Approach" ;
    t:reportSubsection "Depreciated Cost - Dwelling" ;
    t:reportLabelValue "Effective Age" ;
    t:dataPointNameValue "EffectiveAgeYearsCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/STRUCTURE_ANALYSES/STRUCTURE_ANALYSIS/STRUCTURE_ANALYSIS_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1698>
    t:messageText "Provide either the amount related to the transfer of ownership of real property (typically the sale price), or the reason why the ownership transfer amount was not available." ;
    t:ruleLogic "If PriorSalesOrTransfersIndicator = \"true\" and ((OwnershipTransferTransactionAmount and OwnershipTransferAmountNotAvailableReasonType are not provided) or (OwnershipTransferTransactionAmount and OwnershipTransferAmountNotAvailableReasonType are provided))" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Prior Sale and Transfer History" ;
    t:reportSubsection "Subject Transfer History" ;
    t:reportLabelValue "Amount" ;
    t:dataPointNameValue "OwnershipTransferTransactionAmount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
    t:relatedValues "OwnershipTransferTransactionType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1699>
    t:messageText "Provide the property 'Seller Name'." ;
    t:ruleLogic "If neither FullName nor LastName is provided for PartyRoleType = \"PropertySeller\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Seller Name" ;
    t:dataPointNameValue "LastName" ;
    t:xpath "../SERVICE/PARTIES/PARTY/INDIVIDUAL/NAME/; ../SERVICE/PARTIES/PARTY/LEGAL_ENTITY/LEGAL_ENTITY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1700>
    t:messageText "Provide the name of the 'Current Owner of Public Record'." ;
    t:ruleLogic "If neither FullName nor LastName is provided for PartyRoleType = \"PropertyOwner\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Current Owner of Public Record" ;
    t:dataPointNameValue "LastName" ;
    t:xpath "../SERVICE/PARTIES/PARTY/INDIVIDUAL/NAME/; ../SERVICE/PARTIES/PARTY/LEGAL_ENTITY/LEGAL_ENTITY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1701>
    t:messageText "Provide 'Borrower Name'." ;
    t:ruleLogic "If neither FullName nor LastName is provided for PartyRoleType = \"Borrower\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Borrower Name" ;
    t:dataPointNameValue "LastName" ;
    t:xpath "../SERVICE/PARTIES/PARTY/INDIVIDUAL/NAME/; ../SERVICE/PARTIES/PARTY/LEGAL_ENTITY/LEGAL_ENTITY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1702>
    t:messageText "Only the most recent sale should be delivered. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"LandComparable\" and there is more than one instance of SALES_HISTORY" ;
    t:propertyAffected "Land Comparable #n" ;
    t:reportLabelValue "Sale Date" ;
    t:dataPointNameValue "SALES_HISTORY" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
    t:maxValue "1" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1703>
    t:messageText "Only the most recent sale should be delivered. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"GrossRentMultiplierComparable\" and there is more than one instance of SALES_HISTORY" ;
    t:propertyAffected "Gross Rent Multiplier Comparable #n" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Gross Rent Multiplier Comparables" ;
    t:reportLabelValue "Sale Date" ;
    t:dataPointNameValue "SALES_HISTORY" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
    t:maxValue "1" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1704>
    t:messageText "Only the most recent sale should be delivered. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"PropertyAnalyzedNotUsed\" and there is more than one instance of SALES_HISTORY" ;
    t:propertyAffected "Property Analyzed Not Used #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Additional Properties Analyzed Not Used" ;
    t:reportLabelValue "Sale Date" ;
    t:dataPointNameValue "SALES_HISTORY" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
    t:maxValue "1" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1705>
    t:messageText "Provide the file name and location of the image within the .zip file (e.g., \\\\Images\\MH1_DwellingFront.png). For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If ImageFileLocationIdentifier is not provided in a given instance of IMAGE" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ImageFileLocationIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/INSPECTIONS/INSPECTION/IMAGES/IMAGE/" ;
    t:relatedValues "ImageCategoryType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1707>
    t:messageText "Provide the format of the image file. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If MIMETypeIdentifier is not provided in a given instance of IMAGE" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "MIMETypeIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/INSPECTIONS/INSPECTION/IMAGES/IMAGE/" ;
    t:relatedValues "ImageCategoryType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1708>
    t:messageText "Provide the format of the image file. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and MIMETypeIdentifier is not provided in a given instance of IMAGE" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "MIMETypeIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/INSPECTIONS/INSPECTION/IMAGES/IMAGE/" ;
    t:relatedValues "ImageCategoryType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1710>
    t:messageText "Indicate whether the defect, damage, or deficiency affects the soundness and / or structural integrity of the improvement." ;
    t:ruleLogic "If DefectItemAffectsSoundnessStructuralIntegrityIndicator is not provided in a given instance of DEFECT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSubsection "Apparent Defects, Damages, Deficiencies" ;
    t:reportLabelValue "Affects Soundness or Structural Integrity" ;
    t:dataPointNameValue "DefectItemAffectsSoundnessStructuralIntegrityIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DEFECT/DEFECTS/DEFECT/DEFECT_DETAIL/" ;
    t:relatedValues "DefectComponentLabelType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1711>
    t:messageText "Provide a description of the defect, damage or deficiency." ;
    t:ruleLogic "If DefectItemDescription is not provided in a given instance of DEFECT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSubsection "Apparent Defects, Damages, Deficiencies" ;
    t:reportLabelValue "Description" ;
    t:dataPointNameValue "DefectItemDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DEFECT/DEFECTS/DEFECT/DEFECT_DETAIL/" ;
    t:relatedValues "DefectComponentLabelType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1712>
    t:messageText "Provide the location of the defect, damage or deficiency." ;
    t:ruleLogic "If DefectItemLocationType is not provided in a given instance of DEFECT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSubsection "Apparent Defects, Damages, Deficiencies" ;
    t:reportLabelValue "Location" ;
    t:dataPointNameValue "DefectItemLocationType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DEFECT/DEFECTS/DEFECT/DEFECT_DETAIL/" ;
    t:relatedValues "DefectComponentLabelType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1713>
    t:messageText "Provide a description when the location of the defect, damage or deficiency = 'Other'." ;
    t:ruleLogic "If DefectItemLocationType = \"Other\" and DefectItemLocationTypeOtherDescription is not provided in a given instance of DEFECT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSubsection "Apparent Defects, Damages, Deficiencies" ;
    t:reportLabelValue "Location" ;
    t:dataPointNameValue "DefectItemLocationTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DEFECT/DEFECTS/DEFECT/DEFECT_DETAIL/" ;
    t:relatedValues "DefectComponentLabelType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1714>
    t:messageText "Provide the recommended action for the identified defect, damage or deficiency." ;
    t:ruleLogic "If DefectItemRecommendedActionType is not provided in a given instance of DEFECT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSubsection "Apparent Defects, Damages, Deficiencies" ;
    t:reportLabelValue "Recommended Action" ;
    t:dataPointNameValue "DefectItemRecommendedActionType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DEFECT/DEFECTS/DEFECT/DEFECT_DETAIL/" ;
    t:relatedValues "DefectComponentLabelType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1715>
    t:messageText "Provide the feature where the defect, damage or deficiency has been observed." ;
    t:ruleLogic "If DefectComponentLabelType is not provided in a given instance of DEFECT_DETAIL that is not associated with AMENTIY or CAR_STORAGE" ;
    t:propertyAffected "Subject" ;
    t:reportSubsection "Apparent Defects, Damages, Deficiencies" ;
    t:reportLabelValue "Feature" ;
    t:dataPointNameValue "DefectComponentLabelType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DEFECT/DEFECTS/DEFECT/DEFECT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1716>
    t:messageText "Provide a description when label of the defect, damage or deficiency = 'Other'." ;
    t:ruleLogic "If DefectComponentLabelType = \"Other\" and DefectComponentLabelTypeOtherDescription is not provided in a given instance of DEFECT_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSubsection "Apparent Defects, Damages, Deficiencies" ;
    t:reportLabelValue "Feature" ;
    t:dataPointNameValue "DefectComponentLabelTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DEFECT/DEFECTS/DEFECT/DEFECT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1717>
    t:messageText "One or more duplicate RELATIONSHIP containers exist. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If the 'xlink:arcrole', 'xlink:from', and 'xlink:to' labels are not unique across all instances of RELATIONSHIP" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "RELATIONSHIP" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1718>
    t:messageText "The 'from' label included in a RELATIONSHIP container is missing from the associated container. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If the associated container does not have the xlink:from label specified in a given instance of RELATIONSHIP" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "Does Not Display" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" ;
    t:relatedValues "xlink:arcrole (%RV1%); xlink:from (%RV2%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1719>
    t:messageText "The 'to' label included in a RELATIONSHIP container is missing from the associated container or data element. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If the associated container or data element does not have the xlink:to label specified in a given instance of RELATIONSHIP" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "Does Not Display" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" ;
    t:relatedValues "xlink:arcrole (%RV1%); xlink:to (%RV2%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1720>
    t:messageText "Provide depreciation amount as summary, represented by 'Total Depreciation' or all three forms of depreciation ('Physical Depreciation', 'Functional Depreciation' and 'External Depreciation'), even if the value is 0." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and DepreciationTotalAmount is not provided, and (DepreciationExternalAmount or DepreciationFunctionalAmount or DepreciationPhysicalAmount are not provided) in a given instance of IMPROVEMENT_COST_AND_DEPRECIATED_VALUE/IMPROVEMENT_DEPRECIATION" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportLabelValue "Total Depreciation" ;
    t:dataPointNameValue "DepreciationTotalAmount" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/IMPROVEMENT_COST_AND_DEPRECIATED_VALUES/IMPROVEMENT_COST_AND_DEPRECIATED_VALUE/IMPROVEMENT_DEPRECIATION/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1721>
    t:messageText "The 'Date of Manufacture' must include year, month and day." ;
    t:ruleLogic "If ManufacturedHomeManufactureDate does not include year, month and day in YYYY-MM-DD format" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Manufactured Home" ;
    t:reportSubsection "HUD Data Plate" ;
    t:reportLabelValue "Date of Manufacture (%PV%)" ;
    t:dataPointNameValue "ManufacturedHomeManufactureDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/MANUFACTURED_HOME/MANUFACTURED_HOME_DETAIL/" ;
    t:dateFormat "CCYY-MM-DD" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1722>
    t:messageText "More than one Appraiser has been identified in the appraisal. There can be only one Appraiser, the other has to be Supervisory Appraiser." ;
    t:ruleLogic "If more than one instance of ROLE_DETAIL has PartyRoleType = \"Appraiser\" across all instances of PARTY" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "Contact Information" ;
    t:reportLabelValue "Appraiser" ;
    t:dataPointNameValue "PartyRoleType" ;
    t:xpath "../SERVICE/PARTIES/PARTY/ROLES/ROLE/ROLE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1723>
    t:messageText "The 'Inspection Date' must include year, month and day." ;
    t:ruleLogic "If InspectionDate does not include year, month and day (YYYY-MM-DD format)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "Contact Information" ;
    t:reportLabelValue "Inspection Date (%PV%)" ;
    t:dataPointNameValue "InspectionDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSES/VALUATION_ANALYSIS/PROPERTIES/PROPERTY/INSPECTIONS/INSPECTION/INSPECTION_DETAIL/" ;
    t:dateFormat "CCYY-MM-DD" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1725>
    t:messageText "The listing 'Start Date' must include year, month and day." ;
    t:ruleLogic "If ListingStartDate does not include year, month and day (YYYY-MM-DD format)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Listing Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Start Date (%PV%)" ;
    t:dataPointNameValue "ListingStartDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSES/VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LISTING_INFORMATIONS/LISTING_INFORMATION/LISTING_INFORMATION_DETAIL/" ;
    t:dateFormat "CCYY-MM-DD" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1726>
    t:messageText "The listing 'End Date' must include year, month and day." ;
    t:ruleLogic "If ListingEndDate does not include year, month and day (YYYY-MM-DD format)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Listing Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "End Date (%PV%)" ;
    t:dataPointNameValue "ListingEndDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSES/VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LISTING_INFORMATIONS/LISTING_INFORMATION/LISTING_INFORMATION_DETAIL/" ;
    t:dateFormat "CCYY-MM-DD" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1727>
    t:messageText "The expiration date for the tax abatements or exemptions must include year and month (YYYY-MM format)." ;
    t:ruleLogic "If TaxAbatementsOrExemptionsExpirationDate does not include year and month (YYYY-MM format)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Project Information" ;
    t:reportSubsection "Project Factors and Impact to Value / Marketability" ;
    t:reportLabelValue "Detail (%PV%)" ;
    t:dataPointNameValue "TaxAbatementsOrExemptionsExpirationDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSES/VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_TAXES/PROPERTY_TAX/PROPERTY_TAX_EXEMPTIONS/PROPERTY_TAX_EXEMPTION/" ;
    t:dateFormat "CCYY-MM" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1728>
    t:messageText "The 'Contract Date' must include year, month and day." ;
    t:ruleLogic "If SalesContractDate does not include year, month and day (YYYY-MM-DD format)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Sales Contract" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Contract Date (%PV%)" ;
    t:dataPointNameValue "SalesContractDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_CONTRACTS/SALES_CONTRACT/SALES_CONTRACT_DETAIL/" ;
    t:dateFormat "CCYY-MM-DD" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1730>
    t:messageText "There is an indicator of a living unit in an outbuilding, and it was not identified as an ADU. Any living unit in an outbuilding is considered an ADU, or it would have to be identified as a dwelling." ;
    t:ruleLogic "If AccessoryDwellingUnitIndicator = \"false\" for a given instance of PROPERTY_UNIT_DETAIL in IMPROVEMENT with ImprovementType = \"Outbuilding\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Unit Interior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "ADU" ;
    t:dataPointNameValue "AccessoryDwellingUnitIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_DETAIL/" ;
    t:relatedValues "OutbuildingType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1731>
    t:messageText "Provide the date the sales contract was fully executed." ;
    t:ruleLogic "IF @ValuationUseType = \"SalesComparable\" AND ContractDateUnknownIndicator = \"false\", and SalesContractDate is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "General Information" ;
    t:reportLabelValue "Contract Date" ;
    t:dataPointNameValue "SalesContractDate" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_CONTRACTS/SALES_CONTRACT/SALES_CONTRACT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1732>
    t:messageText "At least one defect, damage, or deficiency must be provided when the appraisal 'Market Value Condition' is 'Subject to Inspection'." ;
    t:ruleLogic "If PropertyValuationConditionalConclusionType = \"SubjectToInspection\" and there are no instances of DEFECT_DETAIL with DefectItemRecommendedActionType = \"Inspection\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Appraisal Summary" ;
    t:reportLabelValue "Market Value Condition" ;
    t:dataPointNameValue "PropertyValuationConditionalConclusionType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_CONDITIONS/VALUATION_CONDITION/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1733>
    t:messageText "Provide 'Reasonable Exposure Time' as a number of days or as a range of days, but not both." ;
    t:ruleLogic "If MarketingOrExposureDaysCount is provided, and (either or both of MarketingOrExposureLowRangeDaysCount or MarketingOrExposureHighRangeDaysCount is provided)" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Appraisal Summary" ;
    t:reportLabelValue "Reasonable Exposure Time" ;
    t:dataPointNameValue "MarketingOrExposureDaysCount" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_RECONCILIATION_SUMMARY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1734>
    t:messageText "Provide the ownership transfer transaction type (i.e., sale, deed transfer only)." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and PriorSalesOrTransfersIndicator = \"true\", and (at least one instance of SALES_HISTORY is not provided or OwnershipTransferTransactionType is not provided in a given instance of SALES_HISTORY)" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Prior Sale and Transfer History" ;
    t:reportSubsection "Comparable Transfer History" ;
    t:reportLabelValue "Transfer Terms" ;
    t:dataPointNameValue "OwnershipTransferTransactionType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1735>
    t:messageText "Provide the ownership transfer date." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and OwnershipTransferDate is not provided in a given instance of SALES_HISTORY" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach; Prior Sale and Transfer History" ;
    t:reportSubsection "General Information; Comparable Transfer History" ;
    t:reportLabelValue "Sale Date; Date" ;
    t:dataPointNameValue "OwnershipTransferDate" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
    t:relatedValues "OwnershipTransferTransactionType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1736>
    t:messageText "Provide the file name and location of the image within the .zip file (e.g., \\\\Images\\MH1_Garage.png). For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If ImageFileLocationIdentifier is not provided in a given instance of IMAGE" ;
