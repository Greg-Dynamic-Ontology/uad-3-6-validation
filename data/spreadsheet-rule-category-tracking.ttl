    t:dataPointNameValue "PUDIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1481>
    t:messageText "Indicate whether the contract date is known." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and ListingStatusType = \"Pending\" or \"SettledSale\" and ContractDateUnknownIndicator is not provided" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "General Information" ;
    t:reportLabelValue "Contract Date" ;
    t:dataPointNameValue "ContractDateUnknownIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1482>
    t:messageText "Provide the 'Finished Above Grade' Area, even if the value is 0." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and (ImprovementType = \"Dwelling\" or (ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and AccessoryDwellingUnitIndicator = \"true\")), and UnitStandardAboveGradeFinishedAreaMeasure is not provided in a given instance of PROPERTY_UNIT_AREA" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Unit(s)" ;
    t:reportLabelValue "Finished Area Above Grade" ;
    t:dataPointNameValue "UnitStandardAboveGradeFinishedAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_AREA/" ;
    t:relatedValues "ImprovementType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1483>
    t:messageText "Provide the 'Finished Below Grade' Area, even if the value is 0." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and (ImprovementType = \"Dwelling\" or (ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and AccessoryDwellingUnitIndicator = \"true\")), and UnitStandardBelowGradeFinishedAreaMeasure is not provided in a given instance of PROPERTY_UNIT_AREA" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Unit(s)" ;
    t:reportLabelValue "Finished Area Below Grade" ;
    t:dataPointNameValue "UnitStandardBelowGradeFinishedAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_AREA/" ;
    t:relatedValues "ImprovementType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1484>
    t:messageText "Provide the 'Finished Below Grade (Nonstandard)' Area, even if the value is 0." ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" or (ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and AccessoryDwellingUnitIndicator = \"true\"), and UnitNonStandardBelowGradeFinishedAreaMeasure is not provided in a given instance of PROPERTY_UNIT_AREA" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Unit Interior" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Finished Below Grade (Nonstandard)" ;
    t:dataPointNameValue "UnitNonStandardBelowGradeFinishedAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_AREA/" ;
    t:relatedValues "ImprovementType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1485>
    t:messageText "Comparable # must be unique. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "if PropertyOrdinalNumber is not unique across all instances of PROPERTY with @ValuationUseType = \"PropertyAnalyzedNotUsed\"" ;
    t:propertyAffected "Property Analyzed Not Used" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Additional Properties Analyzed Not Used" ;
    t:reportLabelValue "#" ;
    t:dataPointNameValue "PropertyOrdinalNumber" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1486>
    t:messageText "Provide the 'Adjusted Rent' for the rental comparable." ;
    t:ruleLogic "If @ValuationUseType = \"RentalComparable\" and RentalUnitAdjustedRentAmount is not provided in a given instance of RENTAL_COMPARISON_DETAIL" ;
    t:propertyAffected "Rental Comparable #n" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Comparable Rental Analysis" ;
    t:reportLabelValue "Adjusted Rent" ;
    t:dataPointNameValue "RentalUnitAdjustedRentAmount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/RENTAL_INFORMATIONS/RENTAL_INFORMATION/RENTAL_COMPARISON/RENTAL_COMPARISON_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1487>
    t:messageText "Provide the total finished area of the living unit." ;
    t:ruleLogic "If @ValuationUseType = \"RentalComparable\" and UnitTotalFinishedAreaMeasure is not provided in PROPERTY_UNIT_AREA" ;
    t:propertyAffected "Rental Comparable #n" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Comparable Rental Analysis" ;
    t:reportLabelValue "Finished Area" ;
    t:dataPointNameValue "UnitTotalFinishedAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_AREA/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1488>
    t:messageText "Provide the total monthly actual rent for the rental unit(s) on the property." ;
    t:ruleLogic "If (RentScheduleIndicator = \"true\" or IncomeApproachIndicator = \"true\"), and TotalMonthlyActualRentAmount is not provided" ;
    t:propertyAffected "Subject" ;
    t:dataPointNameValue "TotalMonthlyActualRentAmount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/RENTAL_INFORMATION_SUMMARY/RENTAL_INFORMATION_SUMMARY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1489>
    t:messageText "Provide the total monthly market rent for the rental unit(s) on the property." ;
    t:ruleLogic "If (RentScheduleIndicator = \"true\" or IncomeApproachIndicator = \"true\"), and TotalMonthlyMarketRentAmount is not provided" ;
    t:propertyAffected "Subject" ;
    t:dataPointNameValue "TotalMonthlyMarketRentAmount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/RENTAL_INFORMATION_SUMMARY/RENTAL_INFORMATION_SUMMARY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1490>
    t:messageText "Provide the monthly 'Actual Rent' for the living unit, even if the value is 0." ;
    t:ruleLogic "If @ValuationUseType = \"RentalComparable\" and UnitMonthlyActualRentAmount is not provided in UNIT_RENT_SCHEDULE" ;
    t:propertyAffected "Rental Comparable #n" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Comparable Rental Properties; Comparable Rental Analysis" ;
    t:reportLabelValue "Actual Rent" ;
    t:dataPointNameValue "UnitMonthlyActualRentAmount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/UNIT_RENT_SCHEDULE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1491>
    t:messageText "Provide the total finished area of the living unit." ;
    t:ruleLogic "If RentScheduleIndicator = \"true\", and UnitIncludedInRentScheduleIndicator = \"true\", and UnitTotalFinishedAreaMeasure is not provided in a given instance of PROPERTY_UNIT_AREA" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Comparable Rental Analysis" ;
    t:reportLabelValue "Finished Area" ;
    t:dataPointNameValue "UnitTotalFinishedAreaMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_AREA/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1492>
    t:messageText "Provide the 'Proximity to Subject' direction for the rental comparable." ;
    t:ruleLogic "If @ValuationUseType = \"RentalComparable\" and ProximityToSubjectDistanceLinearMeasure > 0, and ComparableToSubjectDirectionType is not provided" ;
    t:propertyAffected "Rental Comparable #n" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Comparable Rental Analysis" ;
    t:reportLabelValue "Proximity to Subject" ;
    t:dataPointNameValue "ComparableToSubjectDirectionType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1493>
    t:messageText "Provide the 'Proximity to Subject' distance for the rental comparable." ;
    t:ruleLogic "If @ValuationUseType = \"RentalComparable\" and ProximityToSubjectDistanceLinearMeasure is not provided" ;
    t:propertyAffected "Rental Comparable #n" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Comparable Rental Analysis" ;
    t:reportLabelValue "Proximity to Subject" ;
    t:dataPointNameValue "ProximityToSubjectDistanceLinearMeasure" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1494>
    t:messageText "A numeric identifier ('Comparable #') must be assigned for each rental comparable. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"RentalComparable\" and PropertyOrdinalNumber is not provided" ;
    t:propertyAffected "Rental Comparable" ;
    t:reportSection """Rental Information
""" ;
    t:reportSubsection "Comparable Rental Properties" ;
    t:reportLabelValue "Comparable #" ;
