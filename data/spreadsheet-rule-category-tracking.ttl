    t:dataPointNameValue "SalesComparisonApproachIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1219>
    t:messageText "Provide the 'Assignment Reason'." ;
    t:ruleLogic "If ValuationAssignmentType is not provided" ;
