@prefix t: <urn:uad36:work-tracking:vocab:> .
@prefix : <urn:uad36:work-tracking:> .
@prefix scenario: <urn:uad36:work-tracking:scenario:> .
@prefix row: <urn:uad36:work-tracking:appendix-h-1-v1.5:row:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Complete inventory tracker; not an executable test-suite definition.
# Update t:status on a row as work progresses. Add t:evidence, t:owner,
# t:note, t:commit, or t:completedOn as evidence becomes available.
# Scenario membership does NOT mean that all member rules are implemented.
# Unique IDs are strings. Some source cells contain multiple IDs; others are blank.
# Row resources use Message ID because source Unique IDs are not unique rule keys.
# Membership uses the prior audit's primary-category classification, reviewed
# against the supplied v1.5 rule logic; it is not a classification supplied by Fannie Mae.
# Source counts describe this workbook snapshot. Progress is computed from row status.
# Release selection is deliberately undecided; inventory membership is not a release commitment.

:tracker a t:Tracker ;
    rdfs:label "Spreadsheet rule category implementation tracker" ;
    t:feature :feature ;
    t:source :appendixH ;
    t:statusBasis :scopeAudit ;
    t:sourceRuleCount 728 ;
    t:featureTaggedRuleCount 731 ;
    t:scenarioCount 13 ;
    t:sourceRulesWithoutUniqueIdCount 32 ;
    t:releaseSelection t:Undecided ;
    t:note "The v1.5 current sheet has 728 data rows plus one header row. The marked-up sheet is not used." ;
    t:reconciliation :sourceReconciliation ;
    t:scenario scenario:other_conditional_scoped,
        scenario:single_equality_conditional,
        scenario:required_structures,
        scenario:unconditional_required,
        scenario:uniqueness_cardinality,
        scenario:numeric_bounds,
        scenario:format_precision_length,
        scenario:existing_context_required,
        scenario:relationship_reference_integrity,
        scenario:value_cross_field_consistency,
        scenario:date_chronology,
        scenario:alternative_mutually_exclusive,
        scenario:aggregate_cross_record_consistency .

:feature a t:Feature ;
    t:path "features/spreadsheet-rule-category-validation.feature" ;
    t:sha256 "23d87cd115aca6991b7c8b28a5e9cc80a8a6eace0b6483904a2a26e8bc044d9f" ;
    rdfs:label "Validate appraisal data against governed rule categories" .

:appendixH a t:Workbook ;
    t:path "specs/FannieMae/appendix-h-1-uad-compliance-rules-urar.xlsx" ;
    t:sheet "UAD Compliance Rules v1.5" ;
    t:version "1.5" ;
    t:sha256 "df94cfb44b7460a619786a2e4f8c68ef472b167926ed0a3377ff6fb43ac283e8" .

:sourceReconciliation a t:Reconciliation ;
    t:previousInventoryPath "data/data-constraints.xlsx" ;
    t:previousRuleCount 731 ;
    t:currentRuleCount 728 ;
    t:absentFromCurrentSourceRuleId "UAD1438", "UAD1443", "UAD1625" ;
    t:note "Feature tags retain the previous totals: other conditional/scoped 229 becomes 228; value/cross-field consistency 19 becomes 17. No feature file was edited." .

:scopeAudit a t:StatusAssessment ;
    t:asOf "2026-09-23"^^xsd:date ;
    t:repositoryCommit "f71d4611a2e7bf3b8747f692d309f23ac4c6fb75" ;
    t:implementationPath "app/services/required_data.py" ;
    t:initialDoneInAgreedScopeCount 53 ;
    t:initialPartialCount 5 ;
    t:initialNotImplementedInCurrentPathCount 670 ;
    t:testExecution t:NotRunInThisAudit ;
    t:note "Initial statuses carry forward the scoped implementation audit, checked against the unchanged rule loader. They are not a fresh acceptance test result or a claim of exhaustive UAD compliance." .

t:DoneInAgreedScope rdfs:label "Done within the agreed required-data scope" .
t:Partial rdfs:label "Implemented in part; additional conditional behavior remains" .
t:NotImplementedInCurrentPath rdfs:label "Not implemented in the current application validation path" .
t:Undecided rdfs:label "First-release selection has not been assigned" .
t:NotRunInThisAudit rdfs:label "Acceptance tests not run for this tracking-file audit" .
t:uniqueId rdfs:comment "One actual source Unique ID, trimmed; multi-ID cells are split at semicolons. No invented IDs." .
t:sourceUniqueIdCell rdfs:comment "Original source Unique ID cell text; an empty string represents a blank cell." .
t:coversRule rdfs:comment "Inventory rule assigned to this scenario's category; does not assert test execution or completion." .
t:status rdfs:comment "Editable per-rule work status; aggregate progress is derived from these values." .

# Query progress without summing repeated category totals.
:tracker t:progressQuery """
PREFIX t: <urn:uad36:work-tracking:vocab:>
SELECT ?scenario ?status (COUNT(DISTINCT ?rule) AS ?ruleCount)
WHERE {
  ?scenario a t:Scenario ; t:coversRule ?rule .
  ?rule t:status ?status .
}
GROUP BY ?scenario ?status
ORDER BY ?scenario ?status
""" .

# Query actual Unique ID sets; rows with blank source IDs remain in t:coversRule.
:tracker t:uniqueIdQuery """
PREFIX t: <urn:uad36:work-tracking:vocab:>
SELECT DISTINCT ?scenario ?uniqueId
WHERE {
  ?scenario a t:Scenario ; t:coversRule ?rule .
  ?rule t:uniqueId ?uniqueId .
}
ORDER BY ?scenario ?uniqueId
""" .


