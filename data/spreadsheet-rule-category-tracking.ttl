    t:dataPointNameValue "ListingStartDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LISTING_INFORMATIONS/LISTING_INFORMATION/LISTING_INFORMATION_DETAIL/" ;
    t:relatedValues "ListingEndDate (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1207>
    t:messageText "Provide the 'Listing Status'." ;
    t:ruleLogic "If ListedWithinPreviousYearIndicator = \"true\" and ( at least one instance of LISTING_INFORMATION_DETAIL is not provided or ListingStatusType is not provided in a given instance of LISTING_INFORMATION_DETAIL)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Listing Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Listing Status" ;
    t:dataPointNameValue "ListingStatusType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LISTING_INFORMATIONS/LISTING_INFORMATION/LISTING_INFORMATION_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1208>
    t:messageText "Provide a description when 'Listing Type' = 'Other'." ;
    t:ruleLogic "If ListingType = \"Other\" and ListingTypeOtherDescription is not provided in a given instance of LISTING_INFORMATION_DETAIL" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Subject Listing Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Listing Type" ;
    t:dataPointNameValue "ListingTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/LISTING_INFORMATIONS/LISTING_INFORMATION/LISTING_INFORMATION_DETAIL/" ;
    t:relatedValues "ListingStatusType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1209>
    t:messageText "Provide at least one data source when the subject property is not listed within the previous year. In the UAD XML, a minimum of one RELATIONSHIP must be included that links DATA_SOURCE to LISTING_INFORMATION_SUMMARY. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SubjectProperty\" and ListedWithinPreviousYearIndicator = \"false\", and there is no instance of RELATIONSHIP with @xlink:arcrole = \"urn:fdc:mismo.org:2009:residential/DATA_SOURCE_IsDataSourceFor_LISTING_INFORMATION_SUMMARY\" that links DATA_SOURCE to LISTING_INFORMATION_SUMMARY" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "@xlink:arcrole" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1210>
    t:messageText "Indicate whether the cost approach valuation method has been utilized." ;
    t:ruleLogic "If CostApproachIndicator is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "CostApproachIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1211>
    t:messageText "Indicate whether the appraisal has been prepared for a government agency." ;
    t:ruleLogic "If GovernmentAgencyAppraisalIndicator is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "GovernmentAgencyAppraisalIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1212>
    t:messageText "Provide the federal agency (i.e., VA, USDA, FHA) for which the appraisal has been prepared." ;
    t:ruleLogic "If GovernmentAgencyAppraisalIndicator = \"true\" and GovernmentAgencyAppraisalType is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Government Agency" ;
    t:dataPointNameValue "GovernmentAgencyAppraisalType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1213>
    t:messageText "Indicate whether the income approach valuation method has been utilized." ;
    t:ruleLogic "If IncomeApproachIndicator is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "IncomeApproachIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1214>
    t:messageText "Income approach is included in the appraisal, however no GRM comparables have been provided." ;
    t:ruleLogic "If IncomeApproachIndicator = \"true\" and there are no instances of PROPERTY with @ValuationUseType = \"GrossRentMultiplierComparable\"" ;
    t:propertyAffected "Gross Rent Multiplier Comparable" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "IncomeApproachIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1215>
    t:messageText "When 'Income Approach Developed by Appraiser' is Yes, 'Rent Schedule Developed by Appraiser' must also be Yes." ;
    t:ruleLogic "If IncomeApproachIndicator is \"true\" and RentScheduleIndicator is \"false\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "RentScheduleIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1216>
    t:messageText "Indicate whether the rent schedule was included in the appraisal." ;
    t:ruleLogic "If RentScheduleIndicator is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "RentScheduleIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1217>
    t:messageText "Rent Schedule is included in the appraisal, however, no rental comparables have been provided." ;
    t:ruleLogic "If RentScheduleIndicator = \"true\" and there are no instances of PROPERTY with @ValuationUseType = \"RentalComparable\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "RentScheduleIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1218>
    t:messageText "Indicate whether the sales comparison approach valuation method has been utilized." ;
    t:ruleLogic "If SalesComparisonApproachIndicator is not provided" ;
