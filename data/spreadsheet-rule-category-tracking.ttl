    t:relatedValues "PartyRoleType (Property Data Collector)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1222>
    t:messageText "Provide the 'Property Valuation Method'." ;
    t:ruleLogic "If PropertyValuationMethodType is not provided" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Property Valuation Method" ;
    t:dataPointNameValue "PropertyValuationMethodType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_VALUATIONS/PROPERTY_VALUATION/PROPERTY_VALUATION_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1223>
    t:messageText "'ServiceType' = 'Valuation' must be delivered once. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If there is no instance or more than one instance of SERVICE_DETAIL with ServiceType = \"Valuation\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ServiceType" ;
    t:xpath "../SERVICE/SERVICE_DETAIL/" ;
    t:minValue "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    t:maxValue "1"^^<http://www.w3.org/2001/XMLSchema#integer> .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1224>
    t:messageText "'ServiceType' = 'Inspection' must be delivered no more than once. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If there is more than one instance of SERVICE_DETAIL with ServiceType = \"Inspection\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ServiceType" ;
    t:xpath "../SERVICE/SERVICE_DETAIL/" ;
    t:minValue "0" ;
    t:maxValue "1" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1225>
    t:messageText "A numeric identifier ('Comparable #') must be assigned for each land comparable. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"LandComparable\" and PropertyOrdinalNumber is not provided" ;
    t:propertyAffected "Land Comparable" ;
    t:reportLabelValue "#" ;
    t:dataPointNameValue "PropertyOrdinalNumber" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" ;
    t:relatedValues "AddressLineText (%RV1%); ParcelIdentifier (%RV2%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1226>
    t:messageText "Comparable # must be unique. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If PropertyOrdinalNumber is not unique across all instances of PROPERTY with @ValuationUseType = \"LandComparable\"" ;
    t:propertyAffected "Land Comparable" ;
    t:reportLabelValue "#" ;
    t:dataPointNameValue "PropertyOrdinalNumber" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1227>
    t:messageText "The 'Depreciated Cost of Dwellings' must be provided." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and DepreciatedCostDwellingsTotalAmount is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportSubsection "Indicated Value by Cost Approach" ;
    t:reportLabelValue "Depreciated Cost of Dwellings" ;
    t:dataPointNameValue "DepreciatedCostDwellingsTotalAmount" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/COST_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1228>
    t:messageText "The 'Depreciated Cost of Outbuildings' must be provided." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and DepreciatedCostOutbuildingsTotalAmount is not provided when there are one or more instances of IMPROVEMENT_DETAIL with ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportSubsection "Indicated Value by Cost Approach" ;
    t:reportLabelValue "Depreciated Cost of Outbuildings" ;
    t:dataPointNameValue "DepreciatedCostOutbuildingsTotalAmount" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/COST_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1229>
    t:messageText "Provide the 'Opinion of Site Value'." ;
    t:ruleLogic """If CostApproachIndicator = "true", or
(CostApproachIndicator = "false" and SiteValueIndicator = "true") and SiteEstimatedValueAmount is not provided""" ;
    t:propertyAffected "N/A" ;
    t:reportLabelValue "Opinion of Site Value" ;
    t:dataPointNameValue "SiteEstimatedValueAmount" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/COST_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1230>
    t:messageText "Provide the 'As Is Value of Site Improvements'." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and SiteOtherImprovementsAsIsAmount is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportSubsection "Indicated Value by Cost Approach" ;
    t:reportLabelValue "As Is Value of Site Improvements" ;
    t:dataPointNameValue "SiteOtherImprovementsAsIsAmount" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/COST_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1231>
    t:messageText "Provide the 'Primary Site Valuation Method'." ;
    t:ruleLogic """If CostApproachIndicator = "true", or
(CostApproachIndicator = "false" and SiteValueIndicator = "true") and SiteValuationMethodType is not provided""" ;
    t:propertyAffected "N/A" ;
    t:reportLabelValue "Primary Site Valuation Method" ;
    t:dataPointNameValue "SiteValuationMethodType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/COST_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1232>
    t:messageText "Provide a description when 'Primary Site Valuation Method' = 'Other'." ;
    t:ruleLogic "If SiteValuationMethodType = \"Other\" and SiteValuationMethodTypeOtherDescription is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportLabelValue "Primary Site Valuation Method" ;
    t:dataPointNameValue "SiteValuationMethodTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/COST_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1233>
    t:messageText "The 'Total Depreciation' displays as a negative number on the appraisal. However, it must be delivered as a positive number in the UAD XML. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and DepreciationTotalAmount < 0 in a given instance of IMPROVEMENT_COST_AND_DEPRECIATED_VALUE/IMPROVEMENT_DEPRECIATION" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportLabelValue "Total Depreciation (%PV%)" ;
    t:dataPointNameValue "DepreciationTotalAmount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/IMPROVEMENT_COST_AND_DEPRECIATED_VALUES/IMPROVEMENT_COST_AND_DEPRECIATED_VALUE/IMPROVEMENT_DEPRECIATION/" ;
    t:minValue "0" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1234>
    t:messageText "The 'External Depreciation' displays as a negative number on the appraisal. However, it must be delivered as a positive number in the UAD XML. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and DepreciationExternalAmount < 0 in a given instance of IMPROVEMENT_COST_AND_DEPRECIATED_VALUE/IMPROVEMENT_DEPRECIATION" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportLabelValue "External Depreciation (%PV%)" ;
    t:dataPointNameValue "DepreciationExternalAmount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/IMPROVEMENT_COST_AND_DEPRECIATED_VALUES/IMPROVEMENT_COST_AND_DEPRECIATED_VALUE/IMPROVEMENT_DEPRECIATION/" ;
    t:minValue "0" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1235>
    t:messageText "The 'Functional Depreciation' displays as a negative number on the appraisal. However, it must be delivered as a positive number in the UAD XML. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and DepreciationFunctionalAmount < 0 in a given instance of IMPROVEMENT_COST_AND_DEPRECIATED_VALUE/IMPROVEMENT_DEPRECIATION" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportLabelValue "Functional Depreciation (%PV%)" ;
    t:dataPointNameValue "DepreciationFunctionalAmount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/IMPROVEMENT_COST_AND_DEPRECIATED_VALUES/IMPROVEMENT_COST_AND_DEPRECIATED_VALUE/IMPROVEMENT_DEPRECIATION/" ;
    t:minValue "0" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1236>
    t:messageText "The 'Physical Depreciation' displays as a negative number on the appraisal. However, it must be delivered as a positive number in the UAD XML. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and DepreciationPhysicalAmount < 0 in a given instance of IMPROVEMENT_COST_AND_DEPRECIATED_VALUE/IMPROVEMENT_DEPRECIATION" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportLabelValue "Physical Depreciation (%PV%)" ;
    t:dataPointNameValue "DepreciationPhysicalAmount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/IMPROVEMENT_COST_AND_DEPRECIATED_VALUES/IMPROVEMENT_COST_AND_DEPRECIATED_VALUE/IMPROVEMENT_DEPRECIATION/" ;
    t:minValue "0" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1237>
    t:messageText "Provide depreciation amount as summary, represented by 'Total Depreciation' or break out the three forms of depreciation ('Physical Depreciation', 'Functional Depreciation' and 'External Depreciation'), but not both." ;
    t:ruleLogic "If DepreciationTotalAmount is provided, and (any of DepreciationExternalAmount, DepreciationFunctionalAmount, and DepreciationPhysicalAmount are also provided) in a given instance of IMPROVEMENT_COST_AND_DEPRECIATED_VALUE/IMPROVEMENT_DEPRECIATION" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportLabelValue "Total Depreciation (%PV%)" ;
    t:dataPointNameValue "DepreciationTotalAmount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/IMPROVEMENT_COST_AND_DEPRECIATED_VALUES/IMPROVEMENT_COST_AND_DEPRECIATED_VALUE/IMPROVEMENT_DEPRECIATION/" ;
    t:relatedValues "DepreciationExternalAmount (%RV1%); DepreciationFunctionalAmount (%RV2%); DepreciationPhysicalAmount (%RV3%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1238>
    t:messageText "Primary Site Valuation Method' is provided as 'Sales Comparison', however, no land comparables have been provided." ;
    t:ruleLogic "If SiteValuationMethodType = \"SalesComparison\" and there are no instances of PROPERTY with @ValuationUseType = \"LandComparable\"" ;
    t:propertyAffected "N/A" ;
    t:reportLabelValue "Primary Site Valuation Method (%PV%)" ;
    t:dataPointNameValue "SiteValuationMethodType (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/COST_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1239>
    t:messageText "Provide the 'Effective Date' for the Cost Data Source." ;
    t:ruleLogic "If CostApproachIndicator = \"true\", and (DataSourceType = \"BuilderOrDeveloper\" or \"CostService\" or \"CostSurvey\" or \"Other\"), and DataSourceEffectiveDate is not provided in the instance of DATA_SOURCE that is related to cost approach" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportSubsection "General Description" ;
    t:reportLabelValue "Effective Date" ;
    t:dataPointNameValue "DataSourceEffectiveDate" ;
    t:xpath "../VALUATION_ANALYSIS/DATA_SOURCES/DATA_SOURCE/" ;
    t:relatedValues "DataSourceType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1240>
    t:messageText "Provide the cost data provider name (e.g., Craftsman Cost Guide, Marshall and Swift)." ;
    t:ruleLogic "If CostApproachIndicator = \"true\", and DataSourceType = \"CostService\", and DataSourceName is not provided in a given instance of DATA_SOURCE" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportSubsection "General Description" ;
    t:reportLabelValue "Cost Data Source" ;
    t:dataPointNameValue "DataSourceName" ;
    t:xpath "../VALUATION_ANALYSIS/DATA_SOURCES/DATA_SOURCE/" ;
    t:relatedValues "DataSourceType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1241>
    t:messageText "Provide the cost service quality rating (e.g., excellent, very good) determined for the property." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and DataSourceQualityRatingCode is not provided in the instance of DATA_SOURCE with DataSourceType = \"CostService\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportSubsection "General Description" ;
    t:reportLabelValue "Quality Rating" ;
    t:dataPointNameValue "DataSourceQualityRatingCode" ;
    t:xpath "../VALUATION_ANALYSIS/DATA_SOURCES/DATA_SOURCE/" ;
    t:relatedValues "DataSourceType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1242>
    t:messageText "Provide the 'Gross Rent Multiplier'." ;
    t:ruleLogic "If IncomeApproachIndicator = \"true\" and GrossRentMultiplierFactorNumber is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Indicated Value by Income Approach" ;
    t:reportLabelValue "Gross Rent Multiplier" ;
    t:dataPointNameValue "GrossRentMultiplierFactorNumber" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/INCOME_APPROACH/INCOME_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1243>
    t:messageText "Provide the value of the subject property as determined by the Income Approach method of property valuation." ;
    t:ruleLogic "If IncomeApproachIndicator = \"true\" and ValueIndicatedByIncomeApproachAmount is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Indicated Value by Income Approach" ;
    t:reportLabelValue "Indicated Value by Income Approach" ;
    t:dataPointNameValue "ValueIndicatedByIncomeApproachAmount" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/INCOME_APPROACH/INCOME_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1244>
    t:messageText "Provide the 'Comparable Weight' for the GRM comparable." ;
    t:ruleLogic "If @ValuationUseType = \"GrossRentMultiplierComparable\" and ComparableWeightType is not provided" ;
    t:propertyAffected "Gross Rent Multiplier Comparable #n" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Gross Rent Multiplier Comparables" ;
    t:reportLabelValue "Comparable Weight" ;
    t:dataPointNameValue "ComparableWeightType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1245>
    t:messageText "Provide the 'Gross Rent Multiplier'." ;
    t:ruleLogic "If @ValuationUseType = \"GrossRentMultiplierComparable\" and GrossMonthlyRentMultiplierNumber is not provided" ;
    t:propertyAffected "Gross Rent Multiplier Comparable #n" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Gross Rent Multiplier Comparables" ;
    t:reportLabelValue "Gross Rent Multiplier" ;
    t:dataPointNameValue "GrossMonthlyRentMultiplierNumber" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1246>
    t:messageText "A numeric identifier ('Comparable #') must be assigned for each GRM comparable. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"GrossRentMultiplierComparable\" and PropertyOrdinalNumber is not provided" ;
    t:propertyAffected "Gross Rent Multiplier Comparable" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Gross Rent Multiplier Comparables" ;
    t:reportLabelValue "Comparable #" ;
    t:dataPointNameValue "PropertyOrdinalNumber" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" ;
    t:relatedValues "AddressLineText (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1247>
    t:messageText "Comparable # must be unique. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "if PropertyOrdinalNumber is not unique across all instances of PROPERTY with @ValuationUseType = \"GrossRentMultiplierComparable\"" ;
    t:propertyAffected "Gross Rent Multiplier Comparable" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Gross Rent Multiplier Comparables" ;
    t:reportLabelValue "Comparable #" ;
    t:dataPointNameValue "PropertyOrdinalNumber" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1248>
    t:messageText "The total number of living units, excluding any ADUs, must be at least 1." ;
    t:ruleLogic "If @ValuationUseType = \"GrossRentMultiplierComparable\" and LivingUnitExcludingADUCount < 1" ;
    t:propertyAffected "Gross Rent Multiplier Comparable #n" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Gross Rent Multiplier Comparables" ;
    t:reportLabelValue "Units Excluding ADUs (%PV%)" ;
    t:dataPointNameValue "LivingUnitExcludingADUCount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" ;
    t:minValue "1" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1249>
    t:messageText "Provide 'Gross Monthly Rent'." ;
    t:ruleLogic "If @ValuationUseType = \"GrossRentMultiplierComparable\" and TotalMonthlyActualRentAmount is not provided" ;
    t:propertyAffected "Gross Rent Multiplier Comparable #n" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Gross Rent Multiplier Comparables" ;
    t:reportLabelValue "Gross Monthly Rent" ;
    t:dataPointNameValue "TotalMonthlyActualRentAmount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/RENTAL_INFORMATION_SUMMARY/RENTAL_INFORMATION_SUMMARY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1250>
    t:messageText "One or more additional row labels are not identical for one or more properties. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "For each combination of ComparableAdjustmentType = \"GrossRentMultiplierAdditionalNonAdjustableComparisonItem\" and AdditionalComparisonLineItemIdentifier, if there are not matching occurrences of COMPARABLE_ADJUSTMENT across all instances of PROPERTY with @ValuationUseType = \"GrossRentMultiplierComparable\", and the instance of PROPERTY with @ValuationUseType = \"SubjectProperty\". See UAD1455 for an example of this concept." ;
    t:propertyAffected "Gross Rent Multiplier Comparable; Subject" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Gross Rent Multiplier Comparables" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "AdditionalComparisonLineItemIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_ADJUSTMENTS/COMPARABLE_ADJUSTMENT/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1251>
    t:messageText "Provide the 'Sale Price' for the GRM comparable." ;
    t:ruleLogic "If @ValuationUseType = \"GrossRentMultiplierComparable\" and OwnershipTransferTransactionType = \"Sale\" and OwnershipTransferTransactionAmount is not provided" ;
    t:propertyAffected "Gross Rent Multiplier Comparable #n" ;
    t:reportSection "Income Approach" ;
    t:reportSubsection "Gross Rent Multiplier Comparables" ;
    t:reportLabelValue "Sale Price" ;
    t:dataPointNameValue "OwnershipTransferTransactionAmount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1252>
    t:messageText "Provide the value of the subject property as determined by the Cost Approach method of property valuation." ;
    t:ruleLogic "If CostApproachIndicator = \"true\" and ValueIndicatedByCostApproachAmount is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Cost Approach" ;
    t:reportSubsection "Indicated Value by Cost Approach" ;
    t:reportLabelValue "Indicated Value by Cost Approach" ;
    t:dataPointNameValue "ValueIndicatedByCostApproachAmount" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/COST_APPROACH/COST_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1253>
    t:messageText "Provide the value of the subject property as determined by the Sales Comparison Approach method of property valuation." ;
    t:ruleLogic "If SalesComparisonApproachIndicator = \"true\" and ValueIndicatedBySalesComparisonAmount is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Sales Comparison Approach" ;
    t:reportSubsection "Summary" ;
    t:reportLabelValue "Indicated Value" ;
    t:dataPointNameValue "ValueIndicatedBySalesComparisonAmount" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/APPROACH_TO_VALUE/SALES_COMPARISON_APPROACH/SALES_COMPARISON_APPROACH_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1255>
    t:messageText "Provide the type of market value condition." ;
    t:ruleLogic "If at least one instance of VALUATION_CONDITION is not provided or PropertyValuationConditionalConclusionType is not provided in a given instance of VALUATION_CONDITION" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Appraisal Summary" ;
    t:reportLabelValue "Market Value Condition" ;
    t:dataPointNameValue "PropertyValuationConditionalConclusionType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_CONDITIONS/VALUATION_CONDITION/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1256>
    t:messageText "When the appraisal is made 'As Is', no other type of market value condition can be delivered." ;
    t:ruleLogic "If PropertyValuationConditionalConclusionType = \"AsIs\" and there are one or more additional instances of VALUATION_CONDITION" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Appraisal Summary" ;
    t:reportLabelValue "Market Value Condition" ;
    t:dataPointNameValue "PropertyValuationConditionalConclusionType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_CONDITIONS/VALUATION_CONDITION/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1257>
    t:messageText "Provide the 'Effective Date of Appraisal'." ;
    t:ruleLogic "If AppraisalReportEffectiveDate is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Appraisal Summary" ;
    t:reportLabelValue "Effective Date of Appraisal" ;
    t:dataPointNameValue "AppraisalReportEffectiveDate" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_RECONCILIATION_SUMMARY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1258>
    t:messageText "The 'Effective Date of Appraisal' cannot be a future date." ;
    t:ruleLogic "If AppraisalReportEffectiveDate is in the future" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Appraisal Summary" ;
    t:reportLabelValue "Effective Date of Appraisal (%PV%)" ;
    t:dataPointNameValue "AppraisalReportEffectiveDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_RECONCILIATION_SUMMARY_DETAIL/" ;
    t:dateFormat "CCYY-MM-DD" ;
    t:maxValue "\"Current + 1\"" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1259>
    t:messageText "The 'Effective Date of Appraisal' cannot be more than a year old." ;
    t:ruleLogic "If AppraisalReportEffectiveDate is more than 367 days before the current date" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Appraisal Summary" ;
    t:reportLabelValue "Effective Date of Appraisal (%PV%)" ;
    t:dataPointNameValue "AppraisalReportEffectiveDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_RECONCILIATION_SUMMARY_DETAIL/" ;
    t:dateFormat "CCYY-MM-DD" ;
    t:minValue "Current - 367" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1260>
    t:messageText "The 'Effective Date of Appraisal' must include year, month and day." ;
    t:ruleLogic "If AppraisalReportEffectiveDate does not include year, month and day in YYYY-MM-DD format" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Appraisal Summary" ;
    t:reportLabelValue "Effective Date of Appraisal (%PV%)" ;
    t:dataPointNameValue "AppraisalReportEffectiveDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_RECONCILIATION_SUMMARY_DETAIL/" ;
    t:dateFormat "CCYY-MM-DD" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1261>
    t:messageText "Provide MarketingOrExposureTimeType as 'ReasonableExposureTime'. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If MarketingOrExposureTimeType is not provided or is not = 'ReasonableExposureTime' in VALUATION_RECONCILIATION_SUMMARY_DETAIL" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "MarketingOrExposureTimeType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_RECONCILIATION_SUMMARY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1262>
    t:messageText "Provide 'Opinion Of Market Value'." ;
    t:ruleLogic "If OpinionOfValueAmount is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Appraisal Summary" ;
    t:reportLabelValue "Opinion of Market Value" ;
    t:dataPointNameValue "OpinionOfValueAmount" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_RECONCILIATION_SUMMARY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1263>
    t:messageText "'Opinion Of Market Value' must be at least one dollar, and cannot be negative." ;
    t:ruleLogic "If OpinionOfValueAmount < 1" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Appraisal Summary" ;
    t:reportLabelValue "Opinion of Market Value (%PV%)" ;
    t:dataPointNameValue "OpinionOfValueAmount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_RECONCILIATION_SUMMARY_DETAIL/" ;
    t:minValue "1" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1264>
    t:messageText "'Opinion Of Market Value' must be less than a billion dollars." ;
    t:ruleLogic "If OpinionOfValueAmount > 1,000,000,000" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Appraisal Summary" ;
    t:reportLabelValue "Opinion of Market Value (%PV%)" ;
    t:dataPointNameValue "OpinionOfValueAmount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_RECONCILIATION_SUMMARY_DETAIL/" ;
    t:maxValue "1000000000" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1265>
    t:messageText "Indicate whether the client has requested additional value conditions." ;
    t:ruleLogic "If AdditionalClientRequestedConditionsIndicator is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "AdditionalClientRequestedConditionsIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1266>
    t:messageText "Provide commentary for the reconciliation of market value." ;
    t:ruleLogic "If ValuationReconciliationSummaryCommentDescription is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Reconciliation of Market Value" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "ValuationReconciliationSummaryCommentDescription" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1267>
    t:messageText "Provide the 'As Is Overall Condition Rating' for the subject property." ;
    t:ruleLogic "If NewConstructionIndicator = \"false\" and (PropertyValuationConditionalConclusionType = \"SubjectToCompletionPerPlans\" or \"SubjectToRepair\") and PropertyAsIsConditionRatingCode is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Reconciliation" ;
    t:reportSubsection "Apparent Defects, Damages, Deficiencies" ;
    t:reportLabelValue "As Is Overall Condition Rating" ;
    t:dataPointNameValue "PropertyAsIsConditionRatingCode" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_RECONCILIATION/VALUATION_RECONCILIATION_SUMMARY/VALUATION_RECONCILIATION_SUMMARY_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1268>
    t:messageText "The exterior inspection method, interior inspection method, and inspection date must be delivered no more than once for each Appraiser and/or Supervisory Appraiser. In the UAD XML, only one instance of INSPECTION_DETAIL must be included for each Appraiser and/or Supervisory Appraiser. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If PartyRoleType = \"Appraiser\" or \"AppraiserSupervisor\" and (no instance of INSPECTION_DETAIL is provided for each role or more than one instance of INSPECTION_DETAIL is provided for each role)" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "Contact Information" ;
    t:reportLabelValue "Subject Property Inspection" ;
    t:dataPointNameValue "INSPECTION_DETAIL" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/INSPECTIONS/INSPECTION/INSPECTION_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1270>
    t:messageText "Provide the location and file name of the appraisal (e.g., \\\\SF1Appraisal_v1.pdf). For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If ObjectURL is not provided in FOREIGN_OBJECT" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ObjectURL" ;
    t:xpath "MESSAGE/DOCUMENT_SETS/DOCUMENT_SET/DOCUMENTS/DOCUMENT/VIEWS/VIEW/VIEW_FILES/VIEW_FILE/FOREIGN_OBJECT/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1272>
    t:messageText "The MIMETypeIdentifier for the appraisal must be included as 'application/pdf' in the UAD XML. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If MIMETypeIdentifier in FOREIGN_OBJECT is not provided or not provided as \"application/pdf\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "MIMETypeIdentifier" ;
    t:xpath "MESSAGE/DOCUMENT_SETS/DOCUMENT_SET/DOCUMENTS/DOCUMENT/VIEWS/VIEW/VIEW_FILES/VIEW_FILE/FOREIGN_OBJECT/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1273>
    t:messageText "Provide the MISMO Reference Model version. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @MISMOReferenceModelIdentifier is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "@MISMOReferenceModelIdentifier" ;
    t:xpath "MESSAGE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1274>
    t:messageText "The required subject property photos must be included." ;
    t:ruleLogic "If instances of IMAGE with ImageCategoryType = DwellingFront, PropertyAccess, and PropertyPhoto are not provided" ;
    t:propertyAffected "Subject" ;
    t:dataPointNameValue "ImageCategoryType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/INSPECTIONS/INSPECTION/IMAGES/IMAGE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1275>
    t:messageText "Provide a photo of each sales comparable used in the valuation." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and there is no instance of IMAGE with ImageCategoryType = \"PropertyPhoto\"" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ImageCategoryType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/INSPECTIONS/INSPECTION/IMAGES/IMAGE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1276>
    t:messageText "Provide the file name and location of the image within the .zip file (e.g.,\\\\Images\\SF1_Comp2.png). For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and ImageFileLocationIdentifier is not provided in a given instance of IMAGE" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ImageFileLocationIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/INSPECTIONS/INSPECTION/IMAGES/IMAGE/" ;
    t:relatedValues "ImageCategoryType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1278>
    t:messageText "Provide a photo of the water frontage." ;
    t:ruleLogic "If PrivateAccessIndicator = \"true\" for any instance of BODY_OF_WATER where the SiteInfluenceType = \"BodyOfWater\" and there is no instance of IMAGE with ImageCategoryType = \"WaterFrontage\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Site" ;
    t:reportSubsection "Site Exhibits" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "ImageCategoryType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/INSPECTIONS/INSPECTION/IMAGES/IMAGE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1279>
    t:messageText "The mandatory room photos (i.e., kitchen, full-bathroom, half-bathroom) must be included." ;
    t:ruleLogic "If PropertyValuationMethodType <> \"ExteriorAppraisal\" and (NewConstructionIndicator <> \"true\" or PropertyValuationConditionalConclusionType <> \"SubjectToCompletionPerPlans\") and there is no instance of IMAGE in a given instance of ROOM with RoomType = (\"Kitchen\" or \"HalfBathroom\" or \"FullBathroom\")" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "IMAGE" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/ROOMS/ROOM/IMAGES/IMAGE/" ;
    t:relatedValues "RoomType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1280>
    t:messageText "Provide a photo of each GRM comparable used in the valuation." ;
    t:ruleLogic "If @ValuationUseType = \"GrossRentMultiplierComparable\" and there is no instance of IMAGE with ImageCategoryType = \"PropertyPhoto\"" ;
    t:propertyAffected "Gross Rent Multiplier Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ImageCategoryType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/INSPECTIONS/INSPECTION/IMAGES/IMAGE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1281>
    t:messageText "Provide the file name and location of the image within the .zip file (e.g.,\\\\Images\\SF1_Comp2.png). For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"GrossRentMultiplierComparable\" and ImageFileLocationIdentifier is not provided in a given instance of IMAGE" ;
    t:propertyAffected "Gross Rent Multiplier Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ImageFileLocationIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/INSPECTIONS/INSPECTION/IMAGES/IMAGE/" ;
    t:relatedValues "ImageCategoryType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1282>
    t:messageText "Provide the format of the image file. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType=\"GrossRentMultiplierComparable\" and MIMETypeIdentifier is not provided in a given instance of IMAGE" ;
    t:propertyAffected "Gross Rent Multiplier Comparable #n" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "MIMETypeIdentifier" ;
