<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1194>
    t:messageText "Provide a description when 'Transfer Terms' = 'Other'." ;
    t:ruleLogic "If SaleType = \"Other\" and SaleTypeOtherDescription is not provided in a given instance of SALES_HISTORY" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Prior Sale and Transfer History" ;
    t:reportSubsection "Subject Transfer History" ;
