<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1204>
    t:messageText "Provide the total number of days the property has been on the market." ;
    t:ruleLogic "If ListedWithinPreviousYearIndicator = \"true\" and DaysOnMarketCount is not provided in a given instance of LISTING_INFORMATION_DETAIL" ;
