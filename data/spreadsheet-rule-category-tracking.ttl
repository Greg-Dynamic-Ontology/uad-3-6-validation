    t:relatedValues "AssociationChargeType (AssociationSpecialAssessment)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1614>
    t:messageText "Provide at least one data source when the subject property is located in a project or PUD. In the UAD XML, a minimum of one RELATIONSHIP container must be included that links DATA_SOURCE to PROJECT. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SubjectProperty\" and (PropertyInProjectIndicator = \"true\" or PUDIndicator = \"true\"), and there is no instance of RELATIONSHIP with @xlink:arcrole = \"urn:fdc:mismo.org:2009:residential/DATA_SOURCE_IsDataSourceFor_PROJECT\" that links DATA_SOURCE to PROJECT" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "@xlink:arcrole" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" .

