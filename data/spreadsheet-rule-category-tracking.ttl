<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1197>
    t:messageText "The amount related to the transfer of ownership of real property (typically the sale price) must be greater than or equal to $0." ;
    t:ruleLogic "If OwnershipTransferTransactionAmount < 0 in a given instance of SALES_HISTORY" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Prior Sale and Transfer History" ;
    t:reportSubsection "Subject Transfer History" ;
    t:reportLabelValue "Amount (%PV%)" ;
    t:dataPointNameValue "OwnershipTransferTransactionAmount (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
    t:relatedValues "OwnershipTransferTransactionType (%RV1%)" ;
    t:minValue "0" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1198>
    t:messageText "Provide a description when 'Ownership Transfer Amount Not Available Reason Type' = 'Other'." ;
    t:ruleLogic "If OwnershipTransferAmountNotAvailableReasonType = \"Other\" and OwnershipTransferAmountNotAvailableReasonTypeOtherDescription is not provided in a given instance of SALES_HISTORY" ;
