<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1191>
    t:messageText "Indicate whether the subject property has a prior sale or transfer." ;
    t:ruleLogic "If PriorSalesOrTransfersIndicator is not provided" ;
