<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1477>
    t:messageText "Provide at least one data source for each sales comparable. In the UAD XML, a minimum of one RELATIONSHIP container must be included that links DATA_SOURCE to PROPERTY (@ValuationUseType = 'SalesComparable'). For assistance with this message, contact the appraisal software vendor." ;
