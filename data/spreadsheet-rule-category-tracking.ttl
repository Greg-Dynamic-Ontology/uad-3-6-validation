<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1196>
    t:messageText "The prior sale or transfer date for the subject property must include year, month and day." ;
    t:ruleLogic "If OwnershipTransferDate does not include year, month and day (YYYY-MM-DD format) in a given instance of SALES_HISTORY" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Prior Sale and Transfer History" ;
    t:reportSubsection "Subject Transfer History" ;
    t:reportLabelValue "Date (%PV%)" ;
    t:dataPointNameValue "OwnershipTransferDate (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
