    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" ;
    t:relatedValues "AddressLineText (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1495>
    t:messageText "Comparable # must be unique. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "if PropertyOrdinalNumber is not unique across all instances of PROPERTY with @ValuationUseType = \"RentalComparable\"" ;
    t:propertyAffected "Rental Comparable" ;
    t:reportSection """Rental Information
""" ;
    t:reportSubsection "Comparable Rental Properties" ;
    t:reportLabelValue "Comparable #" ;
    t:dataPointNameValue "PropertyOrdinalNumber" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/COMPARABLE/COMPARABLE_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1496>
    t:messageText "Indicate whether the living unit is subject to rent control." ;
    t:ruleLogic "If RentScheduleIndicator = \"true\", and UnitIncludedInRentScheduleIndicator = \"true\", and RentControlStatusType is not provided in a given instance of UNIT_RENT_SCHEDULE" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Rent Schedule; Comparable Rental Analysis" ;
    t:reportLabelValue "Rent Control" ;
    t:dataPointNameValue "RentControlStatusType" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/UNIT_RENT_SCHEDULE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1497>
    t:messageText "Provide the monthly 'Actual Rent' for the living unit." ;
    t:ruleLogic "If RentScheduleIndicator = \"true\", and UnitIncludedInRentScheduleIndicator = \"true\", and UnitMonthlyActualRentAmount is not provided in a given instance of UNIT_RENT_SCHEDULE" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Rent Schedule; Comparable Rental Analysis" ;
    t:reportLabelValue """Monthly Rent
Actual Rent""" ;
    t:dataPointNameValue "UnitMonthlyActualRentAmount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/UNIT_RENT_SCHEDULE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1498>
    t:messageText "Provide the 'Opinion of Market Rent' for the living unit." ;
    t:ruleLogic "If RentScheduleIndicator = \"true\", and UnitIncludedInRentScheduleIndicator = \"true\", and UnitMonthlyMarketRentAmount is not provided in a given instance of UNIT_RENT_SCHEDULE" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Rent Schedule; Comparable Rental Analysis" ;
    t:reportLabelValue "{No Label}; Opinion of Market Rent" ;
    t:dataPointNameValue "UnitMonthlyMarketRentAmount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/UNIT_RENT_SCHEDULE/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1499>
    t:messageText "Provide the number of bedrooms in the living unit, even if the value is 0." ;
    t:ruleLogic "If @ValuationUseType = \"RentalComparable\" and BedroomCount is not provided in PROPERTY_UNIT_DETAIL" ;
    t:propertyAffected "Rental Comparable #n" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Comparable Rental Analysis" ;
    t:reportLabelValue "Bedrooms" ;
    t:dataPointNameValue "BedroomCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_DETAIL/" ;
    t:relatedValues "ImprovementType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1500>
    t:messageText "Provide the number of full bathrooms in the living unit, even if the value is 0." ;
    t:ruleLogic "If @ValuationUseType = \"RentalComparable\" and FullBathroomCount is not provided in PROPERTY_UNIT_DETAIL" ;
    t:propertyAffected "Rental Comparable #n" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Comparable Rental Analysis" ;
    t:reportLabelValue "Full |Half" ;
    t:dataPointNameValue "FullBathroomCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_DETAIL/" ;
    t:relatedValues "ImprovementType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1501>
    t:messageText "Provide the number of half bathrooms in the living unit, even if the value is 0." ;
    t:ruleLogic "If @ValuationUseType = \"RentalComparable\" and HalfBathroomCount is not provided in PROPERTY_UNIT_DETAIL" ;
    t:propertyAffected "Rental Comparable #n" ;
    t:reportSection "Rental Information" ;
    t:reportSubsection "Comparable Rental Analysis" ;
    t:reportLabelValue "Full |Half" ;
    t:dataPointNameValue "HalfBathroomCount" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/PROPERTY_UNITS/PROPERTY_UNIT/PROPERTY_UNIT_DETAIL/" ;
    t:relatedValues "ImprovementType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1502>
    t:messageText """Provide the UAD Delivery Specification version. For assistance with this message, contact the appraisal software vendor.
""" ;
    t:ruleLogic "If ValuationReportContentIdentifier is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ValuationReportContentIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_REPORT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1505>
    t:messageText "The 'Date of Signature and Report' cannot be a future date." ;
    t:ruleLogic "If ExecutionDate is in the future" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Certifications" ;
    t:reportSubsection "Signature" ;
    t:reportLabelValue "Date of Signature and Report (%PV%)" ;
    t:dataPointNameValue "ExecutionDate (%PV%)" ;
    t:xpath "MESSAGE/DOCUMENT_SETS/DOCUMENT_SET/DOCUMENTS/DOCUMENT/SIGNATORIES/SIGNATORY/EXECUTION/EXECUTION_DETAIL/" ;
    t:dateFormat "CCYY-MM-DD" ;
    t:maxValue "Current + 1" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1506>
    t:messageText "The 'Date of Signature and Report' cannot be more than a year old." ;
    t:ruleLogic "If ExecutionDate is more than 367 days before the current date." ;
    t:propertyAffected "N/A" ;
    t:reportSection "Certifications" ;
    t:reportSubsection "Signature" ;
    t:reportLabelValue "Date of Signature and Report (%PV%)" ;
    t:dataPointNameValue "ExecutionDate (%PV%)" ;
    t:xpath "MESSAGE/DOCUMENT_SETS/DOCUMENT_SET/DOCUMENTS/DOCUMENT/SIGNATORIES/SIGNATORY/EXECUTION/EXECUTION_DETAIL/" ;
    t:dateFormat "CCYY-MM-DD" ;
    t:minValue "Current - 367" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1507>
    t:messageText "The 'Date of Signature and Report' must include year, month and day." ;
    t:ruleLogic "If ExecutionDate does not include year, month and day (YYYY-MM-DD format) in a given instance of SIGNATORY" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Certifications" ;
    t:reportSubsection "Signature" ;
    t:reportLabelValue "Date of Signature and Report (%PV%)" ;
    t:dataPointNameValue "ExecutionDate (%PV%)" ;
    t:xpath "MESSAGE/DOCUMENT_SETS/DOCUMENT_SET/DOCUMENTS/DOCUMENT/SIGNATORIES/SIGNATORY/EXECUTION/EXECUTION_DETAIL/" ;
    t:dateFormat "CCYY-MM-DD" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1508>
    t:messageText "Indicate whether the Appraiser has performed any prior services for the subject property." ;
    t:ruleLogic "If AppraiserPriorServicesPerformedIndicator is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Certifications" ;
    t:reportSubsection "Appraiser Certifications" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "AppraiserPriorServicesPerformedIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_REPORT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1509>
    t:messageText "Indicate whether additional certifications have been identified by the Appraiser." ;
    t:ruleLogic "If AppraiserAdditionalCertificationIndicator is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "AppraiserAdditionalCertificationIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_REPORT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1510>
    t:messageText "Indicate whether additional intended users have been identified for the appraisal." ;
    t:ruleLogic "If ValuationAdditionalIntendedUserIndicator is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ValuationAdditionalIntendedUserIndicator" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1511>
    t:messageText "Provide the type of inspection performed by the Appraiser in the valuation certifications (Cert #10) for this assignment." ;
    t:ruleLogic "If ValuationReportInspectionCertificationType is not provided" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Certifications" ;
    t:reportSubsection "Appraiser Certifications" ;
    t:reportLabelValue "{No Label}" ;
    t:dataPointNameValue "ValuationReportInspectionCertificationType" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_REPORT_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1512>
    t:messageText "The Appraiser Certification (#10) does not align with the 'Property Valuation Method'." ;
    t:ruleLogic "If PropertyValuationMethodType = \"TraditionalAppraisal\" and ValuationReportInspectionCertificationType <> \"InteriorAndExterior\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Property Valuation Method (Traditional Appraisal)" ;
    t:dataPointNameValue "PropertyValuationMethodType (TraditionalAppraisal)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_VALUATIONS/PROPERTY_VALUATION/PROPERTY_VALUATION_DETAIL/" ;
    t:relatedValues "ValuationReportInspectionCertificationType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1513>
    t:messageText "The Appraiser Certification (#10) does not align with the 'Property Valuation Method'." ;
    t:ruleLogic "If PropertyValuationMethodType = \"ExteriorAppraisal\" and ValuationReportInspectionCertificationType <> \"Exterior\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Property Valuation Method (Exterior Appraisal)" ;
    t:dataPointNameValue "PropertyValuationMethodType (ExteriorAppraisal)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_VALUATIONS/PROPERTY_VALUATION/PROPERTY_VALUATION_DETAIL/" ;
    t:relatedValues "ValuationReportInspectionCertificationType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1514>
    t:messageText "The Appraiser Certification (#10) does not align with the 'Property Valuation Method'." ;
    t:ruleLogic "If PropertyValuationMethodType = \"DesktopAppraisal\" and ValuationReportInspectionCertificationType <> \"NoPhysicalInspection\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Property Valuation Method (Desktop Appraisal)" ;
    t:dataPointNameValue "PropertyValuationMethodType (DesktopAppraisal)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_VALUATIONS/PROPERTY_VALUATION/PROPERTY_VALUATION_DETAIL/" ;
    t:relatedValues "ValuationReportInspectionCertificationType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1515>
    t:messageText "The Appraiser Certification (#10) does not align with the 'Property Valuation Method'." ;
    t:ruleLogic "If PropertyValuationMethodType = \"HybridAppraisal\" and ValuationReportInspectionCertificationType <> \"NoPhysicalInspection\"" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "{No Subsection}" ;
    t:reportLabelValue "Property Valuation Method (Hybrid Appraisal)" ;
    t:dataPointNameValue "PropertyValuationMethodType (HybridAppraisal)" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_VALUATIONS/PROPERTY_VALUATION/PROPERTY_VALUATION_DETAIL/" ;
    t:relatedValues "ValuationReportInspectionCertificationType (%RV1%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1516>
    t:messageText "The Appraiser Certification (#10) does not align with the appraiser subject property inspection." ;
    t:ruleLogic "If PropertyInteriorInspectionMethodType = \"Physical\" and PropertyExteriorInspectionMethodType = \"Physical\" for PartyRoleType = \"Appraiser\", and ValuationReportInspectionCertificationType <> \"InteriorAndExterior\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Certifications" ;
    t:reportSubsection "Appraiser Certifications" ;
    t:reportLabelValue "{No Label} (%PV%)" ;
    t:dataPointNameValue "ValuationReportInspectionCertificationType (%PV%)" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_REPORT_DETAIL/" ;
    t:relatedValues "PropertyInteriorInspectionMethodType (%RV1%); PropertyExteriorInspectionMethodType (%RV2%)" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1517>
    t:messageText "The Appraiser Certification (#10) does not align with the appraiser subject property inspection." ;
    t:ruleLogic "If (PropertyInteriorInspectionMethodType = \"Virtual\" or \"NoInspection\" and PropertyExteriorInspectionMethodType = \"Virtual\" or \"NoInspection\" for PartyRoleType = \"Appraiser\"), and ValuationReportInspectionCertificationType <> \"NoPhysicalInspection\"" ;
    t:propertyAffected "N/A" ;
