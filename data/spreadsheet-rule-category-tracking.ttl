    t:relatedValues "Interior Feature" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1738>
    t:messageText "Provide the file name and location of the image within the .zip file (e.g., \\\\Images\\MH1_Bedroom1.png). For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If ImageFileLocationIdentifier is not provided in a given instance of IMAGE" ;
    t:propertyAffected "Subject" ;
    t:reportSection "Does Not Display" ;
    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ImageFileLocationIdentifier" ;
