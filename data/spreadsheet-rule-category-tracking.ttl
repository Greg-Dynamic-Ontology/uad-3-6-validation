<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1143>
    t:messageText "Provide at least one instance of 'Kitchen' for each living unit." ;
    t:ruleLogic """If (ImprovementType = "Dwelling" or (ImprovementType = "Outbuilding" and OutbuildingRealPropertyIndicator = "true" and AccessoryDwellingUnitIndicator = "true")), and (at least one instance of ROOM_DETAIL with RoomType = "Kitchen" is not provided)
""" ;
