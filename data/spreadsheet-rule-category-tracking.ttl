<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1206>
    t:messageText "The listing start date cannot be after the listing end date." ;
    t:ruleLogic "If ListingStartDate > ListingEndDate in a given instance of LISTING_INFORMATION_DETAIL" ;
