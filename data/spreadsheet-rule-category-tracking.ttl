    t:ruleLogic "If ImprovementType = \"Dwelling\" or (ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and AccessoryDwellingUnitIndicator = \"true\"), and BedroomCount is not provided in a given instance of PROPERTY_UNIT_DETAIL" ;
