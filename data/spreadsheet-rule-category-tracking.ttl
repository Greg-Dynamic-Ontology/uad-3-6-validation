    t:reportSubsection "Does Not Display" ;
    t:reportLabelValue "Does Not Display" ;
    t:dataPointNameValue "ImageFileLocationIdentifier" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/CAR_STORAGES/CAR_STORAGE/IMAGES/IMAGE/" ;
    t:relatedValues "Vehicle Storage" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1737>
    t:messageText "Provide the file name and location of the image within the .zip file (e.g., \\\\Images\\MH1_Flooring.png). For assistance with this message, contact the appraisal software vendor." ;
