<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1193>
    t:messageText "Provide the 'Transfer Terms'." ;
    t:ruleLogic "If PriorSalesOrTransfersIndicator = \"true\" and OwnershipTransferTransactionType = \"Sale\", and SaleType is not provided in a given instance of SALES_HISTORY" ;
