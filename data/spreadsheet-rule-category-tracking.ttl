    t:dataPointNameValue "ValuationAssignmentTypeOtherDescription" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/SCOPE_OF_WORK/SCOPE_OF_WORK_DETAIL/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1221>
    t:messageText "Provide the date the property inspection was performed." ;
    t:ruleLogic "If PropertyDataReportIndicator = \"true\" and InspectionDate is not provided in SERVICE container with ServiceType = \"Inspection\"" ;
    t:propertyAffected "N/A" ;
    t:reportSection "Assignment Information" ;
    t:reportSubsection "Contact Information" ;
    t:reportLabelValue "Property Data Report - Inspection Date" ;
