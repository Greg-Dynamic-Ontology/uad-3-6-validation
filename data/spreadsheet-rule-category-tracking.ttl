    t:dataPointNameValue "@xlink:arcrole" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" .

<urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1202>
    t:messageText "Provide at least one data source when the subject property has a prior sale or transfer history. In the UAD XML, a minimum of one RELATIONSHIP must be included that links DATA_SOURCE to SALES_HISTORY for each prior sale or transfer. For assistance with this message, contact the appraisal software vendor." ;
    t:ruleLogic "If @ValuationUseType = \"SubjectProperty\" and PriorSalesOrTransfersIndicator = \"true\", and there is no instance of RELATIONSHIP with @xlink:arcrole = \"urn:fdc:mismo.org:2009:residential/DATA_SOURCE_IsDataSourceFor_SALES_HISTORY\" that links DATA_SOURCE to SALES_HISTORY" ;
    t:propertyAffected "Subject" ;
