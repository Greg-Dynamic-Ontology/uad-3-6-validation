# Conditional-required test definitions.
#
# These cases require a conditional-case runner extension.
# The existing required-data runner does not execute them.
#
# Execution contract:
# - Start each case from a fresh copy of baselinePath.
# - Locate exactly one contextPath occurrence.
# - Set the existing trigger element to triggerValue.
# - Remove existing target elements in that context.
# - Apply targetState:
#     Absent     = do not create a target element.
#     Present    = create a target with targetValue.
#     Empty      = create a target with no text.
#     Whitespace = create a target with targetValue.
#     Nil        = create a target with xsi:nil="true", without text.
# - Call the production validator using the modified XML.
# - Count findings for the declared rule ID.
# - For expected findings, verify row ID, severity, and xmlContext.
# - Verify that correction guidance explains the trigger and target.
# - Never inject these expectations as production validation rules.
# - Never modify the baseline file on disk.
#
# Source:
# data/data-constraints.csv, row 0100.0053 / UAD1022.
# Existing test:
# tests/test_it_34_r1_s1_enforce_true_condition.py

suite:conditional-required-UAD1022
    a t:ConditionalTestSuite ;
    rdfs:label "Conditional ownership description requirement" ;
    t:definitionVersion "1" ;
    t:baselinePath "baseline/SF1_Appraisal_v1.4.xml" ;
    t:expectedCaseCount 6 ;
    t:rowId "0100.0053" ;
    t:ruleId "UAD1022" ;
    t:primaryDataElement "PropertyEstateTypeOtherDescription" ;
    t:expectedSeverity "fatal" ;
    t:contextPath "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:PROPERTY_DETAIL" ;
    t:expectedContextCount 1 ;
    t:triggerElement "m:PropertyEstateType" ;
    t:targetElement "m:PropertyEstateTypeOtherDescription" ;
    t:xmlContext "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:PROPERTY_DETAIL/m:PropertyEstateTypeOtherDescription" ;
    t:conditionOperator t:Equals ;
    t:conditionValue "Other" ;
    t:namespaceBinding [
        t:prefix "m" ;
        t:namespaceIRI <http://www.mismo.org/residential/2009/schemas>
    ] ;
    t:namespaceBinding [
        t:prefix "xsi" ;
        t:namespaceIRI <http://www.w3.org/2001/XMLSchema-instance>
    ] .

# IT-34R1S1: true condition, missing dependent element.

case:0100.0053-UAD1022-true-missing
    a t:ConditionalTestCase ;
    t:inSuite suite:conditional-required-UAD1022 ;
    t:scenarioId "IT-34R1S1" ;
    t:triggerValue "Other" ;
    t:expectedConditionResult true ;
    t:targetState t:Absent ;
    t:expectedMatchingFindingCount 1 .

# IT-34R1S1: true condition, supplied dependent value.
# This checks presence, not every possible value-domain constraint.

case:0100.0053-UAD1022-true-present
    a t:ConditionalTestCase ;
    t:inSuite suite:conditional-required-UAD1022 ;
    t:scenarioId "IT-34R1S1" ;
    t:triggerValue "Other" ;
    t:expectedConditionResult true ;
    t:targetState t:Present ;
    t:targetValue "Description of the other ownership interest" ;
    t:expectedMatchingFindingCount 0 .

# IT-34R1S2: false condition, missing dependent element.
# FeeSimple is present in the existing baseline.

case:0100.0053-UAD1022-false-missing
    a t:ConditionalTestCase ;
    t:inSuite suite:conditional-required-UAD1022 ;
    t:scenarioId "IT-34R1S2" ;
    t:triggerValue "FeeSimple" ;
    t:expectedConditionResult false ;
    t:targetState t:Absent ;
    t:expectedMatchingFindingCount 0 .

# IT-34R1S1: an empty element does not satisfy the requirement.

case:0100.0053-UAD1022-true-empty
    a t:ConditionalTestCase ;
    t:inSuite suite:conditional-required-UAD1022 ;
    t:scenarioId "IT-34R1S1" ;
    t:triggerValue "Other" ;
    t:expectedConditionResult true ;
    t:targetState t:Empty ;
    t:expectedMatchingFindingCount 1 .

# IT-34R1S1: whitespace does not satisfy the requirement.

case:0100.0053-UAD1022-true-whitespace
    a t:ConditionalTestCase ;
    t:inSuite suite:conditional-required-UAD1022 ;
    t:scenarioId "IT-34R1S1" ;
    t:triggerValue "Other" ;
    t:expectedConditionResult true ;
    t:targetState t:Whitespace ;
    t:targetValue " \t\n " ;
    t:expectedMatchingFindingCount 1 .

# IT-34R1S1: xsi:nil does not satisfy the requirement.

case:0100.0053-UAD1022-true-nil
    a t:ConditionalTestCase ;
    t:inSuite suite:conditional-required-UAD1022 ;
    t:scenarioId "IT-34R1S1" ;
    t:triggerValue "Other" ;
    t:expectedConditionResult true ;
    t:targetState t:Nil ;
    t:expectedMatchingFindingCount 1 .