@prefix t: <https://dynamicontology.com/uad36/test-vocabulary#> .
@prefix suite: <https://dynamicontology.com/uad36/test-suite/> .
@prefix case: <https://dynamicontology.com/uad36/test-case/required-data/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Required-data test suite
#
# This file describes test inputs and expected outcomes.
# It does not supply production validation rules.
#
# Runner contract:
# - Discover cases through t:inSuite.
# - Resolve fixturePath and baselinePath relative to this file.
# - Use the XML namespace binding below when interpreting XML contexts.
# - Validate through the production ValidationService.
# - Scope finding counts to the rule IDs declared by this suite.
# - Check each case's rule ID, row ID, severity, and exact XML context.
# - Fail on malformed definitions or missing fixtures; do not skip cases.
#
# All case identifiers, filenames, and XML contexts below were taken
# from the existing manifest.csv.
#
# Shared expectations are explicit suite properties, not RDF inference.
# The runner must apply them to every member case.
#
# No claim is made here that the baseline passes all UAD rules or that
# this suite performs XML Schema validation.

suite:required-data-53
    a t:TestSuite ;
    rdfs:label "53 single data point existence tests" ;
    t:definitionVersion "1" ;
    t:sourceManifestPath "manifest.csv" ;
    t:baselinePath "baseline/SF1_Appraisal_v1.4.xml" ;
    t:expectedCaseCount 53 ;
    t:expectedBaselineFindingCount 0 ;
    t:findingScope t:DeclaredRuleIds ;
    t:caseKind t:MissingElement ;
    t:expectedSeverity "fatal" ;
    t:expectedMatchingFindingCount 1 ;
    t:expectedOtherScopedFindingCount 0 ;
    t:namespaceBinding [
        t:prefix "m" ;
        t:namespaceIRI <http://www.mismo.org/residential/2009/schemas>
    ] .

