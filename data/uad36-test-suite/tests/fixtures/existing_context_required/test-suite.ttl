case:UAD1034 a t:TestCase ;
    t:ruleId "UAD1034" ;
    t:sourceUniqueIdCell "" ;
    t:primaryDataElement "@ValuationUseType" ;
    t:ruleLogic "If @ValuationUseType is not provided for one or more instances of PROPERTY" ;
    t:severity "Fatal" ;
    t:propertyAffected "N/A" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/" ;
    t:messageText "Provide 'ValuationUseType' for each property included in the appraisal. For assistance with this message, contact the appraisal software vendor." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1034> ;
    t:baselinePath "examples/xml/SF1_Appraisal_v1.4.xml" ;
    t:contextXPath "//m:PROPERTY" ;
    t:requiredValueXPath "(//m:PROPERTY[@ValuationUseType])[1]/@ValuationUseType" ;
    t:expectedDataLocation "(//m:PROPERTY[@ValuationUseType])[1]/@ValuationUseType" ;
    t:expectedViolationKind "MissingRequiredValueInExistingContext" ;
    t:xsdValidAfterRemoval true .

