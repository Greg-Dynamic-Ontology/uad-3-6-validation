case:UAD1022 a t:TestCase ;
    t:baselinePath "data/uad36-test-suite/tests/fixtures/single_equality/derived/UAD1022.xml" ;
    t:dependentXPath "/m:MESSAGE/m:DOCUMENT_SETS/m:DOCUMENT_SET/m:DOCUMENTS/m:DOCUMENT/m:DEAL_SETS/m:DEAL_SET/m:DEALS/m:DEAL/m:SERVICES/m:SERVICE/m:VALUATION/m:VALUATION_RESPONSE/m:VALUATION_ANALYSES/m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[1]/m:PROPERTY_DETAIL/m:PropertyEstateTypeOtherDescription" ;
    t:expectedDataLocation "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:PROPERTY_DETAIL/m:PropertyEstateTypeOtherDescription" ;
    t:messageText "Provide a description when 'Property Rights Appraised' = 'Other'." ;
    t:nonmatchingValue "FeeSimple" ;
    t:primaryDataElement "PropertyEstateTypeOtherDescription" ;
    t:propertyAffected "Subject" ;
    t:ruleId "UAD1022" ;
    t:ruleLogic "If PropertyEstateType = \"Other\" and PropertyEstateTypeOtherDescription is not provided" ;
    t:severity "Fatal" ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1022> ;
    t:sourceUniqueIdCell "0100.0053" ;
    t:triggerXPath "/m:MESSAGE/m:DOCUMENT_SETS/m:DOCUMENT_SET/m:DOCUMENTS/m:DOCUMENT/m:DEAL_SETS/m:DEAL_SET/m:DEALS/m:DEAL/m:SERVICES/m:SERVICE/m:VALUATION/m:VALUATION_RESPONSE/m:VALUATION_ANALYSES/m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[1]/m:PROPERTY_DETAIL/m:PropertyEstateType" ;
    t:uniqueId "0100.0053" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" .

case:UAD1028 a t:TestCase ;
    t:baselinePath "data/uad36-test-suite/tests/fixtures/required_data/baseline/SF1_Appraisal_v1.4.xml" ;
    t:dependentXPath "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:SALES_CONTRACTS/m:SALES_CONTRACT/m:SALES_CONTRACT_DETAIL/m:AllPropertyRightsAppraisedIndicator" ;
    t:expectedDataLocation "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:SALES_CONTRACTS/m:SALES_CONTRACT/m:SALES_CONTRACT_DETAIL/m:AllPropertyRightsAppraisedIndicator" ;
    t:messageText "Indicate whether all ownership rights of the property are included as part of the valuation." ;
    t:nonmatchingValue "true" ;
    t:primaryDataElement "AllPropertyRightsAppraisedIndicator" ;
    t:propertyAffected "Subject" ;
    t:ruleId "UAD1028" ;
    t:ruleLogic "If LandOwnedInCommonIndicator = \"false\" and AllPropertyRightsAppraisedIndicator is not provided" ;
    t:severity "Fatal" ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1028> ;
    t:sourceUniqueIdCell "0100.0034" ;
    t:triggerXPath "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:SITE/m:SITE_DETAIL/m:LandOwnedInCommonIndicator" ;
    t:uniqueId "0100.0034" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_CONTRACTS/SALES_CONTRACT/SALES_CONTRACT_DETAIL/" .

