@prefix case: <urn:uad36:test-case:IT-1R7S1:> .
@prefix suite: <urn:uad36:test-suite:> .
@prefix t: <urn:uad36:test-suite:vocab:> .

suite:representation-restrictions a t:TestSuite ;
    t:category <urn:uad36:work-tracking:scenario:format_precision_length> ;
    t:hasCase case:UAD1005,
        case:UAD1196,
        case:UAD1260,
        case:UAD1507,
        case:UAD1530,
        case:UAD1721,
        case:UAD1723,
        case:UAD1725,
        case:UAD1726,
        case:UAD1727,
        case:UAD1728,
        case:UAD1741,
        case:UAD1742,
        case:UAD1743,
        case:UAD1744,
        case:UAD1748,
        case:UAD1749,
        case:UAD1755,
        case:UAD1765,
        case:UAD1766,
        case:UAD1767,
        case:UAD1768 ;
    t:ruleInventoryPath "data/data-constraints.csv" ;
    t:scenarioId "IT-1R7S1" .

case:UAD1005 a t:TestCase ;
    t:ruleId "UAD1005" ;
    t:sourceUniqueIdCell "0100.0011" ;
    t:primaryDataElement "PostalCode" ;
    t:ruleLogic "If PostalCode is not in the required format (5 digits, or 5 digits, a hyphen, and 4 digits)" ;
    t:severity "Fatal" ;
    t:propertyAffected "Subject" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/ADDRESS/" ;
    t:messageText "The ZIP code for the subject property physical address must be either 5 digits, or 5 digits, a hyphen, and 4 digits (ZIP+4)." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1005> ;
    t:baselinePath "examples/xml/SF1_Appraisal_v1.4.xml" ;
    t:mutationMode "replace-text" ;
    t:mutationXPath "//m:PROPERTY[@ValuationUseType='SubjectProperty']//m:ADDRESS/m:PostalCode" ;
    t:allowedValue "12345" ;
    t:outsideValue "1234" ;
    t:expectedViolationKind "RepresentationRestrictionViolation" ;
    t:expectedDataLocation "//m:PROPERTY[@ValuationUseType='SubjectProperty']//m:ADDRESS/m:PostalCode" ;
    t:xsdValidAfterMutation true .

case:UAD1196 a t:TestCase ;
    t:ruleId "UAD1196" ;
    t:sourceUniqueIdCell "0800.0011" ;
    t:primaryDataElement "OwnershipTransferDate" ;
    t:ruleLogic "If OwnershipTransferDate does not include year, month and day (YYYY-MM-DD format) in a given instance of SALES_HISTORY" ;
    t:severity "Fatal" ;
    t:propertyAffected "Subject" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
    t:messageText "The prior sale or transfer date for the subject property must include year, month and day." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1196> ;
    t:baselinePath "examples/xml/SF5_Appraisal_v1.2.xml" ;
    t:mutationMode "replace-text" ;
    t:mutationXPath "//m:PROPERTY[@ValuationUseType='SubjectProperty']//m:SALES_HISTORY/m:OwnershipTransferDate" ;
    t:allowedValue "2022-10-30" ;
    t:outsideValue "2022-10" ;
    t:expectedViolationKind "RepresentationRestrictionViolation" ;
    t:expectedDataLocation "//m:PROPERTY[@ValuationUseType='SubjectProperty']//m:SALES_HISTORY/m:OwnershipTransferDate" ;
    t:xsdValidAfterMutation true .

