        case:UAD1633,
        case:UAD1636,
        case:UAD1644,
        case:UAD1646,
        case:UAD1648,
        case:UAD1745 ;
    t:ruleInventoryPath "data/data-constraints.csv" ;
    t:scenarioId "IT-1R6S1" .

case:UAD1014 a t:TestCase ;
    t:ruleId "UAD1014" ;
    t:sourceUniqueIdCell "0100.0021" ;
    t:primaryDataElement "DwellingCount" ;
    t:ruleLogic "If DwellingCount < 1" ;
    t:severity "Fatal" ;
    t:propertyAffected "Subject" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/PROPERTY_DETAIL/" ;
    t:messageText "The total number of dwellings must be at least 1." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1014> ;
    t:baselinePath "examples/xml/SF1_Appraisal_v1.4.xml" ;
    t:mutationMode "replace-text" ;
    t:mutationXPath "//m:PROPERTY[@ValuationUseType='SubjectProperty']//m:PROPERTY_DETAIL/m:DwellingCount" ;
    t:allowedValue "1" ;
    t:outsideValue "0" ;
    t:expectedViolationKind "NumericBoundViolation" ;
    t:expectedDataLocation "//m:PROPERTY[@ValuationUseType='SubjectProperty']//m:PROPERTY_DETAIL/m:DwellingCount" ;
    t:xsdValidAfterMutation true .

