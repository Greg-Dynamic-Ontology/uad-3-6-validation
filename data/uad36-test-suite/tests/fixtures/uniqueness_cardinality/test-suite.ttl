case:UAD1033 a t:TestCase ;
    t:ruleId "UAD1033" ;
    t:sourceUniqueIdCell "0100.0043" ;
    t:primaryDataElement "@ValuationUseType" ;
    t:ruleLogic "If more than one instance of PROPERTY has @ValuationUseType = \"SubjectProperty\"" ;
    t:severity "Fatal" ;
    t:propertyAffected "Subject" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/" ;
    t:messageText "More than one property has been identified as the subject property. For assistance with this message, contact the appraisal software vendor." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1033> ;
    t:uniqueId "0100.0043" ;
    t:baselinePath "examples/xml/2- to 4-unit_Appraisal_v1.4.xml" ;
    t:expectedDataLocation "(//m:PROPERTY[@ValuationUseType='SubjectProperty'])[1]" ;
    t:expectedViolationKind "CardinalityViolation" ;
    t:mutationMode "duplicate-node" ;
    t:mutationXPath "(//m:PROPERTY[@ValuationUseType='SubjectProperty'])[1]" ;
    t:xsdValidAfterMutation true .

