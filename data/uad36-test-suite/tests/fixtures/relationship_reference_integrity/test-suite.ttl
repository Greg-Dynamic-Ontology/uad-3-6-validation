case:UAD1470 a t:TestCase ;
    t:ruleId "UAD1470" ;
    t:sourceUniqueIdCell "1800.0360" ;
    t:primaryDataElement "@xlink:arcrole" ;
    t:ruleLogic "If (@ValuationUseType = \"SubjectProperty\" and (LivingUnitExcludingADUCount > 1 or AccessoryDwellingUnitTotalCount > 0)) and\n(@ValuationUseType = \"SalesComparable\" and (LivingUnitExcludingADUCount > 1 or AccessoryDwellingUnitTotalCount > 0)), and there is not an instance of RELATIONSHIP with @xlink:arcrole = urn:fdc:mismo.org:2009:residential/PROPERTY_UNIT_IsComparableFor_PROPERTY_UNIT" ;
    t:severity "Fatal" ;
    t:propertyAffected "Sales Comparable #n; Subject" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" ;
    t:messageText "When the sales comparable and the subject property have more than one living unit, each comparable unit must be associated to a subject property unit. In the UAD XML, a RELATIONSHIP container must be included that links the instance of PROPERTY_UNIT (@ValuationUseType = 'SalesComparable') to PROPERTY_UNIT (@ValuationUseType = 'SubjectProperty'). For assistance with this message, contact the appraisal software vendor." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1470> ;
    t:baselinePath "examples/xml/2- to 4-unit_Appraisal_v1.4.xml" ;
    t:expectedDataLocation "//m:RELATIONSHIP[@xlink:arcrole='urn:fdc:mismo.org:2009:residential/PROPERTY_UNIT_IsComparableFor_PROPERTY_UNIT' and @xlink:from='PROPERTY_UNIT_COMP1_BLDG1' and @xlink:to='PROPERTY_UNIT_BLDG1']" ;
    t:expectedViolationKind "MissingRequiredRelationship" ;
    t:mutationMode "remove-relationships" ;
    t:relationshipXPath "//m:RELATIONSHIP[@xlink:arcrole='urn:fdc:mismo.org:2009:residential/PROPERTY_UNIT_IsComparableFor_PROPERTY_UNIT' and @xlink:from='PROPERTY_UNIT_COMP1_BLDG1' and @xlink:to='PROPERTY_UNIT_BLDG1']" ;
    t:xsdValidAfterMutation true .

