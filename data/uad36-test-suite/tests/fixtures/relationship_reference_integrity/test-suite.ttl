    t:scenarioId "IT-1R9S1" .

case:UAD1183 a t:TestCase ;
    t:ruleId "UAD1183" ;
    t:sourceUniqueIdCell "0700.0131" ;
    t:primaryDataElement "@xlink:arcrole" ;
    t:ruleLogic "If there is no instance of RELATIONSHIP with @xlink:arcrole = \"urn:fdc:mismo.org:2009:residential/DATA_SOURCE_IsDataSourceFor_PROPERTY_UNIT_AREA\" that links DATA_SOURCE to each PROPERTY_UNIT_AREA where @ValuationUseType = \"SubjectProperty\" \n\n" ;
    t:severity "Fatal" ;
    t:propertyAffected "Subject" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" ;
    t:messageText "Provide at least one data source for each living unit associated with the subject property. In the UAD XML, a minimum of one RELATIONSHIP must be included that links DATA_SOURCE to PROPERTY_UNIT_AREA. For assistance with this message, contact the appraisal software vendor." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1183> ;
    t:baselinePath "examples/xml/SF1_Appraisal_v1.4.xml" ;
    t:expectedDataLocation "//m:RELATIONSHIP[@xlink:arcrole='urn:fdc:mismo.org:2009:residential/DATA_SOURCE_IsDataSourceFor_PROPERTY_UNIT_AREA' and @xlink:to='PROPERTY_UNIT_AREA_SubjectPropertyArea']" ;
    t:expectedViolationKind "MissingRequiredRelationship" ;
    t:mutationMode "remove-relationships" ;
    t:relationshipXPath "//m:RELATIONSHIP[@xlink:arcrole='urn:fdc:mismo.org:2009:residential/DATA_SOURCE_IsDataSourceFor_PROPERTY_UNIT_AREA' and @xlink:to='PROPERTY_UNIT_AREA_SubjectPropertyArea']" ;
    t:xsdValidAfterMutation true .

case:UAD1199 a t:TestCase ;
    t:ruleId "UAD1199" ;
    t:sourceUniqueIdCell "0800.0031" ;
    t:primaryDataElement "@xlink:arcrole" ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and PriorSalesOrTransfersIndicator = \"false\", and there is no instance of RELATIONSHIP with @xlink:arcrole = \"urn:fdc:mismo.org:2009:residential/DATA_SOURCE_IsDataSourceFor_PriorSalesOrTransfersIndicator\" that links DATA_SOURCE to PriorSalesOrTransfersIndicator" ;
    t:severity "Fatal" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:xpath "../SERVICE/RELATIONSHIPS/RELATIONSHIP/" ;
    t:messageText "Provide at least one data source when the sales comparable does not have any prior sales or transfer history. In the UAD XML, a minimum of one RELATIONSHIP must be included that links DATA_SOURCE to PriorSalesOrTransfersIndicator. For assistance with this message, contact the appraisal software vendor." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1199> ;
    t:baselinePath "examples/xml/SF1_Appraisal_v1.4.xml" ;
    t:expectedDataLocation "//m:RELATIONSHIP[@xlink:arcrole='urn:fdc:mismo.org:2009:residential/DATA_SOURCE_IsDataSourceFor_PriorSalesOrTransfersIndicator' and @xlink:to='PriorSalesOrTransfersIndicator_SalesComp2NoPriorSales']" ;
    t:expectedViolationKind "MissingRequiredRelationship" ;
    t:mutationMode "remove-relationships" ;
    t:relationshipXPath "//m:RELATIONSHIP[@xlink:arcrole='urn:fdc:mismo.org:2009:residential/DATA_SOURCE_IsDataSourceFor_PriorSalesOrTransfersIndicator' and @xlink:to='PriorSalesOrTransfersIndicator_SalesComp2NoPriorSales']" ;
    t:xsdValidAfterMutation true .

