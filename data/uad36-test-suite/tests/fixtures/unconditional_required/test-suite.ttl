case:UAD1001 a t:TestCase ;
    t:ruleId "UAD1001" ;
    t:sourceUniqueIdCell "0100.0007" ;
    t:primaryDataElement "AddressLineText" ;
    t:ruleLogic "If AddressLineText is not provided" ;
    t:severity "Fatal" ;
    t:propertyAffected "Subject" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/ADDRESS/" ;
    t:messageText "Provide the address line for the subject property physical address." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1001> ;
    t:baselinePath "examples/xml/2- to 4-unit_Appraisal_v1.4.xml" ;
    t:requiredValueXPath "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:ADDRESS/m:AddressLineText" ;
    t:expectedDataLocation "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:ADDRESS/m:AddressLineText" ;
    t:xsdValidAfterRemoval true .

