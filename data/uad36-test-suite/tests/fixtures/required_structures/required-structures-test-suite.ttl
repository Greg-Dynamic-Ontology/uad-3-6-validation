case:UAD1121 a t:TestCase ;
    t:ruleId "UAD1121" ;
    t:sourceUniqueIdCell "0500.0035" ;
    t:primaryDataElement "ManufacturedHomeModificationType" ;
    t:ruleLogic "If ((ImprovementType = \"Dwelling\" and ConstructionMethodType = \"Manufactured\" and ManufacturedHomeModificationIndicator = \"true\") \nor (ImprovementType = \"Outbuilding\" and OutbuildingType = \"ManufacturedHome\" and OutbuildingRealPropertyIndicator = \"true\" and LivingUnitCount > 0 and ManufacturedHomeModificationIndicator = \"true\")) and (at least one instance of MANUFACTURED_HOME_MODIFICATION is not provided or ManufacturedHomeModificationType is not provided in a given instance of MANUFACTURED_HOME_MODIFICATION)" ;
    t:severity "Fatal" ;
    t:propertyAffected "Subject" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/MANUFACTURED_HOME/MANUFACTURED_HOME_MODIFICATIONS/MANUFACTURED_HOME_MODIFICATION/" ;
    t:messageText "Provide the type of attachment, modification or addition (e.g., deck, porch, garage) made to the manufactured home." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1121> ;
    t:uniqueId "0500.0035" ;
    t:baselinePath "data/uad36-test-suite/tests/fixtures/single_equality/derived/UAD1122.xml" ;
    t:requiredStructureXPath "//m:ManufacturedHomeModificationType" ;
    t:expectedDataLocation "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY/m:IMPROVEMENTS/m:IMPROVEMENT/m:MANUFACTURED_HOME/m:MANUFACTURED_HOME_MODIFICATIONS/m:MANUFACTURED_HOME_MODIFICATION/m:ManufacturedHomeModificationType" ;
    t:xsdValidAfterRemoval true ;
    t:applicabilityXPath "//m:MANUFACTURED_HOME_MODIFICATIONS" .

