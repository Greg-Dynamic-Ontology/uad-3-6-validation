    t:ruleId "UAD1089" ;
    t:sourceUniqueIdCell "0300.0088" ;
    t:primaryDataElement "HeatingSystemType" ;
    t:ruleLogic "If ImprovementType = \"Dwelling\" or (ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\" and LivingUnitCount > 0), and (at least one instance of HEATING_SYSTEM is not provided or HeatingSystemType is not provided in a given instance of HEATING_SYSTEM)" ;
