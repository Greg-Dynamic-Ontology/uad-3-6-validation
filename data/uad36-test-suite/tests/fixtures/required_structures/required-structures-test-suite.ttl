    t:expectedDataLocation "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY/m:SALES_HISTORIES/m:SALES_HISTORY/m:OwnershipTransferTransactionType" ;
    t:xsdValidAfterRemoval true ;
    t:applicabilityXPath "" .

case:UAD1763 a t:TestCase ;
    t:ruleId "UAD1763" ;
    t:sourceUniqueIdCell "2000.0048; 2000.0047" ;
    t:primaryDataElement "ValuationAnalysisCategoryType" ;
    t:ruleLogic "If RentScheduleIndicator = \"true\" and there is no instance of VALUATION_COMMENTARY with ValuationAnalysisCategoryType = \"ComparableRental\" and ValuationCommentText" ;
    t:severity "Fatal" ;
    t:propertyAffected "N/A" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_COMMENTARIES/VALUATION_COMMENTARY/" ;
    t:messageText "Provide 'Rental Analysis Commentary' when rent schedule is included in the appraisal." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1763> ;
    t:uniqueId "2000.0048" ;
    t:uniqueId "2000.0047" ;
    t:baselinePath "examples/xml/2- to 4-unit_Appraisal_v1.4.xml" ;
    t:requiredStructureXPath "//m:VALUATION_COMMENTARY[m:ValuationAnalysisCategoryType='ComparableRental' and m:ValuationCommentText]" ;
    t:expectedDataLocation "//m:VALUATION_ANALYSIS/m:VALUATION_REPORT/m:VALUATION_COMMENTARIES/m:VALUATION_COMMENTARY/m:ValuationAnalysisCategoryType" ;
    t:xsdValidAfterRemoval true ;
    t:applicabilityXPath "//m:RentScheduleIndicator[.='true']" .

case:UAD1764 a t:TestCase ;
