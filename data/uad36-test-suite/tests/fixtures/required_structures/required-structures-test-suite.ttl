case:UAD1030 a t:TestCase ;
    t:ruleId "UAD1030" ;
    t:sourceUniqueIdCell "0100.0036" ;
    t:primaryDataElement "PropertyPartialInterestType" ;
    t:ruleLogic "If AllPropertyRightsAppraisedIndicator = \"false\" and (at least one instance of REAL_PROPERTY_INTEREST is not provided or PropertyPartialInterestType is not provided in a given instance of REAL_PROPERTY_INTEREST)" ;
    t:severity "Fatal" ;
    t:propertyAffected "Subject" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/REAL_PROPERTY_INTERESTS/REAL_PROPERTY_INTEREST/" ;
    t:messageText "Provide 'Rights Not Included'." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1030> ;
    t:uniqueId "0100.0036" ;
    t:baselinePath "examples/xml/2- to 4-unit_Appraisal_v1.4.xml" ;
    t:requiredStructureXPath "//m:PropertyPartialInterestType" ;
    t:expectedDataLocation "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY/m:REAL_PROPERTY_INTERESTS/m:REAL_PROPERTY_INTEREST/m:PropertyPartialInterestType" ;
    t:xsdValidAfterRemoval true ;
    t:applicabilityXPath "//m:AllPropertyRightsAppraisedIndicator[.='false']" .

case:UAD1032 a t:TestCase ;
    t:ruleId "UAD1032" ;
    t:sourceUniqueIdCell "0100.0043" ;
    t:primaryDataElement "@ValuationUseType" ;
    t:ruleLogic "If an instance of PROPERTY is not provided with @ValuationUseType = \"SubjectProperty\"" ;
    t:severity "Fatal" ;
    t:propertyAffected "Subject" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/" ;
    t:messageText "The subject property has not been identified in the UAD XML. For assistance with this message, contact the appraisal software vendor." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1032> ;
    t:uniqueId "0100.0043" ;
    t:baselinePath "examples/xml/2- to 4-unit_Appraisal_v1.4.xml" ;
    t:requiredStructureXPath "//m:PROPERTY[@ValuationUseType='SubjectProperty']" ;
    t:expectedDataLocation "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY/@ValuationUseType" ;
    t:xsdValidAfterRemoval true ;
    t:applicabilityXPath "" .

case:UAD1038 a t:TestCase ;
    t:ruleId "UAD1038" ;
    t:sourceUniqueIdCell "0100.0049" ;
    t:primaryDataElement "ValuationAnalysisCategoryType" ;
    t:ruleLogic "If SpecialTaxAssessmentsIndicator = \"true\", and there is no instance of VALUATION_COMMENTARY with ValuationAnalysisCategoryType = \"PropertySpecialTaxAssessments\"" ;
    t:severity "Warning" ;
    t:propertyAffected "N/A" ;
    t:xpath "../VALUATION_ANALYSIS/VALUATION_REPORT/VALUATION_COMMENTARIES/VALUATION_COMMENTARY/" ;
    t:messageText "Provide ValuationAnalysisCategoryType = 'PropertySpecialTaxAssessments' when there are special tax assessments. For assistance with this message, contact the appraisal software vendor." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1038> ;
    t:uniqueId "0100.0049" ;
    t:baselinePath "examples/xml/MH1_Appraisal_v1.4.xml" ;
    t:requiredStructureXPath "//m:VALUATION_COMMENTARY[m:ValuationAnalysisCategoryType='PropertySpecialTaxAssessments']" ;
    t:expectedDataLocation "//m:VALUATION_ANALYSIS/m:VALUATION_REPORT/m:VALUATION_COMMENTARIES/m:VALUATION_COMMENTARY/m:ValuationAnalysisCategoryType" ;
    t:xsdValidAfterRemoval true ;
    t:applicabilityXPath "//m:SpecialTaxAssessmentsIndicator[.='true']" .

case:UAD1048 a t:TestCase ;
    t:ruleId "UAD1048" ;
    t:sourceUniqueIdCell "0300.0009" ;
    t:primaryDataElement "ImprovementType" ;
    t:ruleLogic "If ImprovementType is not \"Dwelling\" in at least one instance of IMPROVEMENT_DETAIL" ;
    t:severity "Fatal" ;
    t:propertyAffected "Subject" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/IMPROVEMENT_DETAIL/" ;
    t:messageText "At least one structure on the property must be identified as a 'Dwelling'." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1048> ;
    t:uniqueId "0300.0009" ;
    t:baselinePath "examples/xml/2- to 4-unit_Appraisal_v1.4.xml" ;
    t:requiredStructureXPath "//m:ImprovementType" ;
    t:expectedDataLocation "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY/m:IMPROVEMENTS/m:IMPROVEMENT/m:IMPROVEMENT_DETAIL/m:ImprovementType" ;
    t:xsdValidAfterRemoval true ;
    t:applicabilityXPath "" .

case:UAD1058 a t:TestCase ;
    t:ruleId "UAD1058" ;
    t:sourceUniqueIdCell "0300.0028" ;
    t:primaryDataElement "UtilityType" ;
    t:ruleLogic "If ImprovementType = \"Outbuilding\" and OutbuildingRealPropertyIndicator = \"true\", and (at least one instance of OUTBUILDING_UTILITY is not provided or UtilityType is not provided in a given instance of OUTBUILDING_UTILITY)" ;
    t:severity "Warning" ;
    t:propertyAffected "Subject" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/OUTBUILDING/OUTBUILDING_UTILITIES/OUTBUILDING_UTILITY/" ;
    t:messageText "The type of utility(s) that exist in the outbuilding must be included. Select 'None' if there are no utilities." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1058> ;
    t:uniqueId "0300.0028" ;
    t:baselinePath "examples/xml/2- to 4-unit_Appraisal_v1.4.xml" ;
    t:requiredStructureXPath "//m:UtilityType" ;
    t:expectedDataLocation "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY/m:IMPROVEMENTS/m:IMPROVEMENT/m:OUTBUILDING/m:OUTBUILDING_UTILITIES/m:OUTBUILDING_UTILITY/m:UtilityType" ;
    t:xsdValidAfterRemoval true ;
    t:applicabilityXPath "" .

case:UAD1062 a t:TestCase ;
    t:ruleId "UAD1062" ;
    t:sourceUniqueIdCell "0300.0034" ;
    t:primaryDataElement "ConstructionMethodType" ;
    t:ruleLogic "If ((ImprovementType = \"Dwelling\" and AttachmentType = \"Detached\") or (ImprovementType = \"Dwelling\" and AttachmentType = \"Attached\" and StructuralDesignType = \"RowhouseTownhouse\" or \"SemiDetached\" or \"Other\")), and (at least one instance of CONSTRUCTION_METHOD is not provided or ConstructionMethodType is not provided in a given instance of CONSTRUCTION_METHOD)" ;
    t:severity "Fatal" ;
    t:propertyAffected "Subject" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/IMPROVEMENTS/IMPROVEMENT/STRUCTURE/CONSTRUCTION_METHODS/CONSTRUCTION_METHOD/" ;
    t:messageText "Provide 'Construction Method' (e.g., Site Built, Manufactured, Modular) for each dwelling." ;
    t:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1062> ;
    t:uniqueId "0300.0034" ;
    t:baselinePath "examples/xml/2- to 4-unit_Appraisal_v1.4.xml" ;
    t:requiredStructureXPath "//m:ConstructionMethodType" ;
    t:expectedDataLocation "//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY/m:IMPROVEMENTS/m:IMPROVEMENT/m:STRUCTURE/m:CONSTRUCTION_METHODS/m:CONSTRUCTION_METHOD/m:ConstructionMethodType" ;
    t:xsdValidAfterRemoval true ;
    t:applicabilityXPath "" .

