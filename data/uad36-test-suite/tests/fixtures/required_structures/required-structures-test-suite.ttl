    t:ruleLogic "If ImprovementType = \"Dwelling\" and ConstructionMethodType = \"Manufactured\" and SkirtingExistsIndicator = \"true\", and (at least one instance of SKIRTING_MATERIAL is not provided or SkirtingMaterialType is not provided in a given instance of SKIRTING_MATERIAL)" ;
