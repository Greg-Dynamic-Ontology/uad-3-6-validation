    t:xsdValidAfterRemoval false ;
    t:applicabilityXPath "//m:PropertyValuationConditionalConclusionType[.='SubjectToInspection']" .

case:UAD1734 a t:TestCase ;
    t:ruleId "UAD1734" ;
    t:sourceUniqueIdCell "1800.0209" ;
    t:primaryDataElement "OwnershipTransferTransactionType" ;
    t:ruleLogic "If @ValuationUseType = \"SalesComparable\" and PriorSalesOrTransfersIndicator = \"true\", and (at least one instance of SALES_HISTORY is not provided or OwnershipTransferTransactionType is not provided in a given instance of SALES_HISTORY)" ;
    t:severity "Fatal" ;
    t:propertyAffected "Sales Comparable #n" ;
    t:xpath "../VALUATION_ANALYSIS/PROPERTIES/PROPERTY/SALES_HISTORIES/SALES_HISTORY/" ;
    t:messageText "Provide the ownership transfer transaction type (i.e., sale, deed transfer only)." ;
