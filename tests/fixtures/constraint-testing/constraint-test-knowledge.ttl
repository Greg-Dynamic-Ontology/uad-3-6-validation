@prefix tk: <https://dynamicontology.com/uad36/test-knowledge#> .
@prefix rule: <urn:uad36:work-tracking:appendix-h-1-v1.5:row:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Candidate inventory, not executed test results or verified trigger coverage.
# File IRIs are subjects; existing Message-ID rule IRIs are objects.
# All 728 source rows are included, including rows with no candidate links.
tk:TestKnowledgeInventory a rdfs:Class .
tk:XmlSampleFile a rdfs:Class .
tk:GovernedSourceConstraint a rdfs:Class .
tk:CandidateDataEvidence a rdfs:Class .
tk:SingleEqualityConditional a rdfs:Class ; rdfs:label "Single-equality conditional rule (existing project classification)" .
tk:hasCandidateDataForConstraint a rdf:Property ; rdfs:comment "File contains at least one primary element or attribute at the source-governed parent path; Subject property scope is applied where declared. This is not a claim of trigger truth, non-trigger coverage, XML validity, or a passing test." .
tk:file a rdf:Property ; rdfs:comment "XML sample file identified by its absolute file IRI." .
tk:constraint a rdf:Property ; rdfs:comment "Governed source constraint identified by its existing Message-ID rule IRI." .
tk:candidateEvidence a rdf:Property ; rdfs:comment "Evidence supporting a file-to-constraint candidate link." .
tk:selector a rdf:Property ; rdfs:comment "Derived namespace-aware XPath used to locate primary data nodes." .
tk:matchedPrimaryNodeCount a rdf:Property ; rdfs:comment "Number of primary nodes found at the derived selector." .
tk:populatedPrimaryNodeCount a rdf:Property ; rdfs:comment "Number of matched nodes with nonblank textual content." .
tk:candidateFileCount a rdf:Property ; rdfs:comment "Number of source samples with path-matched primary nodes for this constraint." .
tk:candidateConstraintCount a rdf:Property ; rdfs:comment "Number of constraints with path-matched primary nodes in this sample." .
tk:primaryDataElement a rdf:Property ; rdfs:comment "Unmodified Primary Data Element source cell." .
tk:sourceXPath a rdf:Property ; rdfs:comment "Unmodified governed xPath source cell." .
tk:sourceUniqueIdCell a rdf:Property ; rdfs:comment "Unmodified Unique ID source cell retained as text, including blanks or multiple identifiers." .
tk:messageId a rdf:Property ; rdfs:comment "Unique source Message ID; used as the row key." .
tk:sourceRow a rdf:Property ; rdfs:comment "One-based row number in the source worksheet, including its header." .
tk:sourceWorksheet a rdf:Property ; rdfs:comment "Name of the governed source worksheet." .
tk:ruleLogic a rdf:Property ; rdfs:comment "Unmodified governed Rule Logic source cell." .
tk:messageText a rdf:Property ; rdfs:comment "Unmodified governed Message Text source cell." .
tk:severity a rdf:Property ; rdfs:comment "Unmodified governed Severity source cell." .
tk:propertyAffected a rdf:Property ; rdfs:comment "Unmodified governed Property Affected source cell." .
tk:sha256 a rdf:Property ; rdfs:comment "SHA-256 digest of source file bytes." .
tk:inventoryFile a rdf:Property ; rdfs:comment "XML sample included in the inventory." .
tk:inventoryConstraint a rdf:Property ; rdfs:comment "Source constraint included in the inventory, irrespective of candidate availability." .
tk:fixtureCount a rdf:Property ; rdfs:comment "Number of XML samples in the inventory." .
tk:constraintCount a rdf:Property ; rdfs:comment "Number of governed source constraints in the inventory." .
tk:assessmentState a rdf:Property ; rdfs:comment "State of behavioral assessment; candidate matching does not execute validation." .
tk:selectorIssue a rdf:Property ; rdfs:comment "Reason a source row needs a reviewed selector before candidate matching." .
tk:priorSingleEqualityClassification a rdf:Property ; rdfs:comment "Existing project classification membership; not a new semantic classification or test result." .
tk:classificationSource a rdf:Property ; rdfs:comment "Source artifact for an inherited project classification." .
tk:classificationSourceSha256 a rdf:Property ; rdfs:comment "SHA-256 digest of the inherited classification artifact." .
tk:hasCandidateDataForConstraint rdfs:domain tk:XmlSampleFile ; rdfs:range tk:GovernedSourceConstraint .
tk:NotBehaviorallyAssessed a rdfs:Resource ; rdfs:label "Trigger and expected findings have not been assessed" .

