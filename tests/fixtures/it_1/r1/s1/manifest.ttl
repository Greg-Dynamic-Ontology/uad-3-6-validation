    m:count 1 ;
    m:expectedText "false" ;
    m:path ".//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:PROPERTY_DETAIL/m:PropertyInProjectIndicator" .

case:UAD1021-both-missing-check-2 a m:FixtureCheck ;
    m:count 1 ;
    m:expectedText "Condominium" ;
    m:path ".//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:PROJECT/m:PROJECT_DETAIL/m:ProjectLegalStructureType" .

case:UAD1021-both-missing-check-3 a m:FixtureCheck ;
    m:count 0 ;
    m:path ".//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:PROPERTY_DETAIL/m:PropertyEstateType" .

