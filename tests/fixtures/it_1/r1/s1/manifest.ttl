case:UAD1021-both-missing a m:TestCase ;
    m:baseline case:baseline ;
    m:caseId "IT-1R1S1-UAD1021-both-missing" ;
    m:change ".//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:PROJECT/m:PROJECT_DETAIL/m:ProjectLegalStructureType: set to Condominium",
        ".//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:PROPERTY_DETAIL/m:PropertyEstateType: removed",
        ".//m:VALUATION_ANALYSIS/m:PROPERTIES/m:PROPERTY[@ValuationUseType='SubjectProperty']/m:PROPERTY_DETAIL/m:PropertyInProjectIndicator: set to false",
        "Replace stale schema reference with a relative URI." ;
    m:endpointReadiness "not_verified" ;
    m:expectedFinding case:UAD1021-both-missing-finding-1 ;
    m:expectedFindingCount 1 ;
    m:fixtureCheck case:UAD1021-both-missing-check-1,
        case:UAD1021-both-missing-check-2,
        case:UAD1021-both-missing-check-3 ;
    m:fixtureKind "focused_validator_fixture" ;
    m:purpose "both missing" ;
    m:ruleId "UAD1021" ;
    m:sliceId "01" ;
    m:sourceRow 21 ;
    m:sourceRule <urn:uad36:work-tracking:appendix-h-1-v1.5:row:UAD1021> ;
    m:sourceRuleLogic "If (PropertyInProjectIndicator = \"false\" or ProjectLegalStructureType = \"Condominium\"), and PropertyEstateType is not provided" ;
    m:sourceUniqueId "0100.0024" ;
    m:state "applicable_missing" ;
    m:validationSchema case:schema ;
    m:xmlFile "UAD1021/both-missing.xml" ;
    m:xmlSha256 "f62947279388841917473b9fb8c85f8381701ea935c475e8f1e0953c15f06aa5" ;
    m:xsdValid true .

