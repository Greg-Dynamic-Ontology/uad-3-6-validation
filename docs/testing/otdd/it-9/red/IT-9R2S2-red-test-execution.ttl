    otdd:testOutcome "failed" ;
    otdd:testArtifactInstalledInRepository true ;
    otdd:failedTestCount 1 ;
    otdd:passedTestCount 301 ;
    otdd:deselectedTestCount 1 ;
    otdd:durationSeconds "86.87"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    otdd:observedExecution
        <https://dynamicontology.com/uad36/otdd/IT-9R2S2/red/operator-execution> ;
    prov:used
        <https://dynamicontology.com/uad36/feature/govern-schema-source-identities-in-a-knowledge-graph.feature> ,
        <https://dynamicontology.com/uad36/test/test_namespace_correction_operator.py#prepared-IT-9R2S2> ,
