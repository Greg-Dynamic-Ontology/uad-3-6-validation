<https://dynamicontology.com/uad36/otdd/IT-9R2S2/red>
    a otdd:TestExecution , otdd:RedState ;
    dcterms:description
        "The current operator corrected the object occurrence but retained provisional schema-source IRIs in subject and predicate positions." ;
