@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix otdd: <https://dynamicontology.com/owb/otdd#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


otdd:TestExecution
    a rdfs:Class .

otdd:RedState
    a rdfs:Class .

otdd:MissingImplementationFailure
    a rdfs:Class .

otdd:ImplementationArtifact
    a rdfs:Class .

otdd:expectedImplementation
    a rdf:Property .

otdd:failureReason
    a rdf:Property .

otdd:implementationPresent
    a rdf:Property .

otdd:observedFailure
    a rdf:Property .

otdd:outputGraphProduced
    a rdf:Property .

otdd:scenario
    a rdf:Property .

otdd:testOutcome
    a rdf:Property .


<https://dynamicontology.com/uad36/otdd/IT-9R2S1/red>
    a otdd:TestExecution , otdd:RedState ;
    dcterms:description
        "The IT-9R2S1 acceptance test failed because the namespace-correction implementation did not exist." ;
    otdd:scenario "IT-9R2S1" ;
    otdd:testOutcome "failed" ;
    otdd:outputGraphProduced false ;
    otdd:expectedImplementation
        <https://dynamicontology.com/uad36/otdd/IT-9R2S1/artifact/operator.py> ;
    otdd:observedFailure
        <https://dynamicontology.com/uad36/otdd/IT-9R2S1/failure/missing-implementation> ;
    prov:used
        <https://dynamicontology.com/uad36/feature/govern-schema-source-identities-in-a-knowledge-graph.feature> ,
        <https://dynamicontology.com/uad36/test/test_namespace_correction_operator.py> ,
        <https://dynamicontology.com/owb/operator#NamespaceCorrectionContract> ,
        <https://dynamicontology.com/owb/operator#NamespaceCorrectionInputShape> ,
        <https://dynamicontology.com/owb/operator#NamespaceCorrectionOutputShape> .


<https://dynamicontology.com/uad36/otdd/IT-9R2S1/failure/missing-implementation>
    a otdd:MissingImplementationFailure ;
    otdd:failureReason
        "IT-9R2S1 requires the namespace-correction implementation at operators/namespace_correction/operator.py." .


<https://dynamicontology.com/uad36/otdd/IT-9R2S1/artifact/operator.py>
    a otdd:ImplementationArtifact ;
    dcterms:identifier
        "operators/namespace_correction/operator.py" ;
    otdd:implementationPresent false .


<https://dynamicontology.com/uad36/test/test_namespace_correction_operator.py>
    dcterms:identifier
        "tests/test_namespace_correction_operator.py" .


<https://dynamicontology.com/uad36/feature/govern-schema-source-identities-in-a-knowledge-graph.feature>
    dcterms:identifier
        "features/govern-schema-source-identities-in-a-knowledge-graph.feature" .
