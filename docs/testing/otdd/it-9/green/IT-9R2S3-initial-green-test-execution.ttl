@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


otdd:TestExecution
    a rdfs:Class .

otdd:GreenState
    a rdfs:Class .

otdd:activationOption
    a rdf:Property .

otdd:durationSeconds
    a rdf:Property .

otdd:implementationChangedForScenario
    a rdf:Property .

otdd:initialObservedState
    a rdf:Property .

otdd:passedTestCount
    a rdf:Property .

otdd:redExecutionOccurred
    a rdf:Property .

otdd:scenario
    a rdf:Property .

otdd:testOutcome
    a rdf:Property .


<https://dynamicontology.com/uad36/otdd/IT-9R2S3/initial-green>
    a otdd:TestExecution , otdd:GreenState ;
    dcterms:description
        "The complete Milestone 1 Logical Schema graph passed namespace correction on its first executed observation. The preceding deselections were non-executions and are not red test outcomes." ;
    otdd:scenario "IT-9R2S3" ;
    otdd:testOutcome "passed" ;
    otdd:initialObservedState otdd:GreenState ;
    otdd:redExecutionOccurred false ;
    otdd:implementationChangedForScenario false ;
    otdd:activationOption "--run-canonical-artifact" ;
    otdd:passedTestCount 1 ;
    otdd:durationSeconds "22.05"^^xsd:decimal ;
    prov:used
        <https://dynamicontology.com/uad36/feature/govern-schema-source-identities-in-a-knowledge-graph.feature> ,
        <https://dynamicontology.com/uad36/test/test_namespace_correction_complete_graph.py> ,
        <https://dynamicontology.com/uad36/artifact/milestone-1/logical-schema.ttl> ,
        <https://dynamicontology.com/owb/operator#NamespaceCorrectionContract> ;
    prov:generated
        <https://dynamicontology.com/uad36/otdd/IT-9R2S3/reconciliation> .


