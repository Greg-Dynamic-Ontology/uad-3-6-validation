otdd:hasArtifact
    a rdf:Property .

otdd:hashAlgorithm
    a rdf:Property .

otdd:hashScope
    a rdf:Property .

otdd:implementationPresent
    a rdf:Property .

otdd:scenario
    a rdf:Property .

otdd:sha256
    a rdf:Property .

otdd:softwareName
    a rdf:Property .

otdd:softwareVersion
    a rdf:Property .

otdd:testOutcome
    a rdf:Property .


