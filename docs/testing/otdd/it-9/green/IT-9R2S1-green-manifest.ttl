otdd:EvidenceArtifact
    a rdfs:Class .

otdd:ImplementationArtifact
    a rdfs:Class .

otdd:SoftwareEnvironment
    a rdfs:Class .

otdd:baseCommit
    a rdf:Property .

otdd:expectedAndActualHashesEqual
