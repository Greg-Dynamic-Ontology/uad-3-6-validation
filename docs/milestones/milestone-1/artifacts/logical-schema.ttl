    lsm:attributes lsm:resource-54cec11a8b652ced5530affde7fcb63d6203ac9bbcb047d040b8eebf7e2c9d13 ;
    lsm:documentation "A data type of Amount SHOULD identify a number value that is an amount of money and MAY have a CurrencyURI attribute. It SHALL NOT contain any punctuation other than the decimal point or sign values. The decimal point is ALWAYS the US nationalization character (.) in the designated character encoding (UTF-8 assumed when not stated ) It SHOULD be able to contain at least 18 digits. EXAMPLE: An Unpaid Principle Balance Amount of $100,000.12 would be expressed as \"100000.12\"." ;
    lsm:mixed false ;
    lsm:name lsm:resource-c4e684bccdfb77af3922d3616b6371d62e95934a515bc5bd7e56c50dd4d509d6 .

