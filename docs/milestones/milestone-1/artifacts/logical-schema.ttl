    lsm:attributes lsm:resource-d42f8fe1df9a5de0b339906cc7aa7a2b035370d1473e50c562184ef136a85bbd ;
    lsm:base_type lsm:resource-7964317eeef4fe76e0cc3fe44753c0ba9bcf5fd9504796a54cc00fc28f3eb4e2 ;
    lsm:derivation_kind "extension" ;
    lsm:documentation "A data type of Day SHOULD identify a data point that represents numerically a specific day of the month of the Gregorian Calendar. Days MUST be represented in the extended format ---DD DD is a two-digit day of the month, \"01\" through \"31\" Padded zeros must be used. --- is the required prefix for the absent negative, year, and month an optional trailing time zone indicator is permitted using either Z (for Coordinated Universal Time UTC) or an offset from UTC using +hh:mm or -hh:mm as in Datetime EXAMPLE: The Investor Remittance Day of the 9th of every month would be expressed as \"---09\"." ;
    lsm:mixed false ;
    lsm:name lsm:resource-ba655764046230ee4ba6321909623971d70b0b5aa0dc6cfa9fec07edcc637972 ;
    lsm:simple_content true .

