lsm:resource-b4566a2501668846d293a7b61601be314463908c50ebc69f10e93ac8582f1b8f a lsm:AttributeDeclaration ;
    lsm:documentation "Allows producers and consumers of XML instance documents that are valid MISMO V3 documents to mark any data point to be treated as sensitive. MISMO recommends that any use of a data point labeled as \"Sensitive Information\" in the LDD ALWAYS have this attribute set to \"true\"." ;
    lsm:name lsm:resource-80e0d941c1aaaba0364d069ef7aa58884bd31a5f0beacdf3a14668f6f5a5a6e9 ;
    lsm:required false ;
    lsm:type_name lsm:resource-c7c42736990101886c257edcde89517b5cabd445f90eb38fbd078018fbf55223 .

lsm:resource-b4572658545e842a3141ea8a76d1bbccb560f6d557c66608dc7eb8723ba69fa9 a lsm:ComplexTypeDefinition ;
    lsm:attribute_group_refs lsm:resource-1c5f66acd25b9c7a1ce25d822f8c20b1c9d28e1ba0b2a932aff21d99e0b28fb4 ;
    lsm:attributes lsm:resource-896bd31bdaf6cf8b0e972bf4ffe0ae0bd1360600d571acdc4ccf06846cb1097b ;
    lsm:base_type lsm:resource-f63b51577f909bb631cdcc7321f6326a569456bf5cc1fef8d5d26ec5ef9084c4 ;
    lsm:derivation_kind "extension" ;
    lsm:documentation "A data type of Rate SHOULD identify a number value that is in the subset of real numbers expressible by decimal numerals and represents a value that is a ratio. It MAY contain a single decimal point as punctuation. The decimal point is ALWAYS the US nationalization character (.) in the designated character encoding (UTF-8 assumed when not stated.) It SHOULD be able to contain at least 18 digits. EXAMPLE: A Tax Rate of 5 percent for computing annual taxes based on a property's value would be expressed as \".05\"." ;
    lsm:mixed false ;
    lsm:name lsm:resource-801338dd6225cc37fafc5ff5e9cf586213a13d5fc5bbc419b2c727c11c0a4cf4 ;
    lsm:simple_content true .

