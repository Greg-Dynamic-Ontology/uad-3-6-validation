# UAD test control knowledge. Expectations are not actual test outcomes.
# Published controls are expected error-free by operator instruction.
# InspectorFileIdentifier omission and empty value are schema-permitted;
# neither has a rule in the pinned Appendix H-1 inventory.
# Complete validation needs an explicitly reviewed reference date/source release.
# All paths below identify the intended project files, not this review folder.
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tc: <https://dynamicontology.com/uad36/test-control/> .
@prefix tk: <https://dynamicontology.com/uad36/test-knowledge#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tk:ClockPolicy a rdfs:Class ;
    rdfs:comment "Requirement to supply a governed reference date before date-sensitive execution." .

tk:ExecutionState a rdfs:Class ;
    rdfs:comment "Whether validation of a test case has been executed." .

tk:ExpectationBasis a rdfs:Class ;
    rdfs:comment "The evidence or supplied requirement supporting an intended outcome." .

tk:ExpectedOutcome a rdfs:Class ;
    rdfs:comment "Intended validation outcome, distinct from an observed test result." .

tk:GovernedSourceConstraint a rdfs:Class ;
    rdfs:comment "A row in the governed published compliance workbook." .

tk:GovernedWorkbook a rdfs:Class ;
    rdfs:comment "An identified published workbook and its digest." .

tk:MutationKind a rdfs:Class ;
    rdfs:comment "The deliberate difference introduced into a controlled XML test input." .

tk:ReviewState a rdfs:Class ;
    rdfs:comment "An explicit assessment or validation-context review state." .

tk:SchemaArtifact a rdfs:Class ;
    rdfs:comment "A schema document with version, digest, and local dependencies." .

tk:SchemaDataPoint a rdfs:Class ;
    rdfs:comment "An XML Schema element being exercised, whether or not it has a workbook constraint." .

tk:TestCase a rdfs:Class ;
    rdfs:comment "One named input and intended evaluation outcome under the governed validation context." .

tk:TestControlManifest a rdfs:Class ;
    rdfs:comment "Versioned input files, source constraints, intended expectations, and mutation evidence; not an execution report." .

tk:ValidationContext a rdfs:Class ;
    rdfs:comment "The pinned schema and rule-source context and unresolved execution prerequisites." .

tk:XmlSampleFile a rdfs:Class ;
    rdfs:comment "An XML input with byte digest and explicit source provenance." .

