tk:assessmentState a rdf:Property ;
    rdfs:comment "State of candidate/behavioral assessment, distinct from file mutation verification." .

tk:baselineCase a rdf:Property ;
    rdfs:comment "Published unmodified control case for a mutation." .

tk:candidateConstraintCount a rdf:Property ;
    rdfs:comment "Number of constraints with primary nodes matched in a managed file." .

tk:candidateFileCount a rdf:Property ;
    rdfs:comment "Number of managed files linked to this constraint; unmodified external controls are excluded." .

tk:caseCount a rdf:Property ;
    rdfs:comment "Number of explicit expectation cases, including external published controls." .

tk:clockPolicy a rdf:Property ;
    rdfs:comment "Reference-date policy required for date-sensitive constraints." .

tk:constraintCount a rdf:Property ;
    rdfs:comment "Number of distinct governed workbook rows inventoried." .

tk:emptyLexicalValuePermitted a rdf:Property ;
    rdfs:comment "The governing lexical type permits an empty string." .

tk:executionState a rdf:Property ;
    rdfs:comment "Explicit state of validation execution; this manifest does not claim a passing run." .

tk:expectationBasis a rdf:Property ;
    rdfs:comment "Evidence or operator requirement supporting the expected outcome." .

tk:expectedElementCount a rdf:Property ;
    rdfs:comment "Expected number of target elements at the explicit selector." .

tk:expectedFindingCount a rdf:Property ;
    rdfs:comment "Expected number of governed business-rule findings; a test assertion, not an execution count." .

tk:expectedOutcome a rdf:Property ;
    rdfs:comment "Intended outcome; never an observed result." .

tk:expectedPopulatedElementCount a rdf:Property ;
    rdfs:comment "Expected number of nonblank target element values." .

tk:expectedTargetSchemaFindingCount a rdf:Property ;
    rdfs:comment "Expected schema violation count attributable to the target data-point change only." .

tk:fixtureCount a rdf:Property ;
    rdfs:comment "Number of managed XML files physically under test-files." .

tk:governedWorkbook a rdf:Property ;
    rdfs:comment "Workbook whose full constraint inventory is retained here." .

tk:hasCandidateDataForConstraint a rdf:Property ;
    rdfs:comment "Input contains primary data at a previously reviewed source selector; not proof of trigger truth or expected failure." .

tk:inputFile a rdf:Property ;
    rdfs:comment "XML input file for one test case." .

tk:inventoryConstraint a rdf:Property ;
    rdfs:comment "Governed constraint registered in the full source inventory, including those with no candidate file." .

tk:inventoryFile a rdf:Property ;
    rdfs:comment "A file physically held under the managed test-files root." .

tk:managedRoot a rdf:Property ;
    rdfs:comment "Root directory containing the controlled test files." .

tk:manifestCase a rdf:Property ;
    rdfs:comment "Test case included in this manifest." .

tk:matchingWorkbookRuleCount a rdf:Property ;
    rdfs:comment "Number of authoritative workbook rows mentioning the target element name." .

tk:messageId a rdf:Property ;
    rdfs:comment "Workbook Message ID, preserved as text." .

tk:messageText a rdf:Property ;
    rdfs:comment "Unmodified governed Message Text cell." .

tk:minOccurs a rdf:Property ;
    rdfs:comment "Minimum occurrences read from the governing schema element declaration." .

tk:mutation a rdf:Property ;
    rdfs:comment "Kind of controlled data change, with source schema localization recorded separately." .

tk:mutationVerified a rdf:Property ;
    rdfs:comment "Structural comparison verified the described change, excluding comments, whitespace and separately recorded schemaLocation localization." .

tk:nillable a rdf:Property ;
    rdfs:comment "Whether the governing schema element permits xsi:nil." .

tk:originalValue a rdf:Property ;
    rdfs:comment "Original published data value before a deliberate mutation." .

tk:primaryDataElement a rdf:Property ;
    rdfs:comment "Unmodified workbook Primary Data Element cell." .

tk:propertyAffected a rdf:Property ;
    rdfs:comment "Unmodified governed Property Affected cell." .

tk:referenceInventory a rdf:Property ;
    rdfs:comment "Prior candidate-inventory artifact used to preserve rule identities and selectors." .

tk:referenceInventorySha256 a rdf:Property ;
    rdfs:comment "Digest of the prior candidate inventory." .

tk:relativePath a rdf:Property ;
    rdfs:comment "Path to an input or dependency relative to the project root, with forward slashes." .

tk:reviewState a rdf:Property ;
    rdfs:comment "Outstanding review required before treating outcomes as comparable execution results." .

tk:ruleLogic a rdf:Property ;
    rdfs:comment "Unmodified governed Rule Logic cell." .

tk:schema a rdf:Property ;
    rdfs:comment "Pinned local GSE schema artifact used for intended execution." .

tk:schemaDependency a rdf:Property ;
    rdfs:comment "Local imported schema required beside the main XSD." .

tk:schemaLocationLocalized a rdf:Property ;
    rdfs:comment "The XML schema hint was changed independently of the intended data mutation." .

tk:schemaTypeName a rdf:Property ;
    rdfs:comment "Schema type name declared for the target element." .

tk:schemaVersion a rdf:Property ;
    rdfs:comment "Version text read directly from the schema documentation." .

tk:selector a rdf:Property ;
    rdfs:comment "Namespace-aware XPath with prefix m bound to the MISMO namespace." .

tk:selectorIssue a rdf:Property ;
    rdfs:comment "Prior inventory's recorded reason a selector requires review." .

tk:severity a rdf:Property ;
    rdfs:comment "Unmodified governed Severity cell." .

tk:sha256 a rdf:Property ;
    rdfs:comment "SHA-256 digest of exact file bytes." .

tk:sourceByteIdentical a rdf:Property ;
    rdfs:comment "The managed file bytes match its published source copy exactly." .

tk:sourceDataEquivalent a rdf:Property ;
    rdfs:comment "Tags, attributes other than schemaLocation, and nonblank text match the published source." .

tk:sourceRelativePath a rdf:Property ;
    rdfs:comment "Path to source XML relative to the project root, with forward slashes." .

tk:sourceRow a rdf:Property ;
    rdfs:comment "One-based worksheet row including its header." .

tk:sourceUniqueIdCell a rdf:Property ;
    rdfs:comment "Unmodified Unique ID cell preserved as text." .

tk:sourceWorksheet a rdf:Property ;
    rdfs:comment "Governed worksheet name." .

tk:sourceXPath a rdf:Property ;
    rdfs:comment "Unmodified source xPath cell." .

tk:testsDataPoint a rdf:Property ;
    rdfs:comment "Schema data point exercised by this XML input; not a workbook rule identity." .

tk:validationContext a rdf:Property ;
    rdfs:comment "Pinned source/schema context and clock prerequisites for this manifest." .

tk:wellFormed a rdf:Property ;
    rdfs:comment "XML parsing succeeded; does not imply XSD or business-rule validity." .

tk:xmlNamespace a rdf:Property ;
    rdfs:comment "Namespace URI to bind to m when executing stored XPath selectors." .

